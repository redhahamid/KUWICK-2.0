{
  "name": "@kuwick/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:seed": "tsc --noEmit -p tsconfig.seed.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "start": "node dist/main",
    "start:prod": "node scripts/migrate-deploy.mjs && node dist/main",
    "seed:staging": "tsx prisma/seed-staging-uat.ts",
    "reset:uat-owner": "tsx prisma/reset-uat-owner.ts",
    "augment:hr-uat": "tsx prisma/augment-hr-uat.ts",
    "verify:hr-flows": "tsx prisma/verify-hr-flows.ts",
    "seed:catalogues": "tsx prisma/seed-clinic-catalogues.ts",
    "seed:reference": "tsx prisma/seed-reference-catalogs.ts",
    "seed:default-panels": "tsx prisma/seed-default-panels.ts",
    "seed:standard-rx": "tsx prisma/seed-standard-prescriptions.ts",
    "list:dose-priced-lines": "tsx prisma/list-dose-priced-invoice-lines.ts",
    "correct:appointment-instants": "tsx prisma/correct-appointment-instants.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.9.3"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testEnvironment": "node"
  }
}
