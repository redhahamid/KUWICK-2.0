enum LeaveType {
  ANNUAL
  MEDICAL
  EMERGENCY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// HR, Phase 1c (docs/DEVELOPMENT_ROADMAP.md) — leave request/approval
// workflow, unblocked and built independently of the Doctor Incentive
// Engine (still parked on OQ#2). approvedByStaffId is nullable/re-settable
// rather than immutable-once-set (same convention as Document.signedAt,
// Phase A6) — correcting who approved a request is more common in practice
// than needing an audit-locked approval.
model LeaveRequest {
  id                String      @id @default(uuid())
  tenantId          String      @map("tenant_id")
  staffId           String      @map("staff_id")
  leaveType         LeaveType   @map("leave_type")
  startDate         DateTime    @map("start_date") @db.Date
  endDate           DateTime    @map("end_date") @db.Date
  reason            String?
  status            LeaveStatus @default(PENDING)
  approvedByStaffId String?     @map("approved_by_staff_id")
  approvedAt        DateTime?   @map("approved_at")
  rejectReason      String?     @map("reject_reason")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  staff      Staff  @relation("LeaveRequestStaff", fields: [staffId], references: [id])
  approvedBy Staff? @relation("LeaveRequestApprovedBy", fields: [approvedByStaffId], references: [id])

  @@index([tenantId, staffId])
  @@index([tenantId, status])
  @@map("leave_requests")
}

// HR, Phase 1c. Tenant-wide (not per-clinic) — Malaysian public holidays
// apply nationally/state-wide, not per-branch; a per-clinic override can be
// added later if a real multi-state-branch need appears. Feeds the future
// holiday/after-hours surcharge engine (D-030) once that's scoped — the
// calendar itself isn't blocked on that decision, only the surcharge rule
// is.
model PublicHoliday {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date])
  @@index([tenantId])
  @@map("public_holidays")
}

// Appointment status mirrors packages/shared's AppointmentStatus exactly
// (docs/CODING_STANDARDS.md §2) — Prisma can't import a TS enum from another
// package, so keep these two in sync by hand rather than redefining wording.
enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  /// The patient is physically here. Recorded the moment the counter greets
  /// them, BEFORE the visit and the queue ticket exist.
  ARRIVED
  /// The visit and the type-A queue ticket exist and are linked. This is the
  /// state the queue board reads; ARRIVED on its own is a person at a desk.
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
  /// Wants this service but has no time yet. Occupies no slot and is excluded
  /// from every overlap and capacity check — see TERMINAL_APPOINTMENT_STATUSES
  /// and the appointments_no_overlap constraint.
  WAITLIST
  /// DEPRECATED, retained so no historical row is destroyed by a migration.
  /// A reminder is a FACT (see AppointmentCommunication), not a state that can
  /// displace CONFIRMED. Nothing writes this any more.
  REMINDED
  /// DEPRECATED, retained for the same reason. A rescheduled appointment is
  /// CANCELLED with cancellationReason = RESCHEDULED and a link to its
  /// replacement, so the history survives (§12). Nothing writes this any more.
  RESCHEDULED
  /// DEPRECATED. Folded into CHECKED_IN, which is the same fact with a better
  /// name and an actual link to the ticket.
  IN_QUEUE
}

/// WHY an appointment was cancelled, as a fact the clinic can count, beside
/// the free-text `cancelReason` a person typed. RESCHEDULED is the one that
/// carries structural meaning: it says a replacement exists.
enum AppointmentCancellationReason {
  PATIENT_REQUEST
  CLINIC_REQUEST
  RESCHEDULED
  PROVIDER_UNAVAILABLE
  DUPLICATE
  OTHER
}

/// Money owed for the BOOKING, kept deliberately separate from the
/// appointment's own status (§36): a paid deposit does not confirm an
/// appointment and a cancelled appointment may still hold a refundable
/// deposit.
enum AppointmentPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
  REFUNDED
}

/// How much of the price a booking asks for up front.
enum ServiceBookingPaymentRule {
  NONE
  DEPOSIT
  FULL
}

/// What the PUBLIC page shows where the price would go.
enum ServicePriceDisplay {
  HIDDEN
  EXACT
  FROM
}

/// Whether a provider's bookable time comes from the monthly roster or from a
/// standing weekly pattern. A clinic maintains ONE of them, never both (§2).
enum ProviderScheduleMode {
  ROSTER_LINKED
  FIXED_WEEKLY
}

/// How a branch's DIARY AXIS is drawn (§Phase-3). Display only: the roster
/// decides availability, and the booking band narrows what may be booked —
/// neither is allowed to decide what hours the calendar renders, because an
/// axis that follows the roster wraps (23:00 → next-day 13:30) the moment an
/// overnight shift exists.
enum CalendarDisplayMode {
  STANDARD_HOURS
  TWENTY_FOUR_HOURS
}

/// What a roster cell MEANS. Only WORKING and LOCUM offer time; the rest are
/// recorded so the matrix can say why a doctor is not there.
enum ProviderShiftType {
  WORKING
  OFF
  LEAVE
  BLOCKED
  LOCUM
}

/// Everything an appointment can have DONE to it, in one append-only log.
/// Follows the house pattern (VisitWorkflowEvent), not the unused generic
/// AuditLog.
enum AppointmentEventType {
  CREATED
  STATUS_CHANGED
  TIME_CHANGED
  PROVIDER_CHANGED
  SERVICE_CHANGED
  RESCHEDULED
  CANCELLED
  CHECKED_IN
  OVERRIDE_APPLIED
  PAYMENT_CHANGED
  PATIENT_LINKED
  COMMUNICATION_SENT
  NOTE_ADDED
  // Phase 7 — the request lifecycle, on the appointment's own history.
  CHANGE_REQUESTED
  CHANGE_REQUEST_APPROVED
  CHANGE_REQUEST_DECLINED
}

/// PHASE 7 — what a PATIENT may do to their own booking through the manage
/// link. Per booking page, per action. REQUEST_APPROVAL is the recommended
/// clinic workflow: the patient asks, the original appointment stands
/// untouched, and a staff decision is what changes anything.
enum PatientChangePolicy {
  NOT_ALLOWED
  REQUEST_APPROVAL
  INSTANT
}

enum AppointmentChangeRequestType {
  RESCHEDULE
  CANCELLATION
}

enum AppointmentChangeRequestStatus {
  PENDING
  APPROVED
  DECLINED
  /// Replaced by a newer request from the same patient before any decision.
  SUPERSEDED
}

/// How confident the server is that a public booking belongs to the patient it
/// was attached to. NEEDS_REVIEW never blocks the booking — it puts it on a
/// reconciliation worklist instead of merging two people (§33).
enum PatientMatchConfidence {
  MATCHED_IDENTIFIER
  MATCHED_PHONE_AND_NAME
  CREATED_NEW
  NEEDS_REVIEW
}

enum BookingFieldType {
  SHORT_TEXT
  LONG_TEXT
  YES_NO
  SINGLE_CHOICE
  MULTI_CHOICE
  NUMBER
  DATE
}

enum CommunicationChannel {
  WHATSAPP
  EMAIL
  SMS
  PUSH
}

/// MANUAL is not a lesser status — a receptionist pressing "WhatsApp patient"
/// and sending the message themselves IS the delivery, and recording it as
/// anything else would be faking one (§37).
enum CommunicationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
  MANUAL
}

enum RecurrenceFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  CUSTOM_DAYS
}

enum WaitlistStatus {
  ACTIVE
  OFFERED
  BOOKED
  EXPIRED
  CANCELLED
}

/// WHERE the booking came from, kept separate from its status (§41).
///
/// `FRONT_DESK` and `ONLINE_PORTAL` keep the exact meanings they have always
/// had — staff-created, and the public booking page — rather than being
/// renamed to STAFF/PUBLIC_BOOKING. A rename would rewrite roughly ninety
/// call sites, seeds and fixtures to say the same thing in different words,
/// and an enum value is not a label: it is a stored fact in every historical
/// row. The marketing-shaped detail (campaign, referrer, UTM) lives in
/// `Appointment.sourceDetail` so a new campaign never needs a new enum value.
enum AppointmentSource {
  ONLINE_PORTAL
  FRONT_DESK
  PATIENT_APP
  FOLLOW_UP
  QR
  WEBSITE
  WHATSAPP
  CAMPAIGN
  IMPORT
  API
}

// Owned by Clinical Operations (Phase 1a), consolidating the temporary
// `appointment_services` stand-in built during 1b (docs/DECISIONS.md).
// `price` is the base selfpay rate used to itemize "Standard Services" on
// an Invoice (Phase 1a Phase 5) — panel-tier pricing stays owned by Panel
// Claims' future `PanelPriceTier`, same convention as Inventory's `Item`.
enum ServiceOrderType {
  STANDARD_SERVICE
  TASK_ORDER
}

model ServiceCatalog {
  id                     String           @id @default(uuid())
  tenantId               String           @map("tenant_id")
  name                   String
  // Procedures (Task Orders, e.g. XRAYCHEST) carry a code; booking-time
  // consultation services (Standard Services) generally don't.
  code                   String?
  // Free text (e.g. "Laboratory", "Imaging", "Procedure", "Consultation") —
  // matches the audited kuwick.com Services & Procedures admin screen's
  // CATEGORY column. Not an enum: the clinic's own set of categories isn't
  // fixed/known ahead of time, unlike orderType's two-value distinction.
  category               String?
  // Distinguishes the audited kuwick.com "Orders & Services" sub-filters
  // (Clinical 2c plan) — unifies Task Orders and Standard Services into one
  // catalog/picker rather than two, matching the single "Add Order or
  // Service" selector. Defaults to STANDARD_SERVICE so every row created
  // before this phase (all booking-time services) is unaffected.
  orderType              ServiceOrderType @default(STANDARD_SERVICE) @map("order_type")
  durationMinutesDefault Int              @map("duration_minutes_default")
  price                  Decimal          @default(0) @db.Decimal(10, 2)
  active                 Boolean          @default(true)

  // --- BOOKING CONFIG (Appointments piece 1) --------------------------------
  // Separate from the clinical facts above because most of this catalogue is
  // NOT bookable: a chest X-ray is an order a doctor places, not a slot a
  // patient picks. `bookable` defaults false so nothing goes public by
  // migration — a clinic decides service by service.
  bookable            Boolean @default(false)
  /// How finely the day is sliced. NULL = same as the duration (back-to-back).
  slotIntervalMinutes Int?    @map("slot_interval_minutes")
  /// RM. Zero is a real answer — most consultations carry no booking fee —
  /// which is why it is not nullable.
  bookingFee          Decimal @default(0) @map("booking_fee") @db.Decimal(10, 2)
  /// What the PATIENT reads. `name` is "CONSULTATION - GENERAL"; this is the
  /// sentence under it on the public page.
  bookingDescription  String? @map("booking_description")
  bookingPhotoUrl     String? @map("booking_photo_url")
  /// TRUE lands the booking in the Requests tab for a human to accept.
  requiresApproval    Boolean @default(false) @map("requires_approval")
  /// How many can run AT ONCE across the clinic — two treatment rooms, one
  /// ultrasound. NULL means the room is not the constraint; the doctor is,
  /// and the doctor is already the roster.
  concurrentLimit     Int?    @map("concurrent_limit")

  // --- SCHEDULING RULES (§23) ----------------------------------------------
  /// Time the provider needs BEFORE the appointment — setting up a room,
  /// reading a referral. It is not offered to anyone else and it is not part
  /// of the appointment: a 09:00 slot with a 10-minute lead-in still starts at
  /// 09:00, but nothing may end between 08:50 and 09:00.
  bufferBeforeMinutes  Int  @default(0) @map("buffer_before_minutes")
  /// Time the provider needs AFTER — turning the room over, writing up.
  bufferAfterMinutes   Int  @default(0) @map("buffer_after_minutes")
  /// How far ahead this service may be booked, in whole days. NULL = the
  /// clinic's own horizon, and if the clinic has none, no limit.
  maxAdvanceDays       Int? @map("max_advance_days")
  /// Overrides the clinic's minimum notice for THIS service. NULL = use the
  /// clinic's. Zero is a real answer and means walk-up booking is fine.
  minimumNoticeMinutes Int? @map("minimum_notice_minutes")

  // --- PUBLIC PRESENTATION & PAYMENT (§22, §36) ----------------------------
  priceDisplay       ServicePriceDisplay       @default(HIDDEN) @map("price_display")
  bookingPaymentRule ServiceBookingPaymentRule @default(NONE) @map("booking_payment_rule")
  /// RM asked for at booking when the rule is DEPOSIT. FULL uses `price`.
  depositAmount      Decimal                   @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  /// Read before the appointment ("fast for 8 hours") and after ("keep the
  /// dressing dry"). Reused verbatim by confirmation, reminders, the
  /// manage-booking page and the patient app — written once (§35).
  preInstructions    String?                   @map("pre_instructions")
  postInstructions   String?                   @map("post_instructions")
  /// The tail of a service-specific public link: /hijraa-bangi/sinus (§40).
  bookingSlug        String?                   @map("booking_slug")

  /// WAVE 1 — see Item.taxCodeId.
  taxCodeId String? @map("tax_code_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id])
  bookableHours               ServiceBookableHour[]
  bookingFormFields           BookingFormField[]
  reminderRules               AppointmentReminderRule[]
  appointmentSeries           AppointmentSeries[]
  waitlistEntries             WaitlistEntry[]
  slotCapacityConfigs         SlotCapacityConfig[]
  doctorServiceQualifications DoctorServiceQualification[]
  appointments                Appointment[]
  orderServices               OrderService[]
  formTemplates               FormTemplate[]
  panelPriceOverrides         PanelPriceOverride[]
  panelExclusions             PanelExclusion[]
  taxCode                     TaxCode?                     @relation(fields: [taxCodeId], references: [id])
  consultationTariffRules     ConsultationTariffRule[]

  @@unique([tenantId, bookingSlug])
  @@index([tenantId])
  @@map("service_catalog")
}

/**
 * G4.5d3c-3b2 (D-094) — the operational kind of visit, as far as
 * CONSULTATION BILLING is concerned. The owner's exemption cases: an OTC
 * purchase, a dressing change, a procedure-only attendance and a no-charge
 * follow-up must never auto-attract a consultation fee. Deliberately NOT a
 * broad appointment/workflow taxonomy — it exists to answer exactly one
 * question: which consultation tariff rules (if any) apply to this visit.
 */
enum VisitClassification {
  CONSULTATION
  OTC_ONLY
  DRESSING_ONLY
  PROCEDURE_ONLY
  FOLLOW_UP_NO_CONSULTATION
}

/**
 * G4.5d3c-3b2 (D-094) — a clinic's consultation tariff: WHICH consultation
 * service applies at WHAT time of day for WHICH kind of visit.
 * The rule selects the ServiceCatalog record; the PRICE always comes from the
 * approved pricing resolver (specific panel price -> cash + panel service
 * markup -> cash). Panel-specific consultation prices therefore live in
 * PanelPriceOverride against the selected service, never inside this rule —
 * one pricing truth, not two.
 * Times are clinic-local wall-clock "HH:MM", INCLUSIVE at both ends
 * ("08:00"–"22:59"). startTime > endTime means the band crosses midnight
 * ("23:00"–"07:59"). Matching converts the consultation-start instant to the
 * clinic's stored IANA timezone.
 * A clinic with NO active rules has consultation auto-billing OFF — existing
 * tenants behave exactly as before until they configure a tariff.
 */
model ConsultationTariffRule {
  id               String              @id @default(uuid())
  tenantId         String              @map("tenant_id")
  clinicId         String              @map("clinic_id")
  name             String
  active           Boolean             @default(true)
  classification   VisitClassification @default(CONSULTATION)
  startTime        String              @map("start_time")
  endTime          String              @map("end_time")
  serviceCatalogId String              @map("service_catalog_id")
  // Optional validity window (clinic-local calendar dates, inclusive).
  effectiveFrom    DateTime?           @map("effective_from")
  effectiveTo      DateTime?           @map("effective_to")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  clinic         Clinic         @relation(fields: [clinicId], references: [id])
  serviceCatalog ServiceCatalog @relation(fields: [serviceCatalogId], references: [id])
  invoiceLines   InvoiceLine[]

  @@index([tenantId, clinicId, active])
  @@map("consultation_tariff_rules")
}

// Clinical Operations, Phase A7. Admin-defined result forms ("Google
// Forms but for lab/procedure results") — clinic owner builds a field
// list once per service (e.g. "Full Blood Count": Hb/WBC/Platelets with
// units and normal ranges), and every future FBC completion renders that
// form instead of a bare free-text box. `fields` is JSON, not a normalized
// child table: a field list is edited as a whole array in the builder UI
// and read as a whole array when rendering, so there's no per-field query
// need that would justify the extra join.
model FormTemplate {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  name             String
  serviceCatalogId String?  @map("service_catalog_id")
  fields           Json
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  serviceCatalog ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])
  orderServices  OrderService[]

  @@index([tenantId])
  @@index([tenantId, serviceCatalogId])
  @@map("form_templates")
}

model DoctorSchedule {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  clinicId      String    @map("clinic_id")
  staffId       String    @map("staff_id")
  dayOfWeek     Int       @map("day_of_week")
  startTime     DateTime  @map("start_time") @db.Time
  endTime       DateTime  @map("end_time") @db.Time
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])
  staff  Staff  @relation(fields: [staffId], references: [id])

  @@index([tenantId])
  @@index([tenantId, clinicId])
  @@index([tenantId, staffId, dayOfWeek])
  @@map("doctor_schedules")
}

// One row per (staff, clinic, date): a populated window overrides the
// recurring DoctorSchedule for that date; a null window means unavailable
// that whole date. Deliberately doesn't support split "leave AM, extra
// session PM" on the same date — flagged as a simplification, not a spec
// requirement.
model ScheduleException {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  clinicId  String    @map("clinic_id")
  staffId   String    @map("staff_id")
  date      DateTime  @db.Date
  startTime DateTime? @map("start_time") @db.Time
  endTime   DateTime? @map("end_time") @db.Time
  reason    String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])
  staff  Staff  @relation(fields: [staffId], references: [id])

  @@unique([tenantId, staffId, clinicId, date])
  @@index([tenantId, clinicId])
  @@map("schedule_exceptions")
}

/// The CLINIC's own booking rules — one row per clinic, distinct from any
/// doctor's roster.
///
/// A doctor rostered 08:00-20:00 at a clinic whose last session is 17:00 must
/// not be offered at 19:30, and "book me in four minutes" is a slot the engine
/// can compute and the front desk cannot honour.
///
/// Times are WALL CLOCK in `Clinic.timezone` (see `time.util.ts`).
/// A one-off data correction that RAN, recorded so it cannot run twice.
///
/// A correction shifts real rows by a real amount and nothing in the corrected
/// row says whether it has already been shifted. The unique (tenant, name) IS
/// the guard. Append-only by trigger — a guard that can be deleted is a guard
/// that can be switched off by accident.
model DataCorrection {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  rowsAffected Int      @map("rows_affected")
  note         String?
  appliedBy    String?  @map("applied_by")
  appliedAt    DateTime @default(now()) @map("applied_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("data_corrections")
}

model ClinicBookingSettings {
  id                    String              @id @default(uuid())
  tenantId              String              @map("tenant_id")
  clinicId              String              @map("clinic_id")
  /// The clinic's own booking band, which NARROWS a provider's roster and
  /// never widens it. Both nullable since the roster redesign: a 24-hour
  /// clinic has no first or last session, and a hard 09:00-17:00 default
  /// silently amputated a night roster (§50). NULL on either side means "the
  /// clinic does not narrow that end".
  firstSessionTime      DateTime?           @map("first_session_time") @db.Time
  lastSessionTime       DateTime?           @map("last_session_time") @db.Time
  /// 0 means walk-up booking is fine — a real answer, and the safe default: a
  /// clinic that has not thought about this should not find its diary silently
  /// narrowed.
  minimumNoticeMinutes  Int                 @default(0) @map("minimum_notice_minutes")
  /// How far ahead anybody may book at this branch. NULL = no horizon.
  maxAdvanceDays        Int?                @map("max_advance_days")
  /// Whether the tenant-wide HR public-holiday calendar closes THIS branch.
  /// Defaults false so no existing diary is narrowed by a migration: a
  /// Malaysian holiday is a payroll fact first, and plenty of clinics open on
  /// one. A branch that does shut ticks this once instead of re-typing the
  /// national calendar as branch closed dates (§3).
  observePublicHolidays Boolean             @default(false) @map("observe_public_holidays")
  /// THE DIARY AXIS (Phase 3). Display settings only — never availability.
  /// The booking band above NARROWS what can be booked; these say what hours
  /// the calendar RENDERS, which must hold still whatever the roster does.
  calendarDisplayMode   CalendarDisplayMode @default(STANDARD_HOURS) @map("calendar_display_mode")
  /// The branch's stated operating hours, wall clock. NULL = never stated;
  /// the diary falls back to a stable default band rather than to the roster.
  displayOpenTime       DateTime?           @map("display_open_time") @db.Time
  displayCloseTime      DateTime?           @map("display_close_time") @db.Time
  /// Breathing room drawn either side of the operating hours (09:00–17:00
  /// with 60 → an 08:00–18:00 diary), clamped to the day.
  displayPaddingMinutes Int                 @default(60) @map("display_padding_minutes")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([tenantId, clinicId])
  @@map("clinic_booking_settings")
}

/// A day the BUILDING is shut. Deliberately not a `ScheduleException` with a
/// null staff id: an exception is one doctor's day off and is read per doctor,
/// where a public holiday has to be answerable ("is the clinic open on the
/// 24th") without first knowing which doctors exist.
model ClinicClosedDate {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  clinicId         String   @map("clinic_id")
  /// A DATE in the clinic's own zone. 24 December is 24 December whatever the
  /// server is set to.
  date             DateTime @db.Date
  /// Shown to patients ("Deepavali"), and nullable because a clinic closing
  /// for a reason it would rather not publish must still be able to close.
  reason           String?
  /// Whether a PATIENT may read the reason. "Deepavali" is fine; "audit by the
  /// ministry" is not, and a clinic must still be able to close for it (§29).
  reasonIsPublic   Boolean  @default(false) @map("reason_is_public")
  createdByStaffId String?  @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant         Tenant @relation(fields: [tenantId], references: [id])
  clinic         Clinic @relation(fields: [clinicId], references: [id])
  createdByStaff Staff? @relation(fields: [createdByStaffId], references: [id])

  @@unique([tenantId, clinicId, date])
  @@index([tenantId, clinicId])
  @@map("clinic_closed_dates")
}

model SlotCapacityConfig {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  clinicId          String   @map("clinic_id")
  staffId           String   @map("staff_id")
  serviceId         String   @map("service_id")
  slotLengthMinutes Int      @map("slot_length_minutes")
  dailyCapacity     Int?     @map("daily_capacity")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  clinic  Clinic         @relation(fields: [clinicId], references: [id])
  staff   Staff          @relation(fields: [staffId], references: [id])
  service ServiceCatalog @relation(fields: [serviceId], references: [id])

  @@unique([tenantId, clinicId, staffId, serviceId])
  @@index([tenantId, clinicId])
  @@index([tenantId, staffId])
  @@map("slot_capacity_configs")
}

// Presence of a row = qualified; revoke by deleting it.
model DoctorServiceQualification {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  staffId   String   @map("staff_id")
  serviceId String   @map("service_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  staff   Staff          @relation(fields: [staffId], references: [id])
  service ServiceCatalog @relation(fields: [serviceId], references: [id])

  @@unique([tenantId, staffId, serviceId])
  @@index([tenantId, staffId])
  @@index([tenantId, serviceId])
  @@map("doctor_service_qualifications")
}

model Appointment {
  id                 String                         @id @default(uuid())
  tenantId           String                         @map("tenant_id")
  clinicId           String                         @map("clinic_id")
  patientId          String                         @map("patient_id")
  staffId            String                         @map("staff_id")
  serviceId          String                         @map("service_id")
  status             AppointmentStatus              @default(REQUESTED)
  source             AppointmentSource
  scheduledStart     DateTime                       @map("scheduled_start")
  scheduledEnd       DateTime                       @map("scheduled_end")
  /// INTERNAL note — what the counter needs to know. Never shown to a patient.
  notes              String?
  /// What the PATIENT wrote when booking, or a note written FOR them and shown
  /// on the manage-booking page. Kept apart from `notes` because one of the two
  /// is safe to publish and the other is not.
  patientNote        String?                        @map("patient_note")
  cancelReason       String?                        @map("cancel_reason")
  /// The countable half of the cancellation. RESCHEDULED here is what makes
  /// `rescheduledTo` meaningful (§12).
  cancellationReason AppointmentCancellationReason? @map("cancellation_reason")
  arrivedAt          DateTime?                      @map("arrived_at")
  checkedInAt        DateTime?                      @map("checked_in_at")
  rescheduledFromId  String?                        @unique @map("rescheduled_from_id")

  /// §28 — the same request retried must not become two appointments. A double
  /// click, a network retry and a payment-callback retry all send the same key;
  /// the unique index is what makes the second one a no-op rather than a
  /// duplicate booking. NULL for anything that did not supply one.
  idempotencyKey String? @map("idempotency_key")

  /// §16 — booking rules were deliberately set aside, by somebody, for a
  /// reason. All three or none: the service refuses an override with no reason
  /// and no permission behind it.
  overriddenRule      String? @map("overridden_rule")
  overrideReason      String? @map("override_reason")
  overriddenByStaffId String? @map("overridden_by_staff_id")

  /// §36 — money for the BOOKING, separate from the appointment's own status.
  paymentStatus    AppointmentPaymentStatus @default(NOT_REQUIRED) @map("payment_status")
  /// The clinic invoice this booking's deposit was applied to, so a deposit is
  /// never counted twice as revenue.
  depositInvoiceId String?                  @map("deposit_invoice_id")

  /// §42 — the secret in the manage-booking URL. Long, random, per booking, and
  /// the ONLY thing that link carries: it identifies one appointment and
  /// reaches no other patient's data.
  manageToken String? @unique @map("manage_token")

  /// §33 — how the server decided this booking belongs to this patient.
  /// NEEDS_REVIEW is a worklist entry, never a refusal and never a merge.
  patientMatch PatientMatchConfidence? @map("patient_match")

  /// §41 — campaign, referrer, UTM. Free text on purpose: a new campaign must
  /// never require a new enum value or a migration.
  sourceDetail String? @map("source_detail")

  /// §43 — the series this occurrence belongs to. Each real session is its own
  /// appointment; the series only records the intent that generated them.
  seriesId    String? @map("series_id")
  seriesIndex Int?    @map("series_index")

  /// WHO reminded this patient, and WHEN. Not the `REMINDED` status, which
  /// cannot hold either and is mutually exclusive with CONFIRMED — an
  /// appointment can be both reminded and confirmed, and the dashboard has to
  /// show both.
  reminderSentAt        DateTime? @map("reminder_sent_at")
  reminderSentByStaffId String?   @map("reminder_sent_by_staff_id")

  /// The visit this appointment BECAME when the patient arrived.
  ///
  /// Set by `arrived()`, which creates the queue ticket (type A) and the visit
  /// under it. Without it, `completeVisit` cannot find the appointment that
  /// started the consultation, so appointments sat at ARRIVED forever and the
  /// Completed tab stayed empty. Unique both ways; null for a walk-in.
  visitId String? @unique @map("visit_id")

  /// WHO cancelled it, beside the reason that was already recorded. A reason
  /// with nobody's name on it cannot be followed up when the patient rings
  /// back to ask why.
  cancelledByStaffId String?   @map("cancelled_by_staff_id")
  cancelledAt        DateTime? @map("cancelled_at")

  /// SNAPSHOT of the service's booking fee at the moment of booking. A clinic
  /// raising its fee in March must not change what a February booking asked
  /// for. The SERVICE price is deliberately not snapshotted — it is an
  /// estimate of future revenue, not a commitment, so it reads live.
  bookingFeeAmount    Decimal   @default(0) @map("booking_fee_amount") @db.Decimal(10, 2)
  bookingFeePaidAt    DateTime? @map("booking_fee_paid_at")
  bookingFeeReference String?   @map("booking_fee_reference")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant             Tenant                     @relation(fields: [tenantId], references: [id])
  clinic             Clinic                     @relation(fields: [clinicId], references: [id])
  patient            Patient                    @relation(fields: [patientId], references: [id])
  staff              Staff                      @relation(fields: [staffId], references: [id])
  service            ServiceCatalog             @relation(fields: [serviceId], references: [id])
  rescheduledFrom    Appointment?               @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id])
  /// THE REPLACEMENT. `rescheduledTo` is the forward link §12 asks for; it is
  /// the same relation read the other way, so the two can never disagree.
  rescheduledTo      Appointment?               @relation("AppointmentReschedule")
  series             AppointmentSeries?         @relation(fields: [seriesId], references: [id])
  overriddenBy       Staff?                     @relation("AppointmentOverrideAuthor", fields: [overriddenByStaffId], references: [id])
  depositInvoice     Invoice?                   @relation("AppointmentDepositInvoice", fields: [depositInvoiceId], references: [id])
  events             AppointmentEvent[]
  formAnswers        AppointmentFormAnswer[]
  communications     AppointmentCommunication[]
  waitlistEntries    WaitlistEntry[]            @relation("WaitlistBookedAppointment")
  staffNotifications StaffNotification[]
  changeRequests     AppointmentChangeRequest[]
  reminderSentBy     Staff?                     @relation("AppointmentReminderAuthor", fields: [reminderSentByStaffId], references: [id])
  visit              Visit?                     @relation(fields: [visitId], references: [id])
  cancelledBy        Staff?                     @relation("AppointmentCancelAuthor", fields: [cancelledByStaffId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, clinicId])
  @@index([tenantId, clinicId, scheduledStart])
  @@index([tenantId, staffId, scheduledStart])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, seriesId])
  @@map("appointments")
}

// Inventory & Procurement — Phase 1 core (docs/DATABASE_ARCHITECTURE.md §6,
// docs/DEVELOPMENT_ROADMAP.md 1d). Stock take/variance and inter-branch
// transfer are Phase 2 and not modeled here.

// WAVE 2 — the movement types a two-branch clinic actually produces. Before
// this, everything that was not a receipt or a dispense arrived as a bare
// ADJUSTMENT, and an unexplained adjustment is indistinguishable from a
// mistake. Existing rows keep their existing types; nothing is re-labelled.
enum StockMovementType {
  GOODS_RECEIVED
  ADJUSTMENT
  // D-028 (docs/DECISIONS.md): stock deducts when a Prescription is marked
  // DISPENSED, not when it's written — this is that ledger entry.
  DISPENSED
  /// Stock leaving a branch on a transfer. Paired with a TRANSFER_IN at the
  /// receiving branch when the box is opened — never one movement for both,
  /// because goods in transit belong to neither shelf.
  TRANSFER_OUT
  TRANSFER_IN
  /// The posted correction from an approved stock take. Never written by the
  /// act of counting.
  STOCK_TAKE
  /// Used by the clinic rather than sold: a dressing pack opened for a
  /// procedure, alcohol swabs at the vaccination bench.
  INTERNAL_USE
  WASTAGE
  EXPIRY
  RETURN_TO_SUPPLIER
  RETURN_FROM_PATIENT
  /// The count a branch starts with, when stock control begins mid-life.
  OPENING_BALANCE
}

// Mirrors packages/shared's ProcurementRequestStatus and PurchaseOrderStatus
// exactly (docs/CODING_STANDARDS.md §2) — Prisma can't import a TS enum from
// another package, so keep these in sync by hand, same as AppointmentStatus.
enum ProcurementRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CONVERTED
}

enum PurchaseOrderStatus {
  ORDERED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
  CANCELLED
}

// Selfpay price only — panel-tier pricing lives on PanelPriceOverride
// (Phase A8), not duplicated here.
/**
 * KW2-Q3 — what the Add-medication form does when an item is selected.
 * Behaviour, not a button. The doctor should not have to know that a syrup
 * for a 3-year-old wants the weight calculator; choosing the medicine is what
 * says so.
 */
enum ItemDosingType {
  /**
   * Dose from mg/kg × the latest recorded weight. The calculator opens.
   */
  WEIGHT_BASED
  /**
   * Dose from an age bracket, matched from the patient's DOB.
   */
  AGE_BAND
  /**
   * A fixed adult default, filled silently where one is configured.
   */
  ADULT_DEFAULT

  @@map("item_dosing_type")
}

model Item {
  id                      String   @id @default(uuid())
  tenantId                String   @map("tenant_id")
  code                    String?
  name                    String
  category                String?
  // "Stock Unit (Form)" on the audited kuwick.com Edit Inventory screen —
  // the packaging unit (e.g. "Bottle / Botol"), distinct from
  // doseUnitDefault (the per-dose unit, e.g. "ml").
  unitOfMeasure           String?  @map("unit_of_measure")
  doseDefault             String?  @map("dose_default")
  doseUnitDefault         String?  @map("dose_unit_default")
  frequencyDefault        String?  @map("frequency_default")
  durationDefault         String?  @map("duration_default")
  instruction             String?
  indication              String?
  // Clinical Phase 3 (Medications): "Conc. Vol (mL)" / "Strength (mg)" on
  // the audited Edit Inventory screen — e.g. 457mg per 5mL — feeds the
  // weight-based dosage calculator's volume step (Dose × concVolMl ÷
  // strengthMg). Nullable: only liquid/syrup medicines carry these.
  concVolMl               Decimal? @map("conc_vol_ml") @db.Decimal(10, 2)
  strengthMg              Decimal? @map("strength_mg") @db.Decimal(10, 2)
  consumptionMethod       String?  @map("consumption_method")
  defaultDispenseQuantity Int?     @map("default_dispense_quantity")
  // Free-text clinician guidance (e.g. "25-40MG/KG") — not a structured
  // default plugged into the calculator; the doctor reads this and types
  // the Dose Rate manually at prescribe time.
  prescriptionReference   String?
  remark                  String?
  sellPrice               Decimal  @map("sell_price") @db.Decimal(10, 2)
  cost                    Decimal? @db.Decimal(10, 2)
  active                  Boolean  @default(true)

  /// AN ITEM IS ACTIVATED WHEN IT ARRIVES, NOT WHEN IT IS ORDERED.
  ///
  /// The clinic's order queue carries a whole sheet for this — TO BE ACTIVATED
  /// MEDS, with four states — because a new medication exists in the catalogue
  /// only once it has physically turned up. Ordering it is a promise; receiving
  /// it is a fact, and prescribing from a promise is how a patient is handed a
  /// prescription for something the dispensary has never seen.
  ///
  /// `awaitingFirstReceipt` is set when an item is created from an approved
  /// new-item request. The first goods receipt clears it and stamps
  /// `activatedAt`. An item created any other way is not waiting for anything.
  awaitingFirstReceipt Boolean   @default(false) @map("awaiting_first_receipt")
  activatedAt          DateTime? @map("activated_at")

  // ---- KW2-Q3: imported from the clinic's own inventory export ----------
  //
  // The source is a real spreadsheet with real conventions, and the import
  // preserves rather than tidies. Anything cleaned for display keeps the
  // original beside it, because a name nobody recognises is worse than an
  // untidy one.

  /**
   * The source row's id. Makes the import idempotent and traceable.
   */
  externalRef     String?   @map("external_ref")
  /**
   * The name exactly as exported, "##***" and all.
   */
  sourceName      String?   @map("source_name")
  /**
   * The clinic's Malay grouping: BATUK, DEMAM, ANTIBIOTIK… Searchable.
   */
  groupTag        String?   @map("group_tag")
  /**
   * Flagged "(CASH ONLY)" in the source. Kept visible, never silently applied.
   */
  cashOnly        Boolean   @default(false) @map("cash_only")
  /**
   * The raw packaging string: "10 BIJI / STRIP", "PLASTIC/6 SACHET".
   */
  packDescription String?   @map("pack_description")
  /**
   * The leading number parsed out of packDescription where there IS one.
   * NULL where the string does not start with a count — "Box", "BOTTLE",
   * "-". Guessing 1 would be a quantity the clinic never stated.
   */
  unitsPerPack    Int?      @map("units_per_pack")
  /**
   * Summary-level only; batch expiry lives on StockBatch.
   */
  earliestExpiry  DateTime? @map("earliest_expiry") @db.Date

  /**
   * How the Add-medication form behaves when this item is chosen.
   * Every imported row is ADULT_DEFAULT with empty defaults: the source
   * carries no dosing data at all, and inventing doses for real drugs is the
   * one thing an import must never do.
   */
  dosingType ItemDosingType @default(ADULT_DEFAULT) @map("dosing_type")

  // ---- b1 PHASE 1F: STRUCTURED PRESCRIPTION DEFAULTS ---------------------
  //
  // What the prescribing form opens filled with. STRUCTURED, and additive to
  // the free-text `doseDefault` / `doseUnitDefault` / `frequencyDefault` /
  // `durationDefault` columns above, which still hold the imported catalogue's
  // own values and are still read where a structured default is absent.
  //
  // The point of the FKs is that a default is a REFERENCE to the clinic's
  // vocabulary rather than a copy of it: rename the Malay label on a frequency
  // and every medicine defaulting to it says the new thing, instead of 229
  // rows keeping a string nobody can find.
  //
  // Every one is nullable, and a medicine with none opens the form EMPTY.
  // Inventing a dose for a real drug is the one thing a default must never do.
  defaultDoseAmount          Decimal?      @map("default_dose_amount") @db.Decimal(10, 2)
  defaultDoseUnitId          String?       @map("default_dose_unit_id")
  defaultFrequencyId         String?       @map("default_frequency_id")
  defaultDurationValue       Int?          @map("default_duration_value")
  defaultDurationUnit        DurationUnit? @map("default_duration_unit")
  defaultQuantity            Int?          @map("default_quantity")
  defaultConsumptionMethodId String?       @map("default_consumption_method_id")

  /// True where the defaults above came from the platform's seed rather than
  /// from somebody at this clinic. A clinic overriding one clears it, so
  /// "nobody here has reviewed this medicine's defaults" stays answerable —
  /// the same reason an attachment's suggested category is unattributed.
  defaultsFromSeed Boolean @default(false) @map("defaults_from_seed")

  // ---- b1 PHASE 1E: how this medicine is COUNTED -------------------------
  //
  // The unit is the platform's word ("TABLET PER STRIP"); the number beside it
  // is the clinic's, because only they know whether their strips hold 10 or
  // 12. Stock deduction and the "X in stock" line both read this pair.
  stockUnitId          String? @map("stock_unit_id")
  quantityPerStockUnit Int?    @map("quantity_per_stock_unit")

  // ---- INVENTORY PIECE 1 (D1): "dispensed whole" is STATED, never inferred --
  //
  // A divisor of 1 arrived at by a person saying "this bottle is handed over
  // whole" and a divisor of 1 sitting in the column because nobody has looked
  // are the same number and opposite facts. The audit found 149 of 242 rows
  // with no divisor at all, and the one thing that must not happen is a
  // curation pass filling them with 1 to clear the worklist.
  //
  // So the STATEMENT gets its own storage, exactly as a MIGRATED allergy does:
  // an author and a moment, nullable, with the bare column beside it. A row
  // whose quantityPerStockUnit is 1 and whose dispensedWholeAt is NULL is
  // still NEEDS ATTENTION, because nobody has said anything about it.
  //
  // A CHECK constraint holds the pair together: the marker cannot survive a
  // later edit that sets the divisor to 30. Marking it whole and then
  // counting it in thirties is not a state the clinic can be left in.
  // ---- INVENTORY PIECE 2: Stock Control -----------------------------------
  //
  // Whether receiving this item asks for a batch number and an expiry date.
  //
  // Defaults TRUE, which is the safe direction: a medicine whose expiry
  // nobody was asked for is a medicine that expires on the shelf unnoticed,
  // and the near-expiry screen goes quiet about it. Turned off for the things
  // that genuinely have no expiry — arm slings, a tumbler, the four "Item"
  // rows the audit already identified as not medicines.
  tracksBatchExpiry Boolean @default(true) @map("tracks_batch_expiry")

  /// When somebody at this clinic declared this item dispensed whole.
  dispensedWholeAt DateTime? @map("dispensed_whole_at")
  /// Who declared it. Plain staff-id audit column, the same convention as
  /// PatientAlert.createdByStaffId — attribution on record without another
  /// relation into the Staff constellation.
  /// WAVE 1 — the DEFAULT tax treatment for this item, copied onto an
  /// invoice line at add-time. NULL means "no tax mapping", which produces a
  /// zero-tax line rather than a guessed one.
  taxCodeId        String?   @map("tax_code_id")

  dispensedWholeByStaffId String? @map("dispensed_whole_by_staff_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                   Tenant                  @relation(fields: [tenantId], references: [id])
  defaultDoseUnit          DosageUnit?             @relation("ItemDefaultDoseUnit", fields: [defaultDoseUnitId], references: [id])
  defaultFrequency         PrescriptionFrequency?  @relation("ItemDefaultFrequency", fields: [defaultFrequencyId], references: [id])
  defaultConsumptionMethod ConsumptionMethodRef?   @relation("ItemDefaultConsumptionMethod", fields: [defaultConsumptionMethodId], references: [id])
  stockUnit                StockUnitRef?           @relation("ItemStockUnit", fields: [stockUnitId], references: [id])
  stockLevels              StockLevel[]
  stockBatches             StockBatch[]
  stockMovements           StockMovement[]
  procurementRequests      ProcurementRequest[]
  purchaseOrderLines       PurchaseOrderLine[]
  goodsReceivedNoteLines   GoodsReceivedNoteLine[]
  ageDosages               ItemAgeDosage[]
  prescriptions            Prescription[]
  taxCode                  TaxCode?                @relation(fields: [taxCodeId], references: [id])
  stockTransferLines       StockTransferLine[]
  stockTakeLines           StockTakeLine[]
  panelPriceOverrides      PanelPriceOverride[]
  panelExclusions          PanelExclusion[]
  priceChanges             ItemPriceChange[]
  newItemRequestDuplicates NewItemRequest[]        @relation("NewItemRequestDuplicate")
  newItemRequestCreations  NewItemRequest[]        @relation("NewItemRequestCreated")

  @@index([tenantId])
  @@map("items")
}

// Clinical Phase 3 (Medications): per-medicine age-based dosage brackets
// (e.g. "2y-5y: 2.5ml OD", "5y-11y: 5ml OD") — a lookup table, not a
// formula, since age-based dosing doesn't scale linearly the way
// weight-based dosing does. No admin screen for this exists in the
// audited kuwick.com reference yet (owner confirmed it's unfinished
// there); built here with a minimal editor so the mechanism is usable.
model ItemAgeDosage {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  itemId        String   @map("item_id")
  ageFromMonths Int      @map("age_from_months")
  ageToMonths   Int      @map("age_to_months")
  amount        Decimal  @db.Decimal(10, 2)
  unit          String
  frequency     String
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])

  @@index([tenantId, itemId])
  @@map("item_age_dosages")
}

// INVENTORY PIECE 1 — the clinic's own category list.
//
// `Item.category` is a plain string and REMAINS the truth carried on the row:
// the import writes it, the CSV upload writes it, and every existing reader
// reads it. This table is a REGISTRY of the names, not a second copy of the
// fact, and it exists for the three things a string column cannot do:
//
//   - ADD a category before any item uses it (a clinic setting up their shelf
//     names the sections first and files stock into them afterwards);
//   - RENAME one in a single place, which is a transaction over this row and
//     every item carrying the old string — a rename that left 40 items
//     pointing at a name no longer on the list is the drift this avoids;
//   - DELETE one, refused while any item still carries it. There is no
//     cascade and no silent re-filing: the guard names the count and the
//     clinic moves those items first.
//
// The screen lists the registry UNION the distinct strings actually in use, so
// a category that arrived on an imported row without ever being registered
// still gets a tab. An in-use name nobody can see is worse than an untidy list.
model ItemCategory {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("item_categories")
}

model Supplier {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  name        String
  contactName String? @map("contact_name")
  phone       String?
  email       String?
  active      Boolean @default(true)

  // -------------------------------------------------------------------------
  // THE COMMERCIAL TERMS THE CLINIC KEEPS IN SPREADSHEET PROSE.
  //
  // Its payable listing runs one sheet per supplier, thirty of them, and holds
  // each supplier's terms in THREE places at once: the text of a column
  // heading ("30 days payment term date"), the `+30` inside that column's
  // formula, and a term column on the roll-up. Changing a supplier's terms
  // means editing formulas. Credit limits live in a free-text note, and the
  // delivery SLA lives in another column heading ("received date (max 1
  // week)") where nothing can measure it.
  //
  // See docs/STOCK_LEGACY_WORKFLOW_AUDIT.md §5.
  // -------------------------------------------------------------------------

  /// Days from the invoice date to when payment is due. NULL means nobody has
  /// recorded this supplier's terms, and no invoice on them can be called
  /// overdue — which is stated on screen rather than assumed to be 30.
  paymentTermDays Int? @map("payment_term_days")

  /// What this supplier will let the clinic owe at once. NULL means no limit is
  /// known; it is NOT enforced as a block, because a clinic that cannot order
  /// medication because of a stale number in a config screen is worse off than
  /// one that gets a warning.
  creditLimitAmount Decimal? @map("credit_limit_amount") @db.Decimal(12, 2)

  /// How long this supplier is expected to take to deliver, in days. The
  /// clinic's order queue carries this as "max 1 week" in a column heading.
  deliverySlaDays Int? @map("delivery_sla_days")

  accountReference String? @map("account_reference")
  notes            String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  purchaseOrders  PurchaseOrder[]
  stockBatches    StockBatch[]
  invoices        SupplierInvoice[]
  payments        SupplierPayment[]
  newItemRequests NewItemRequest[]

  @@index([tenantId])
  @@map("suppliers")
}

/// Where a supplier invoice stands. Deliberately short: the money is derived
/// from payments, not from this, so the status can never disagree with the
/// ledger — it only records the things the ledger cannot say.
enum SupplierInvoiceStatus {
  /// Entered, not yet fully paid. The normal state.
  OPEN
  /// Fully settled by allocated payments. Set by the service, never by hand.
  PAID
  /// Being argued about — held out of "what must I pay this week" with a reason.
  DISPUTED
  /// Entered in error. Kept, not deleted, because it may have been paid against.
  CANCELLED
}

/// A SUPPLIER'S INVOICE — the document Kuwick had no model for.
///
/// This is the single largest gap the stock workbooks exposed
/// (`docs/STOCK_LEGACY_WORKFLOW_AUDIT.md` §5): Kuwick tracked what was ordered
/// and what was received, and then stopped. "What do we owe suppliers" had no
/// answer in the system at all, which is why thirty spreadsheet tabs exist.
///
/// The one thing the spreadsheet cannot do, and this can: `goodsReceivedNoteId`
/// links the invoice to the delivery it is for, so "does this invoice match what
/// actually arrived" is a question with an answer.
model SupplierInvoice {
  id         String @id @default(uuid())
  tenantId   String @map("tenant_id")
  supplierId String @map("supplier_id")

  /// The supplier's own number, as printed. The reference an argument is
  /// conducted in, so it is unique per supplier rather than globally.
  invoiceNumber String   @map("invoice_number")
  invoiceDate   DateTime @map("invoice_date") @db.Date

  /// Derived from the supplier's term at entry and STORED, not recomputed: a
  /// term change next year must not silently move when last year's invoices
  /// were due. NULL when the supplier has no term configured.
  dueDate DateTime? @map("due_date") @db.Date

  /// What the invoice asks for, tax included.
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)
  taxAmount   Decimal? @map("tax_amount") @db.Decimal(12, 2)

  status        SupplierInvoiceStatus @default(OPEN)
  /// Why it is disputed. Required by the service whenever status is DISPUTED.
  disputeReason String?               @map("dispute_reason")

  /// THE LINK THE SPREADSHEET CANNOT HAVE. Optional because an invoice for
  /// something that never went through a purchase order (a courier charge, a
  /// one-off) is still an invoice; but where it exists, three-way matching
  /// becomes possible.
  goodsReceivedNoteId String? @map("goods_received_note_id")
  purchaseOrderId     String? @map("purchase_order_id")

  /// A link to the scan, exactly as the spreadsheet's hyperlink column does.
  documentUrl String? @map("document_url")
  notes       String?

  recordedByStaffId String   @map("recorded_by_staff_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant            Tenant                      @relation(fields: [tenantId], references: [id])
  supplier          Supplier                    @relation(fields: [supplierId], references: [id])
  goodsReceivedNote GoodsReceivedNote?          @relation(fields: [goodsReceivedNoteId], references: [id])
  purchaseOrder     PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id])
  recordedBy        Staff                       @relation("SupplierInvoiceRecordedBy", fields: [recordedByStaffId], references: [id])
  allocations       SupplierPaymentAllocation[]

  @@unique([tenantId, supplierId, invoiceNumber])
  @@index([tenantId, supplierId, dueDate])
  @@map("supplier_invoices")
}

/// MONEY GOING OUT TO A SUPPLIER.
///
/// Its own document, allocated explicitly to invoices — the same shape as
/// `PanelRemittance` and for the same reason: one bank transfer settles several
/// invoices, and a paid figure typed onto an invoice is a figure that will
/// eventually disagree with the bank.
model SupplierPayment {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  supplierId String   @map("supplier_id")
  paidAt     DateTime @map("paid_at") @db.Date
  amount     Decimal  @db.Decimal(12, 2)
  /// Bank transfer, cheque, cash — free text, because a clinic's payment
  /// methods are its own business and an enum here would need a migration per
  /// bank.
  method     String?
  reference  String?
  notes      String?

  recordedByStaffId String   @map("recorded_by_staff_id")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant      Tenant                      @relation(fields: [tenantId], references: [id])
  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  recordedBy  Staff                       @relation("SupplierPaymentRecordedBy", fields: [recordedByStaffId], references: [id])
  allocations SupplierPaymentAllocation[]

  @@index([tenantId, supplierId, paidAt])
  @@map("supplier_payments")
}

/// How much of a payment settled which invoice. The join that makes "paid" a
/// number derived from records rather than typed on a row.
model SupplierPaymentAllocation {
  id                String  @id @default(uuid())
  tenantId          String  @map("tenant_id")
  paymentId         String  @map("payment_id")
  supplierInvoiceId String  @map("supplier_invoice_id")
  amount            Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id])

  @@unique([paymentId, supplierInvoiceId])
  @@index([tenantId, supplierInvoiceId])
  @@map("supplier_payment_allocations")
}

// Cached/derived total (docs/DATABASE_ARCHITECTURE.md §6) — only ever
// written in the same transaction as a StockMovement row, never directly.
// quantityOnHand is deliberately allowed to go negative (docs/DECISIONS.md
// D-020, product-owner decision 2026-07-30): front-line staff dispense/
// invoice immediately even when system stock hasn't caught up with
// physically-received goods, and admin reconciles negative rows afterward
// via GET /stock/negative-stock (StockService.listNegativeStock) rather
// than being blocked at the point of dispensing. A DB CHECK constraint
// enforcing >= 0 was tried first and removed — see the
// allow_negative_stock migration.
model StockLevel {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  clinicId       String   @map("clinic_id")
  itemId         String   @map("item_id")
  quantityOnHand Int      @default(0) @map("quantity_on_hand")
  minThreshold   Int      @default(0) @map("min_threshold")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])

  @@unique([tenantId, clinicId, itemId])
  @@index([tenantId, clinicId])
  @@map("stock_levels")
}

// supplierId/addedByStaffId are only ever set by the quick "Inventory In"
// modal (StockService.quickAdd) — batches coming from a formal Purchase
// Order receive (GoodsReceivingService) leave both null, since the
// supplier is already known from the PO and there's no separate "who
// added this" picker in that flow. Both nullable/optional at the DTO
// level, same no-real-auth convention as OrderService.requestedByStaffId
// (D-017).
model StockBatch {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  clinicId       String    @map("clinic_id")
  itemId         String    @map("item_id")
  batchNumber    String?   @map("batch_number")
  quantity       Int
  expiryDate     DateTime? @map("expiry_date") @db.Date
  receivedDate   DateTime  @map("received_date") @db.Date
  supplierId     String?   @map("supplier_id")
  addedByStaffId String?   @map("added_by_staff_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  clinic                 Clinic                  @relation(fields: [clinicId], references: [id])
  item                   Item                    @relation(fields: [itemId], references: [id])
  supplier               Supplier?               @relation(fields: [supplierId], references: [id])
  addedByStaff           Staff?                  @relation(fields: [addedByStaffId], references: [id])
  stockMovements         StockMovement[]
  goodsReceivedNoteLines GoodsReceivedNoteLine[]

  @@index([tenantId, clinicId])
  @@index([tenantId, itemId, expiryDate])
  @@map("stock_batches")
}

// Append-only ledger — every quantity change is a row here; StockLevel is
// the derived/cached total, never the only record of truth
// (docs/DATABASE_ARCHITECTURE.md §6).
model StockMovement {
  id           String            @id @default(uuid())
  tenantId     String            @map("tenant_id")
  clinicId     String            @map("clinic_id")
  itemId       String            @map("item_id")
  batchId      String?           @map("batch_id")
  movementType StockMovementType @map("movement_type")

  /// STOCK UNITS — strips, boxes, bottles. The same unit `StockLevel` counts
  /// and the same unit a person counting the shelf counts. A 30-tablet course
  /// of a 10-per-strip medicine moves -3 here, not -30.
  quantityDelta Int @map("quantity_delta")

  /// The DOSE units the prescription was written for: 30, beside a delta of
  /// -3. Recorded so the dispensary can answer "why did three strips leave"
  /// without joining back to an item whose divisor may have been corrected
  /// since. Null on every row written before the conversion existed — those
  /// carry a dose-unit delta mislabelled as stock units, and reinterpreting
  /// them now would be arithmetic nobody performed at the counter.
  clinicalQuantity Int?     @map("clinical_quantity")
  referenceType    String?  @map("reference_type")
  referenceId      String?  @map("reference_id")
  createdByUserId  String?  @map("created_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  /// WAVE 2 — the structured reason, for every movement where "a prescription
  /// was dispensed" is not the answer. Free text (`notes`) stays for the
  /// human sentence; this is the column a report groups by.
  adjustmentReason StockAdjustmentReason? @map("adjustment_reason")

  /// The staff member who performed it. `createdByUserId` records the login;
  /// this records the PERSON, which is what an audit of a stock correction is
  /// actually asking about, and is set even where a staff row has no account.
  createdByStaffId String? @map("created_by_staff_id")

  /// G4.5d5b-2 — why this movement happened, when it needs saying.
  ///
  /// Added for one specific fact the approved dispensing policy produces: a
  /// hand-over made under an ACKNOWLEDGED stock shortage. The policy permits
  /// it, so the ledger has to be able to say the shortage was seen and
  /// accepted rather than leaving an unexplained negative balance for someone
  /// to find later. Nullable and free text; nothing branches on it.
  notes String? @map("notes")

  createdByStaff Staff?      @relation("StockMovementActor", fields: [createdByStaffId], references: [id])
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  clinic         Clinic      @relation(fields: [clinicId], references: [id])
  item           Item        @relation(fields: [itemId], references: [id])
  batch          StockBatch? @relation(fields: [batchId], references: [id])

  @@index([tenantId, clinicId])
  @@index([tenantId, itemId])
  @@map("stock_movements")
}

/// WHERE A PRICE CAME FROM.
///
/// Two gaps in one table (`docs/STOCK_LEGACY_WORKFLOW_AUDIT.md`): Kuwick had no
/// audit of who changed a price, and no capture of the price change that
/// happens AT GOODS-IN — which the clinic's own order queue records as "old
/// price / new price" columns, because the moment a cost actually changes is
/// the moment stock arrives at a different price.
///
/// Append-only by convention and by service: nothing updates a row here, and
/// the item's current cost is the newest row's `newCost`. That also makes it
/// the foundation for moving off standard cost later — a weighted average needs
/// exactly this history.
model ItemPriceChange {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  itemId   String @map("item_id")

  previousCost      Decimal? @map("previous_cost") @db.Decimal(10, 2)
  newCost           Decimal? @map("new_cost") @db.Decimal(10, 2)
  previousSellPrice Decimal? @map("previous_sell_price") @db.Decimal(10, 2)
  newSellPrice      Decimal? @map("new_sell_price") @db.Decimal(10, 2)

  /// How the change happened. GOODS_RECEIPT is the one the clinic cares about;
  /// MANUAL is somebody editing the catalogue; IMPORT is a bulk load.
  source              String
  goodsReceivedNoteId String? @map("goods_received_note_id")
  note                String?

  changedByStaffId String?  @map("changed_by_staff_id")
  changedAt        DateTime @default(now()) @map("changed_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  item              Item               @relation(fields: [itemId], references: [id])
  goodsReceivedNote GoodsReceivedNote? @relation(fields: [goodsReceivedNoteId], references: [id])
  changedBy         Staff?             @relation("ItemPriceChangedBy", fields: [changedByStaffId], references: [id])

  @@index([tenantId, itemId, changedAt])
  @@map("item_price_changes")
}

enum NewItemRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// ASKING FOR AN ITEM THAT DOES NOT EXIST YET.
///
/// The clinic runs this as a five-column sheet — medication, reason, comments,
/// "stock admin noted", supplier — where the approval IS the text in the fourth
/// column (`docs/STOCK_LEGACY_WORKFLOW_AUDIT.md` §2). No state, no actor, no
/// date, and nothing checks whether the item already exists, which is how a
/// catalogue grows two entries for one medicine.
///
/// Deliberately NOT folded into `ProcurementRequest`. That asks for more of
/// something the catalogue already knows about, and answers with a purchase
/// order. This asks for something that does not exist, and answers by creating
/// it — a different question with a different approver and a different risk
/// (a duplicate item, not a duplicate order).
model NewItemRequest {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  clinicId String? @map("clinic_id")

  /// What was asked for, in the requester's words. Kept verbatim even after an
  /// item is created under a tidier name, because the person who asked will
  /// search for what they typed.
  requestedName String  @map("requested_name")
  reason        String
  comments      String?

  suggestedSupplierId String?  @map("suggested_supplier_id")
  /// Pack size as prose, exactly as the clinic writes it ("n strips, 1 box = m
  /// strips"). Prose in, structured fields out: the approval turns it into
  /// `Item.unitOfMeasure` and a unit cost, which is the whole point.
  packSizeNote        String?  @map("pack_size_note")
  indicativeCost      Decimal? @map("indicative_cost") @db.Decimal(10, 2)
  indicativePrice     Decimal? @map("indicative_price") @db.Decimal(10, 2)

  status NewItemRequestStatus @default(PENDING)

  /// THE DUPLICATE CHECK'S ANSWER, recorded rather than just shown. If a
  /// requester was warned that this looks like an existing item and asked for it
  /// anyway, that is worth knowing six months later when there are two.
  possibleDuplicateItemId String? @map("possible_duplicate_item_id")

  decisionNote     String?   @map("decision_note")
  decidedByStaffId String?   @map("decided_by_staff_id")
  decidedAt        DateTime? @map("decided_at")
  /// The item this request became. NULL until approved.
  createdItemId    String?   @map("created_item_id")

  requestedByStaffId String   @map("requested_by_staff_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  clinic            Clinic?   @relation(fields: [clinicId], references: [id])
  suggestedSupplier Supplier? @relation(fields: [suggestedSupplierId], references: [id])
  possibleDuplicate Item?     @relation("NewItemRequestDuplicate", fields: [possibleDuplicateItemId], references: [id])
  createdItem       Item?     @relation("NewItemRequestCreated", fields: [createdItemId], references: [id])
  requestedBy       Staff     @relation("NewItemRequestedBy", fields: [requestedByStaffId], references: [id])
  decidedBy         Staff?    @relation("NewItemRequestDecidedBy", fields: [decidedByStaffId], references: [id])

  @@index([tenantId, status])
  @@map("new_item_requests")
}

model ProcurementRequest {
  id                String                   @id @default(uuid())
  tenantId          String                   @map("tenant_id")
  clinicId          String                   @map("clinic_id")
  itemId            String                   @map("item_id")
  requestedQuantity Int                      @map("requested_quantity")
  status            ProcurementRequestStatus @default(PENDING)
  requestedByUserId String?                  @map("requested_by_user_id")
  approvedByUserId  String?                  @map("approved_by_user_id")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  clinic             Clinic              @relation(fields: [clinicId], references: [id])
  item               Item                @relation(fields: [itemId], references: [id])
  purchaseOrderLines PurchaseOrderLine[]

  @@index([tenantId, clinicId])
  @@index([tenantId, status])
  @@map("procurement_requests")
}

model PurchaseOrder {
  id         String              @id @default(uuid())
  tenantId   String              @map("tenant_id")
  clinicId   String              @map("clinic_id")
  supplierId String              @map("supplier_id")
  status     PurchaseOrderStatus @default(ORDERED)
  orderedAt  DateTime            @default(now()) @map("ordered_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  clinic             Clinic              @relation(fields: [clinicId], references: [id])
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  lines              PurchaseOrderLine[]
  goodsReceivedNotes GoodsReceivedNote[]
  supplierInvoices   SupplierInvoice[]

  @@index([tenantId, clinicId])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  purchaseOrderId      String   @map("purchase_order_id")
  itemId               String   @map("item_id")
  procurementRequestId String?  @map("procurement_request_id")
  orderedQuantity      Int      @map("ordered_quantity")
  receivedQuantity     Int      @default(0) @map("received_quantity")
  unitCost             Decimal  @map("unit_cost") @db.Decimal(10, 2)
  /// THE PROMOTIONAL PRICE, and it is a real pricing rule rather than a nicety.
  ///
  /// The clinic's order queue carries "unit price" and "bonus price" side by
  /// side and values every line at `MIN(unit, bonus) x quantity`
  /// (docs/STOCK_LEGACY_WORKFLOW_AUDIT.md §3). Suppliers quote a list price and
  /// a promotion, and the clinic pays the lower of the two. NULL means the
  /// supplier quoted no promotion, which is not the same as a promotion of zero.
  bonusUnitCost        Decimal? @map("bonus_unit_cost") @db.Decimal(10, 2)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  purchaseOrder          PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id])
  item                   Item                    @relation(fields: [itemId], references: [id])
  procurementRequest     ProcurementRequest?     @relation(fields: [procurementRequestId], references: [id])
  goodsReceivedNoteLines GoodsReceivedNoteLine[]

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_lines")
}

// Header for one receiving event. D-019 (docs/DECISIONS.md): line detail
// lives on GoodsReceivedNoteLine, not here, since one delivery routinely
// covers multiple PO lines with different quantities/batches/expiries.
model GoodsReceivedNote {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  clinicId         String   @map("clinic_id")
  purchaseOrderId  String   @map("purchase_order_id")
  receivedByUserId String?  @map("received_by_user_id")
  receivedAt       DateTime @default(now()) @map("received_at")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  clinic           Clinic                  @relation(fields: [clinicId], references: [id])
  purchaseOrder    PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id])
  lines            GoodsReceivedNoteLine[]
  supplierInvoices SupplierInvoice[]
  priceChanges     ItemPriceChange[]

  @@index([tenantId, clinicId])
  @@index([tenantId, purchaseOrderId])
  @@map("goods_received_notes")
}

// D-019: the line-level detail that makes partial, multi-item receiving
// possible. Receiving a line is the single write path that must, in one
// transaction: increment PurchaseOrderLine.receivedQuantity, create/reuse a
// StockBatch, append a StockMovement, and update StockLevel.quantityOnHand —
// see InventoryReceivingService (apps/api/src/inventory).
model GoodsReceivedNoteLine {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  goodsReceivedNoteId String    @map("goods_received_note_id")
  purchaseOrderLineId String    @map("purchase_order_line_id")
  itemId              String    @map("item_id")
  batchId             String?   @map("batch_id")
  quantityReceived    Int       @map("quantity_received")
  batchNumber         String?   @map("batch_number")
  expiryDate          DateTime? @map("expiry_date") @db.Date
  unitCost            Decimal?  @map("unit_cost") @db.Decimal(10, 2)
  createdAt           DateTime  @default(now()) @map("created_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  goodsReceivedNote GoodsReceivedNote @relation(fields: [goodsReceivedNoteId], references: [id])
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  item              Item              @relation(fields: [itemId], references: [id])
  batch             StockBatch?       @relation(fields: [batchId], references: [id])

  @@index([tenantId, goodsReceivedNoteId])
  @@map("goods_received_note_lines")
}

// Clinical Operations, Phase 1a. The hub entity: Appointment's "Arrived"
// action and the front-desk "Add to Daily Queue" action both create one of
// these; Panel Claims' PanelInvoice and HR's IncentiveResult (both target
// design) will bill/total against it, never write to it.
// Clinical Operations, Phase A1 (Queue End-to-End), extended Phase A8.
// Panel/TPA catalog — audited against the live kuwick.com "Panel Clinics"
// admin screen (26 pre-loaded TPA panels with pricing overrides/
// exclusions) and Klinik Hijraa's "Panel Companies" section. limitAmount
// is still informational only — not automatically deducted across visits,
// just used to compute a single visit's copay (Invoice.totalAmount minus
// this limit, for the non-excluded portion — see InvoiceLine). Full claims
// submission/reconciliation stays a later phase (future admin "Panel
// Claims" menu), since that's an external workflow on the panel's own
// website today.
model PanelClinic {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  name            String
  code            String?
  limitAmount     Decimal?           @map("limit_amount") @db.Decimal(10, 2)
  // Panel workbook upgrade (D-041) — the panel's own payment term; a
  // claim is overdue when days since submission exceed this, so aging is
  // judged per panel rather than against fixed buckets.
  paymentTermDays Int?               @map("payment_term_days")
  // D-041 (owner refinement) — per-panel claim fee: some panels carry an
  // admin fee per claim, as a % of the claimed amount or a flat RM value;
  // most (e.g. AIA) have none. Applied automatically at batch creation
  // from this configuration — never a manual per-batch entry.
  claimFeeType    PanelClaimFeeType? @map("claim_fee_type")
  claimFeeValue   Decimal?           @map("claim_fee_value") @db.Decimal(10, 2)
  /// HOW THE FEE IS TREATED — see `PanelFeeTreatment`. This is the CURRENT
  /// value, mirrored from the panel's effective-dated `PanelFeeTerm` history by
  /// `PanelConfigService`, in the same transaction that writes it. The history
  /// is authoritative; this column exists so the read sites that need "what is
  /// it today" do not each resolve a date range. Same convention as
  /// `Invoice.patientPaidAmount` mirroring the payment ledger.
  feeTreatment    PanelFeeTreatment  @default(UNCONFIGURED) @map("fee_treatment")
  feeTerms        PanelFeeTerm[]

  // ---------------------------------------------------------------------
  // PAYMENT TERMS, in the shapes real panels actually use.
  //
  // `paymentTermDays` (above) stays as the NOMINAL term — the number a person
  // chases against, and the one every existing screen reads. The fields below
  // describe it properly: 14 of the 29 panels in the clinic's workbook state a
  // term this single integer cannot hold.
  // ---------------------------------------------------------------------
  /// The far edge of a range term ("60 - 90 DAYS" → nominal 60, max 90). NULL
  /// means the term is a single number, not a range.
  paymentTermMaxDays       Int?             @map("payment_term_max_days")
  /// Calendar or working days. NULL is read as calendar days, which is what
  /// every existing row means.
  paymentTermUnit          PanelTermUnit?   @map("payment_term_unit")
  /// What the clock starts from. NULL is read as submission, which is what the
  /// existing due-date calculation already does.
  paymentTermAnchor        PanelTermAnchor? @map("payment_term_anchor")
  /// TRUE for a TPA whose term is set by the corporate client behind the claim
  /// rather than by the panel ("VARY BASED ON COMPANY"). The term above is then
  /// indicative only, and screens must say so rather than call a claim overdue.
  paymentTermVariesByPayer Boolean          @default(false) @map("payment_term_varies_by_payer")

  /// HOW LONG THERE IS TO RE-CLAIM A REJECTION, in days from the original
  /// service date. The clinic's excess-claim register carries this as rule 5 of
  /// a procedure typed into spreadsheet cells — "max 2 months from the previous
  /// service date" — a hard deadline with money attached that nothing counts
  /// down. NULL means this panel's window is not known.
  resubmissionWindowDays Int?                   @map("resubmission_window_days")
  // G4.5d3c-3b1 (D-093) — panel-wide FIXED MARKUPS in RM, added to the clinic
  // cash price (owner rule). NOT absolute prices, and never stacked with a
  // specific PanelPriceOverride: a specific price REPLACES the markup-derived
  // one. NULL or 0 means no markup — the cash price stands.
  inventoryMarkupAmount  Decimal?               @map("inventory_markup_amount") @db.Decimal(10, 2)
  serviceMarkupAmount    Decimal?               @map("service_markup_amount") @db.Decimal(10, 2)
  // WAVE 3 — the operational configuration a claim workspace needs. Every
  // field here answers a question staff currently answer from memory or from a
  // note stuck to a monitor.
  //
  // `payerName` matters because the panel a patient names and the company that
  // actually pays are frequently different (a TPA administering an insurer's
  // scheme), and the cheque arrives from the second one.
  payerName              String?                @map("payer_name")
  portalUrl              String?                @map("portal_url")
  submissionMethod       PanelSubmissionMethod? @map("submission_method")
  /// What staff must have in hand before this panel's claim can go out —
  /// free-text lines, because every panel's list is different and encoding
  /// them as columns would mean a migration per panel.
  documentRequirements   String[]               @default([]) @map("document_requirements")
  /// Whether this panel wants an itemised bill rather than a total.
  requiresItemisation    Boolean                @default(false) @map("requires_itemisation")
  /// Whether a rejected claim is re-claimed under a NEW number (the owner's
  /// "buat claim baru untuk excess claim") or corrected in place.
  resubmitAsNewClaim     Boolean                @default(true) @map("resubmit_as_new_claim")
  claimNumberFormat      String?                @map("claim_number_format")
  contactName            String?                @map("contact_name")
  contactPhone           String?                @map("contact_phone")
  contactEmail           String?                @map("contact_email")
  accountReference       String?                @map("account_reference")
  notes                  String?
  /// Whether this panel's share is subject to service tax. NULL means nobody
  /// has decided, and the tax engine treats that as "do not tax" rather than
  /// guessing — see finance/invoice-tax.ts.
  panelShareTaxable      Boolean?               @map("panel_share_taxable")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  remittances    PanelRemittance[]
  visits         Visit[]
  priceOverrides PanelPriceOverride[]
  exclusions     PanelExclusion[]
  claimBatches   ClaimBatch[]

  @@index([tenantId])
  @@map("panel_clinics")
}

// Clinical Operations, Phase A8. Per-panel negotiated rate for a
// medication/vaccine/consumable (Item) or a service/procedure
// (ServiceCatalog) — panels frequently pay a different price than the
// clinic's self-pay rate. Exactly one of itemId/serviceCatalogId is set
// per row (enforced in the DTO, not a DB constraint, matching how other
// optional "which kind of thing" FKs are handled in this schema). Read at
// invoice Quick-Add time to suggest the correct unit price for a panel
// visit; never retroactively rewrites an already-added InvoiceLine
// (snapshot-at-add-time, same convention as every other invoice line).
model PanelPriceOverride {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  panelClinicId    String   @map("panel_clinic_id")
  itemId           String?  @map("item_id")
  serviceCatalogId String?  @map("service_catalog_id")
  overridePrice    Decimal  @map("override_price") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  panelClinic    PanelClinic     @relation(fields: [panelClinicId], references: [id])
  item           Item?           @relation(fields: [itemId], references: [id])
  serviceCatalog ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])

  @@index([tenantId, panelClinicId])
  @@index([tenantId, itemId])
  @@index([tenantId, serviceCatalogId])
  @@map("panel_price_overrides")
}

/// A PANEL'S FEE TERM, AS AT A DATE.
///
/// Owner requirement (2026-08-31): "Fee configuration should be
/// effective-dated/versioned so a future contract change does not alter
/// historical receivables."
///
/// Two independent protections, and both are needed:
///
///  1. THIS TABLE keeps the history, so "what were the terms in March" has an
///     answer, and correcting today's terms cannot rewrite what was agreed
///     last year.
///  2. THE CLAIM SNAPSHOT (`ClaimBatchLine.feeTreatment` / `feeAmount`) records
///     what was actually applied to each claim. Even a mistaken edit to the
///     history cannot move a claim that has already gone out.
///
/// The row in force on a date is the one with the greatest `effectiveFrom` not
/// after it. There is no `effectiveTo`: a term ends when the next one begins,
/// which makes a gap impossible to create.
model PanelFeeTerm {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  panelClinicId String   @map("panel_clinic_id")
  /// Day-precision. Terms are agreed on a date, not at a time.
  effectiveFrom DateTime @map("effective_from") @db.Date

  feeTreatment PanelFeeTreatment  @map("fee_treatment")
  feeType      PanelClaimFeeType? @map("fee_type")
  feeValue     Decimal?           @map("fee_value") @db.Decimal(10, 2)

  /// Why this term is what it is - the contract clause, the email, or in the
  /// case of the migrated rows, the evidence that established it.
  note String?

  recordedByStaffId String?  @map("recorded_by_staff_id")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  panelClinic PanelClinic @relation(fields: [panelClinicId], references: [id])
  recordedBy  Staff?      @relation("PanelFeeTermRecordedBy", fields: [recordedByStaffId], references: [id])

  @@unique([tenantId, panelClinicId, effectiveFrom])
  @@index([tenantId, panelClinicId, effectiveFrom])
  @@map("panel_fee_terms")
}

// Clinical Operations, Phase A8. Items/services a panel does NOT cover.
// When a staff member Quick-Adds a completed OrderService/Prescription to
// a panel visit's invoice, InvoiceService checks this table and stamps
// InvoiceLine.excludedFromPanel — so that line is always counted as
// patient-payable copay, on top of (not netted against) the panel's
// per-visit limitAmount.
model PanelExclusion {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  panelClinicId    String   @map("panel_clinic_id")
  itemId           String?  @map("item_id")
  serviceCatalogId String?  @map("service_catalog_id")
  reason           String?
  createdAt        DateTime @default(now()) @map("created_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  panelClinic    PanelClinic     @relation(fields: [panelClinicId], references: [id])
  item           Item?           @relation(fields: [itemId], references: [id])
  serviceCatalog ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])

  @@index([tenantId, panelClinicId])
  @@index([tenantId, itemId])
  @@index([tenantId, serviceCatalogId])
  @@map("panel_exclusions")
}

model Visit {
  id                  String               @id @default(uuid())
  tenantId            String               @map("tenant_id")
  clinicId            String               @map("clinic_id")
  patientId           String               @map("patient_id")
  // S3c (D-082) — the CURRENT ATTENDING CLINICIAN, and only that.
  //
  // Nullable since S3c. It was required, which forced front desk to store
  // THEMSELVES as the attending clinician when registering a walk-in nobody
  // had been assigned to yet — so the field could not tell "Dr Amira is
  // seeing this patient" apart from "Amy at the counter typed this in".
  // NULL now means exactly what it says: no clinician has taken this visit.
  //
  // The name is kept rather than corrected to attendingStaffId: it is read
  // across the queue, canvas, documents, orders, prescriptions and reports,
  // and a rename would be churn without changing behaviour. Recorded as
  // technical debt in D-082.
  staffId             String?              @map("staff_id")
  // Who created the visit. Administrative provenance, NEVER clinical
  // attribution — a registrar is not an author and must never be rendered as
  // the attending doctor. Nullable because it cannot be recovered for rows
  // written before this phase; NULL means it was not captured.
  registeredByStaffId String?              @map("registered_by_staff_id")
  // Count-based sequence ("V-000002"), not a DB sequence — same accepted
  // non-atomic-race gap as Inventory's document numbers (docs/DECISIONS.md).
  visitNumber         String               @map("visit_number")
  // Display label ("Self-pay" or the panel's name) — kept as the single
  // source of truth for existing UI that already reads this field.
  // panelClinicId is the structured relation added alongside it; when set,
  // VisitService derives billingType from the panel's name server-side
  // rather than trusting client-supplied text for a panel visit.
  billingType         String               @map("billing_type")
  panelClinicId       String?              @map("panel_clinic_id")
  // G4.5d3c-3b2 (D-094) — the OPERATIONAL kind of visit, for consultation
  // billing only. NULL means "derive": an OTC-queue visit is OTC_ONLY,
  // everything else is CONSULTATION. An explicit value set by counter staff
  // wins over the derivation. Never inferred from diagnosis or note text.
  classification      VisitClassification? @map("classification")
  presentingComplaint String?              @map("presenting_complaint")
  checkInAt           DateTime             @default(now()) @map("check_in_at")
  // The overall OPERATIONAL closure of the visit, and nothing else (D-080).
  // Not set by signing a note, completing the doctor phase, sending the
  // patient onward, printing a label, or paying an invoice.
  checkOutAt          DateTime?            @map("check_out_at")

  // G4.5d3c-1 (D-080) — the doctor's CLINICAL PHASE, which is a different
  // event from both signing a note and closing the visit. All three are
  // nullable and are never backfilled: NULL means "doctor-phase completion
  // was not captured", never "it did not happen". Inferring a historical
  // actor or timestamp would be fabricating an audit trail.
  doctorCompletedAt            DateTime?                    @map("doctor_completed_at")
  doctorCompletedByStaffId     String?                      @map("doctor_completed_by_staff_id")
  doctorCompletedDestination   DoctorCompletionDestination? @map("doctor_completed_destination")
  // G4.5d3c-2b (D-087) — WHY that destination. READY_FOR_PAYMENT has two
  // meanings (a real balance, or billing nobody has worked out yet) and the
  // queue status cannot tell them apart. Stored rather than re-derived: the
  // reason must survive a refresh and must NOT change when prescriptions or
  // invoices move on afterwards.
  doctorCompletedRoutingReason VisitRoutingReason?          @map("doctor_completed_routing_reason")

  // ---------------------------------------------------------------------
  // G4.5d3c-3b1a (D-092) — the VISIT-SPECIFIC panel benefit snapshot.
  //
  // Benefit terms are captured for THIS visit at registration/verification
  // time and never re-read from the panel's live configuration: a panel
  // whose limit changes next month must not reprice an old visit. Every
  // field is nullable — NULL means "not captured", which the billing
  // engine (3b1b) must treat as unresolved, never as unlimited coverage.
  //
  // Selecting a panel does NOT verify it: visit creation with a
  // panelClinicId stores PENDING_VERIFICATION, and only an explicit staff
  // action moves it to VERIFIED / FAILED / OVERRIDDEN.
  // ---------------------------------------------------------------------
  panelMemberReference       String?                  @map("panel_member_reference")
  panelVerificationStatus    PanelVerificationStatus? @map("panel_verification_status")
  panelVerifiedAt            DateTime?                @map("panel_verified_at")
  panelVerifiedByStaffId     String?                  @map("panel_verified_by_staff_id")
  // What the verifier saw: a portal reference, approval code or GL number.
  panelVerificationReference String?                  @map("panel_verification_reference")
  panelCoverageType          PanelCoverageType?       @map("panel_coverage_type")
  panelVisitLimitAmount      Decimal?                 @map("panel_visit_limit_amount") @db.Decimal(10, 2)
  panelCopaymentType         PanelCopaymentType?      @map("panel_copayment_type")
  // RM for FIXED_AMOUNT, percent (0-100] for PERCENTAGE, never both meanings
  // at once — the type column says which this number is.
  panelCopaymentValue        Decimal?                 @map("panel_copayment_value") @db.Decimal(10, 2)

  // The ORIGINAL verified terms, written once at first capture and never
  // updated: an override replaces the working terms above, not the record
  // of what verification actually said (owner rule, audit section O).
  panelOriginalVerificationStatus PanelVerificationStatus? @map("panel_original_verification_status")
  panelOriginalCoverageType       PanelCoverageType?       @map("panel_original_coverage_type")
  panelOriginalVisitLimitAmount   Decimal?                 @map("panel_original_visit_limit_amount") @db.Decimal(10, 2)
  panelOriginalCopaymentType      PanelCopaymentType?      @map("panel_original_copayment_type")
  panelOriginalCopaymentValue     Decimal?                 @map("panel_original_copayment_value") @db.Decimal(10, 2)

  // Override audit — who changed the working terms away from what was
  // verified, when, and the mandatory reason.
  panelBenefitOverrideReason      String?   @map("panel_benefit_override_reason")
  panelBenefitOverriddenAt        DateTime? @map("panel_benefit_overridden_at")
  panelBenefitOverriddenByStaffId String?   @map("panel_benefit_overridden_by_staff_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                        Tenant               @relation(fields: [tenantId], references: [id])
  clinic                        Clinic               @relation(fields: [clinicId], references: [id])
  patient                       Patient              @relation(fields: [patientId], references: [id])
  appointment                   Appointment?
  staff                         Staff?               @relation("VisitAttendingStaff", fields: [staffId], references: [id])
  registeredByStaff             Staff?               @relation("VisitRegisteredBy", fields: [registeredByStaffId], references: [id])
  doctorCompletedByStaff        Staff?               @relation("VisitDoctorCompletedBy", fields: [doctorCompletedByStaffId], references: [id])
  panelVerifiedByStaff          Staff?               @relation("VisitPanelVerifiedBy", fields: [panelVerifiedByStaffId], references: [id])
  panelBenefitOverriddenByStaff Staff?               @relation("VisitPanelBenefitOverriddenBy", fields: [panelBenefitOverriddenByStaffId], references: [id])
  panelClinic                   PanelClinic?         @relation(fields: [panelClinicId], references: [id])
  queueTicket                   QueueTicket?
  clinicalNotes                 ClinicalNote[]
  observations                  VisitObservation[]
  diagnoses                     Diagnosis[]
  orderServices                 OrderService[]
  prescriptions                 Prescription[]
  documents                     Document[]
  invoices                      Invoice[]
  attachments                   VisitAttachment[]
  workflowEvents                VisitWorkflowEvent[]
  consultationChargeLines       InvoiceLine[]        @relation("VisitConsultationChargeLines")
  copiedPrescriptions           Prescription[]       @relation("PrescriptionCopySource")

  @@unique([tenantId, visitNumber])
  @@index([tenantId, clinicId])
  @@index([tenantId, patientId])
  @@map("visits")
}

/**
 * G4.5d3c-1 (D-080) — where the patient goes after the doctor finishes.
 * Recorded at the moment the doctor completes their phase, so the decision is
 * preserved even if the invoice or the prescription changes afterwards. The
 * server derives it; it is never accepted from the browser.
 * NONE means the doctor determined no dispensing and no patient-facing
 * payment work remained — it does NOT mean the visit is closed.
 */
/**
 * G4.5d3c-2b (D-087) — the recorded reason a visit was routed where it was.
 * NO_DOWNSTREAM_WORK is not the same as "the visit is finished": it means the
 * doctor left nothing outstanding, and closing the visit is still a separate
 * explicit act.
 */
// G4.5d3c-3b1a (D-092) — how far this visit's panel eligibility has been
// taken. PENDING_VERIFICATION is the automatic state the moment a panel is
// selected; everything after it is an explicit, attributed staff action.
// G4.5d3c-3b1 (D-093) — which rule produced a line's unit price. An enum,
// not free text: an unvalidated rule string is how audit evidence rots.
enum InvoiceLinePriceRule {
  SPECIFIC_PANEL_PRICE
  CASH_PLUS_MARKUP
  CASH
  MANUAL
}

enum InvoiceDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PanelVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  FAILED
  OVERRIDDEN
}

enum PanelCoverageType {
  UNLIMITED
  VISIT_LIMIT
}

enum PanelCopaymentType {
  NONE
  FIXED_AMOUNT
  PERCENTAGE
}

enum VisitRoutingReason {
  DISPENSARY_REQUIRED
  PATIENT_PAYMENT_REQUIRED
  BILLING_REVIEW_REQUIRED
  NO_DOWNSTREAM_WORK
}

enum DoctorCompletionDestination {
  DISPENSARY
  PAYMENT
  NONE
}

enum QueueTicketStatus {
  WAITING
  IN_CONSULTATION

  // G4.5d3c-1 (D-080) — the operational stations the current enum could not
  // express. Added, not substituted: no existing value changes meaning, and
  // no existing row is rewritten.
  //
  // AT_PROCEDURE returns to IN_CONSULTATION by owner decision: the doctor
  // reviews the completed procedure before finishing their phase. There is
  // deliberately no direct AT_PROCEDURE -> dispensary/payment edge.
  AT_PROCEDURE
  READY_FOR_DISPENSARY
  READY_FOR_PAYMENT

  // LEGACY, still valid. Dispensing and payment are separate states, but
  // rows written before this phase conflated them and are not rewritten —
  // a historical record is what happened, not what the model now prefers.
  // New workflow code should not create this status.
  DISPENSARY_PAYMENT

  COMPLETED
  CANCELLED
}

/**
 * G4.5d3c-1 (D-080) — the append-only operational history of a visit.
 * One QueueTicket represents the patient's CURRENT location (visitId stays
 * @unique, by owner decision), so the ticket's own row cannot carry where the
 * patient has been. This does: the ticket moves, and each move leaves an
 * immutable event behind. That is what makes a round trip through a procedure
 * — IN_CONSULTATION -> AT_PROCEDURE -> IN_CONSULTATION — reconstructable.
 * WHY NOT AuditLog. It was inspected first, as required, and is unsuitable on
 * four counts: it has no visitId, clinicId or queueTicketId, so branch-scoped
 * and per-visit history could only be reached by JSON extraction over an
 * unindexed column; its actor is `actorUserId`, a User, while every clinical
 * attribution in Kuwick is Staff-based; it holds no typed previous/new status;
 * and it has no relations, so nothing enforces that a row's tenant matches
 * the visit it claims to describe. It also has zero call sites anywhere in the
 * codebase — reusing an unused generic log would be forcing workflow history
 * into a shape that cannot answer the questions asked of it.
 */
enum VisitWorkflowEventType {
  PATIENT_CALLED
  CONSULTATION_STARTED
  SENT_TO_PROCEDURE
  RETURNED_TO_DOCTOR
  DOCTOR_PHASE_COMPLETED
  SENT_TO_DISPENSARY
  DISPENSING_COMPLETED
  SENT_TO_PAYMENT
  PAYMENT_WORK_COMPLETED
  VISIT_COMPLETED
  VISIT_CANCELLED
  // S3b (D-081) — a visit changed hands between clinicians. Prospective only:
  // it never rewrites the authorship of anything already recorded.
  ATTENDING_CLINICIAN_CHANGED

  // KW2-C2 — the doctor paused the consultation and returned the patient to
  // the waiting queue, then took them back.
  //
  // RESUMED is a distinct type and NOT a second CONSULTATION_STARTED, on
  // purpose. That event is the consultation's start instant and the
  // consultation tariff reads it: a patient held at 22:40 and resumed at
  // 23:05 must not acquire a late-night fee for a consultation that began
  // before the band. One start per visit, however many pauses.
  CONSULTATION_HELD
  CONSULTATION_RESUMED
}

model VisitWorkflowEvent {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  // Denormalised from the visit so branch-scoped reporting does not need a
  // join, and so a row cannot silently describe another branch's work.
  clinicId      String  @map("clinic_id")
  visitId       String  @map("visit_id")
  // Nullable: a visit event can outlive its ticket, and some events (a
  // doctor-phase completion recorded without a queue) have no ticket at all.
  queueTicketId String? @map("queue_ticket_id")

  eventType VisitWorkflowEventType @map("event_type")

  // Typed, not JSON — "which visits went from AT_PROCEDURE back to the
  // doctor" is an ordinary indexed query, not a JSON scan. Both are nullable
  // because not every event is a queue transition.
  previousStatus QueueTicketStatus? @map("previous_status")
  newStatus      QueueTicketStatus? @map("new_status")

  // Only meaningful on DOCTOR_PHASE_COMPLETED.
  destination DoctorCompletionDestination?

  // S3b — who held the visit before and after. Typed, not a corner of
  // `metadata`: "every visit Dr A handed over last month" should be an
  // ordinary indexed query. Both null unless the event is a handover.
  previousStaffId String? @map("previous_staff_id")
  newStaffId      String? @map("new_staff_id")

  // Identity snapshot, same principle as C0's clinical events: the role is
  // stored as plain text at the moment it happened, so a later promotion or
  // enum rename cannot rewrite who did what.
  actorStaffId      String @map("actor_staff_id")
  actorNameSnapshot String @map("actor_name_snapshot")
  actorRoleSnapshot String @map("actor_role_snapshot")

  reason   String?
  metadata Json?

  // Idempotency: a retried request carrying the same key writes one event,
  // not two. Unique per tenant so one clinic's key cannot collide with
  // another's.
  correlationId String? @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  clinic        Clinic       @relation(fields: [clinicId], references: [id])
  visit         Visit        @relation(fields: [visitId], references: [id])
  queueTicket   QueueTicket? @relation(fields: [queueTicketId], references: [id])
  actor         Staff        @relation("WorkflowEventActor", fields: [actorStaffId], references: [id])
  previousStaff Staff?       @relation("WorkflowEventPreviousStaff", fields: [previousStaffId], references: [id])
  newStaff      Staff?       @relation("WorkflowEventNewStaff", fields: [newStaffId], references: [id])

  @@unique([tenantId, correlationId])
  @@index([tenantId, visitId, createdAt])
  @@index([tenantId, clinicId, createdAt])
  @@index([tenantId, eventType, createdAt])
  @@index([tenantId, actorStaffId, createdAt])
  @@map("visit_workflow_events")
}

// Queue overhaul (D-038) — kuwick.com's real 4-stream numbering: A for
// appointment arrivals, C for OTC (over-the-counter, no consultation),
// W for walk-ins, E for emergencies. Each stream numbers independently per
// clinic per day (W001, E001, ...).
enum QueueType {
  APPOINTMENT
  OTC
  WALK_IN
  EMERGENCY
}

// Physical stations a patient can be called to — Consultation 1/2,
// Treatment Room 1/2, Dispensary Counter (D-038). Per clinic, staff-
// maintained under Management > Operation.
model Room {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  clinicId  String   @map("clinic_id")
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  queueTickets  QueueTicket[]
  orderServices OrderService[]

  @@unique([tenantId, clinicId, name])
  @@index([tenantId, clinicId])
  @@map("rooms")
}

// Waiting-room monitor configuration (D-038) — one per clinic: the
// clinic's own YouTube video, scrolling text, and the announcement voice's
// name/rate/pitch/volume (browser SpeechSynthesis, D-025 — voiceName
// matches a SpeechSynthesisVoice.name on the display machine).
model QueueDisplayConfig {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  clinicId    String   @unique @map("clinic_id")
  youtubeUrl  String?  @map("youtube_url")
  runningText String?  @map("running_text")
  voiceName   String?  @map("voice_name")
  voiceRate   Float    @default(1) @map("voice_rate")
  voicePitch  Float    @default(1) @map("voice_pitch")
  voiceVolume Float    @default(1) @map("voice_volume")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([tenantId])
  @@map("queue_display_configs")
}

// Mirrors the audited kuwick.com Queue module's five tabs (Overview folds
// into the others; Waiting/Consultation/Dispensary & Payment/Completed map
// 1:1 onto this enum plus CANCELLED). One ticket per Visit — see D-023,
// D-024 (docs/DECISIONS.md) for why Dispensary & Payment/Completed stay
// thin here, matching the reference system, while the state machine itself
// is fully real.
model QueueTicket {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  clinicId      String            @map("clinic_id")
  visitId       String            @unique @map("visit_id")
  // Per-queue-type sequence, resets daily per clinic — same accepted
  // count-based gap as Visit.visitNumber.
  ticketNumber  Int               @map("ticket_number")
  // Queue overhaul (D-038): "W001"/"A003"/... — prefix from queueType +
  // zero-padded ticketNumber, snapshotted at creation so renumbering rules
  // can change later without rewriting history. Nullable only for tickets
  // created before this phase.
  displayNumber String?           @map("display_number")
  queueType     QueueType         @default(WALK_IN) @map("queue_type")
  status        QueueTicketStatus @default(WAITING)
  location      String?
  // Where the patient was called to (D-038) — set by the Call action.
  roomId        String?           @map("room_id")
  calledAt      DateTime?         @map("called_at")
  cancelReason  String?           @map("cancel_reason")

  // KW2-C2 — the CURRENT hold, and only the current one.
  //
  // The history of every pause and resumption lives in visit_workflow_events,
  // which is where history belongs. These two exist so the queue board can
  // tell a held patient apart from an ordinary waiting one in the same
  // indexed read it already does — deriving it from the last event would put
  // a per-row event lookup in the middle of the busiest list in the clinic.
  //
  // Both are cleared on resume. A ticket that is not on hold carries no trace
  // of having been, in this model; the events carry that.
  heldAt        DateTime? @map("held_at")
  heldByStaffId String?   @map("held_by_staff_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  clinic         Clinic               @relation(fields: [clinicId], references: [id])
  visit          Visit                @relation(fields: [visitId], references: [id])
  room           Room?                @relation(fields: [roomId], references: [id])
  heldBy         Staff?               @relation("QueueTicketHeldBy", fields: [heldByStaffId], references: [id], onDelete: Restrict)
  // The ticket holds the CURRENT location; these hold where it has been.
  workflowEvents VisitWorkflowEvent[]

  @@index([tenantId, clinicId, status])
  @@index([tenantId, clinicId, createdAt])
  @@map("queue_tickets")
}

enum NoteLanguage {
  EN
  MS
}

// Clinical Operations, Phase 2a; extended D-044 to many-per-visit. Matches
// the audited kuwick.com Clinical Notes tab (Vital Signs, Anthropometry,
// Point of Care, Notes with a language toggle). Filled in progressively
// during a consultation, so every clinical field is optional. A visit can
// carry several of these (e.g. triage vitals, then a reassessment note
// after a nebuliser) — visitId is a plain FK, not unique, ordered by
// createdAt for display. BMI is intentionally not a stored column — it's
// derived from weight/height at read time so it can't go stale if either
// is edited later.
model ClinicalNote {
  id           String       @id @default(uuid())
  tenantId     String       @map("tenant_id")
  clinicId     String?      @map("clinic_id")
  visitId      String       @map("visit_id")
  notes        String?
  noteLanguage NoteLanguage @default(EN) @map("note_language")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // ---- C0: vitals columns below are FROZEN LEGACY ----------------------
  // Vitals moved to VisitObservation so a front-desk member recording BP
  // can never become the author of a doctor's narrative (owner: "A staff
  // member recording vitals must not become the author of the doctor's
  // narrative"). These columns are retained read-only for backward
  // compatibility and are never written again; dropping them is a separate
  // approved cleanup after verification.
  bpSystolic        Int?     @map("bp_systolic")
  bpDiastolic       Int?     @map("bp_diastolic")
  pulse             Int?
  temperature       Decimal? @db.Decimal(4, 1)
  spo2              Int?
  respRate          Int?     @map("resp_rate")
  painScore         Int?     @map("pain_score")
  weight            Decimal? @db.Decimal(5, 2)
  height            Decimal? @db.Decimal(5, 2)
  headCircumference Decimal? @map("head_circumference") @db.Decimal(5, 2)
  glucose           Decimal? @db.Decimal(5, 2)
  // ----------------------------------------------------------------------

  noteType  ClinicalNoteType      @default(DOCTOR_NARRATIVE) @map("note_type")
  status    ClinicalNoteStatus    @default(DRAFT)
  entryType ClinicalNoteEntryType @default(STANDARD) @map("entry_type")
  // Optimistic concurrency — every mutation bumps this and every mutating
  // request must send the value it read, or it gets a 409 instead of
  // silently clobbering a newer save.
  version   Int                   @default(1)

  // Author = whoever actually typed this entry, taken from the authenticated
  // session, never from the request body and never inferred from the visit's
  // attending doctor. Snapshots are written once and never refreshed, so a
  // later rename/role change can't rewrite history. Stored as String (not the
  // Role enum) so historical records survive an enum rename.
  authorStaffId             String? @map("author_staff_id")
  authorNameSnapshot        String? @map("author_name_snapshot")
  authorRoleSnapshot        String? @map("author_role_snapshot")
  authorDesignationSnapshot String? @map("author_designation_snapshot")

  // G4.5d6 — finalization is a distinct act from a hand signature. Historic
  // manually-signed notes leave these null, which is exactly what identifies
  // them as manually signed.
  finalizedAt        DateTime? @map("finalized_at")
  finalizedByStaffId String?   @map("finalized_by_staff_id")
  finalizationMode   String?   @map("finalization_mode")

  signedByStaffId           String?   @map("signed_by_staff_id")
  signerNameSnapshot        String?   @map("signer_name_snapshot")
  signerRoleSnapshot        String?   @map("signer_role_snapshot")
  signerDesignationSnapshot String?   @map("signer_designation_snapshot")
  signedAt                  DateTime? @map("signed_at")

  // Late entry: the clinical event happened earlier than the system entry.
  // createdAt is NEVER backdated — both times are kept and displayed.
  clinicalEntryAt DateTime? @map("clinical_entry_at")
  lateEntryReason String?   @map("late_entry_reason")

  // An amendment is a NEW row pointing at the signed original; the original
  // is never mutated out of SIGNED. "Amended" is derived from the existence
  // of a linked amendment, not stored on the original.
  supersedesNoteId String? @map("supersedes_note_id")
  amendmentReason  String? @map("amendment_reason")

  // True only for rows that predate authorship tracking. Distinguishes a
  // genuine legacy record from a bug that produced a NULL author later.
  legacyAuthorUnknown Boolean @default(false) @map("legacy_author_unknown")

  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  clinic      Clinic?                @relation(fields: [clinicId], references: [id])
  visit       Visit                  @relation(fields: [visitId], references: [id])
  author      Staff?                 @relation("ClinicalNoteAuthor", fields: [authorStaffId], references: [id])
  signedBy    Staff?                 @relation("ClinicalNoteSigner", fields: [signedByStaffId], references: [id])
  finalizedBy Staff?                 @relation("ClinicalNoteFinalizer", fields: [finalizedByStaffId], references: [id], onDelete: Restrict)
  supersedes  ClinicalNote?          @relation("ClinicalNoteAmendment", fields: [supersedesNoteId], references: [id])
  amendments  ClinicalNote[]         @relation("ClinicalNoteAmendment")
  revisions   ClinicalNoteRevision[]

  @@index([tenantId])
  @@index([tenantId, visitId])
  @@index([tenantId, supersedesNoteId])
  @@map("clinical_notes")
}

// C0 — append-only audit trail for clinical notes. No update or delete API
// is ever exposed for these rows; `updatedAt` on the note alone cannot
// answer "what changed", so every mutation writes a full content snapshot.
model ClinicalNoteRevision {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  noteId    String @map("note_id")
  // Matches ClinicalNote.version AFTER the change this row records.
  versionNo Int    @map("version_no")

  contentSnapshot   Json                   @map("content_snapshot")
  // sha256 over a canonical serialisation (see canonical-content-hash.ts).
  // Set on SIGNED revisions so the exact signed content can be verified
  // later; hashSchemaVersion records which canonicalisation produced it, so
  // the rules can evolve without invalidating historical hashes.
  contentHash       String?                @map("content_hash")
  hashSchemaVersion Int?                   @map("hash_schema_version")
  changeType        ClinicalNoteChangeType @map("change_type")
  previousStatus    ClinicalNoteStatus?    @map("previous_status")
  newStatus         ClinicalNoteStatus     @map("new_status")

  editedByStaffId           String?  @map("edited_by_staff_id")
  editorNameSnapshot        String?  @map("editor_name_snapshot")
  editorRoleSnapshot        String?  @map("editor_role_snapshot")
  editorDesignationSnapshot String?  @map("editor_designation_snapshot")
  editedAt                  DateTime @default(now()) @map("edited_at")
  reason                    String?

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  note   ClinicalNote @relation(fields: [noteId], references: [id])

  @@unique([noteId, versionNo])
  @@index([tenantId, noteId])
  @@map("clinical_note_revisions")
}

// C0 — vitals/anthropometry/point-of-care, attributed to whoever actually
// recorded them. Separate from ClinicalNote so vitals entry and narrative
// authorship are never conflated. A visit may hold several sets: a REPEATED
// reading (BP at 10:00, repeat at 10:30) is a NEW row; a CORRECTION of a
// mistyped value updates the row and writes an immutable revision preserving
// the previous value. BMI stays derived, never stored
// (docs/DATABASE_ARCHITECTURE.md §3 — a stored BMI goes stale the moment
// weight or height is edited without the other).
model VisitObservation {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  clinicId String @map("clinic_id")
  visitId  String @map("visit_id")

  recordedByStaffId           String?  @map("recorded_by_staff_id")
  recorderNameSnapshot        String?  @map("recorder_name_snapshot")
  recorderRoleSnapshot        String?  @map("recorder_role_snapshot")
  recorderDesignationSnapshot String?  @map("recorder_designation_snapshot")
  recordedAt                  DateTime @default(now()) @map("recorded_at")

  updatedByStaffId    String?  @map("updated_by_staff_id")
  updaterNameSnapshot String?  @map("updater_name_snapshot")
  updaterRoleSnapshot String?  @map("updater_role_snapshot")
  updatedAt           DateTime @updatedAt @map("updated_at")
  version             Int      @default(1)

  bpSystolic        Int?     @map("bp_systolic")
  bpDiastolic       Int?     @map("bp_diastolic")
  pulse             Int?
  temperature       Decimal? @db.Decimal(4, 1)
  spo2              Int?
  respRate          Int?     @map("resp_rate")
  painScore         Int?     @map("pain_score")
  weight            Decimal? @db.Decimal(5, 2)
  height            Decimal? @db.Decimal(5, 2)
  headCircumference Decimal? @map("head_circumference") @db.Decimal(5, 2)
  glucose           Decimal? @db.Decimal(5, 2)

  source                ObservationSource @default(MANUAL)
  // True for rows backfilled from legacy ClinicalNote vitals, whose recorder
  // is genuinely unknown. Never inferred from the note or attending doctor.
  legacyRecorderUnknown Boolean           @default(false) @map("legacy_recorder_unknown")

  tenant     Tenant                     @relation(fields: [tenantId], references: [id])
  clinic     Clinic                     @relation(fields: [clinicId], references: [id])
  visit      Visit                      @relation(fields: [visitId], references: [id])
  recordedBy Staff?                     @relation("ObservationRecorder", fields: [recordedByStaffId], references: [id])
  updatedBy  Staff?                     @relation("ObservationUpdater", fields: [updatedByStaffId], references: [id])
  revisions  VisitObservationRevision[]

  @@index([tenantId, visitId, recordedAt])
  @@map("visit_observations")
}

// C0 closure — append-only audit of every change to a staff member's
// professional identity and clinical-signing permission. `updatedAt` on Staff
// alone cannot answer "who granted this doctor the right to sign, and when",
// which is the question that matters medicolegally. One row per changed
// field, so a value's whole history is queryable.
model StaffProfessionalAudit {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  // Branch context at the time of the change (the affected staff member's
  // home branch, if any) — recorded, not resolved later, since it can move.
  clinicId String? @map("clinic_id")
  // The staff member whose professional identity changed.
  staffId  String  @map("staff_id")

  field         ProfessionalAuditField
  previousValue String?                @map("previous_value")
  newValue      String?                @map("new_value")

  changedByStaffId      String?  @map("changed_by_staff_id")
  changedByNameSnapshot String?  @map("changed_by_name_snapshot")
  changedByRoleSnapshot String?  @map("changed_by_role_snapshot")
  changedAt             DateTime @default(now()) @map("changed_at")
  reason                String?

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  staff     Staff  @relation("ProfessionalAuditSubject", fields: [staffId], references: [id])
  changedBy Staff? @relation("ProfessionalAuditActor", fields: [changedByStaffId], references: [id])

  @@index([tenantId, staffId, changedAt])
  @@map("staff_professional_audits")
}

// C0 — append-only audit trail for observations. A correction must preserve
// what the value used to be; updatedBy/updatedAt alone cannot.
model VisitObservationRevision {
  id            String @id @default(uuid())
  tenantId      String @map("tenant_id")
  observationId String @map("observation_id")
  versionNo     Int    @map("version_no")

  contentSnapshot   Json                  @map("content_snapshot")
  contentHash       String?               @map("content_hash")
  hashSchemaVersion Int?                  @map("hash_schema_version")
  changeType        ObservationChangeType @map("change_type")

  editedByStaffId           String?  @map("edited_by_staff_id")
  editorNameSnapshot        String?  @map("editor_name_snapshot")
  editorRoleSnapshot        String?  @map("editor_role_snapshot")
  editorDesignationSnapshot String?  @map("editor_designation_snapshot")
  editedAt                  DateTime @default(now()) @map("edited_at")
  correctionReason          String?  @map("correction_reason")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  observation VisitObservation @relation(fields: [observationId], references: [id])

  @@unique([observationId, versionNo])
  @@index([tenantId, observationId])
  @@map("visit_observation_revisions")
}

// D-044 — free-standing visit-level uploads (photos, scanned results, PDFs)
// shown alongside Clinical Notes/Vitals, distinct from Attachment (which is
// scoped to a single OrderService/procedure result). Same local-disk
// storage convention as Attachment (core/file-storage.ts).
model VisitAttachment {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  visitId           String   @map("visit_id")
  fileName          String   @map("file_name")
  filePath          String   @map("file_path")
  mimeType          String   @map("mime_type")
  fileSize          Int      @map("file_size")
  uploadedByStaffId String?  @map("uploaded_by_staff_id")
  createdAt         DateTime @default(now()) @map("created_at")

  // b0 — WHAT KIND of file this is, in the clinic's own filing terms: a
  // clinical PHOTO, a LAB result, or an incoming LETTER. It is stored, not
  // derived, because the two are genuinely different questions: a referral
  // letter arrives as a photographed page (image/jpeg) at least as often as
  // a PDF, and a lab result photographed off a machine screen is not a
  // clinical photo. Derivation from the MIME type gets both wrong.
  //
  // Upload picks a default from the file type; whoever re-files it is
  // recorded, because the tag is what a later reader searches the record by.
  category             VisitAttachmentCategory @default(PHOTO)
  categorySetByStaffId String?                 @map("category_set_by_staff_id")
  categorySetAt        DateTime?               @map("category_set_at")

  // G3a (D-062) — audited removal. filePath is deliberately untouched: the
  // clinical image stays on disk so authorised history can still retrieve it.
  recordStatus          AttachmentRecordStatus @default(ACTIVE) @map("record_status")
  removedAt             DateTime?              @map("removed_at")
  removedByStaffId      String?                @map("removed_by_staff_id")
  removedByNameSnapshot String?                @map("removed_by_name_snapshot")
  removedByRoleSnapshot String?                @map("removed_by_role_snapshot")
  removalReason         String?                @map("removal_reason")
  version               Int                    @default(1)

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  visit      Visit  @relation(fields: [visitId], references: [id])
  uploadedBy Staff? @relation(fields: [uploadedByStaffId], references: [id])
  removedBy  Staff? @relation("VisitAttachmentRemovedBy", fields: [removedByStaffId], references: [id])
  categoryBy Staff? @relation("VisitAttachmentCategoryBy", fields: [categorySetByStaffId], references: [id])

  @@index([tenantId, visitId])
  @@index([tenantId, visitId, recordStatus])
  @@map("visit_attachments")
}

// Clinical Operations, Phase 2b. Per-tenant catalog matching the audited
// kuwick.com Diagnosis tab's "search/add diagnosis from catalog" — no
// dedicated admin CRUD screen this phase; entries are created inline when a
// diagnosis isn't found (Clinical 2b plan, judgment call #3).
/// ---------------------------------------------------------------------------
/// b1 PHASE 1 — PRESCRIPTION REFERENCE DATA
///
/// Five catalogues that together decide what a prescription can say, and what
/// its printed label says in Malay. They exist because the alternative is
/// clinical vocabulary hardcoded in application code: the previous form asked
/// a doctor to TYPE the frequency and the unit as free text, which is how one
/// clinic ends up with "TDS", "tds", "3x daily" and "tiga kali" meaning the
/// same thing on four labels, and how a patient label ends up in English.
///
/// THE PLATFORM MODEL, which every one of these follows:
///
///   SYSTEM rows are the platform's defaults. They are seeded into each
///   tenant, and the clinic cannot edit or delete them through the API —
///   `assertCustomOrigin` refuses. They are shown as locked rows in Settings.
///
///   CUSTOM rows are the clinic's own, added on top, fully editable.
///
/// Seeded PER TENANT rather than as null-tenant global rows, matching
/// `DiagnosisCatalog`, which is the existing precedent for exactly this
/// shape — and matching the standing architectural rule that tenants RECEIVE
/// defaults rather than reading a shared table they do not own. The platform's
/// channel for changing a default is the seeder (idempotent, and it REPAIRS on
/// re-run — the diagnosis outage was a seed that could not repair). The
/// clinic's channel is the API, and the API refuses to touch SYSTEM rows.
/// Those are deliberately different channels; do not "fix" one by opening the
/// other.
///
/// Nothing here is deleted, ever: `active = false` retires a row. A frequency
/// or a unit is referenced by prescriptions that have already been dispensed
/// and printed, and a label that cannot be reprinted because a lookup row was
/// removed is a medicolegal gap.
/// ---------------------------------------------------------------------------

enum CatalogOrigin {
  /// The platform's default. Seeded; not editable by the clinic.
  SYSTEM
  /// The clinic's own addition.
  CUSTOM
}

enum DurationUnit {
  DAY
  WEEK
  MONTH
}

/// 1A — how often a dose is taken.
model PrescriptionFrequency {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// What the DOCTOR prescribes by, and the only thing they type: OD, BD, TDS.
  code String

  /// The English expansion, for the prescriber's own list. Never printed on a
  /// patient label — the label is bilingual by way of `code (patientLabelBm)`.
  doctorDisplay String @map("doctor_display")

  /// What the PATIENT reads. The printed label shows "OD (Sekali sehari)":
  /// the code because that is what the clinic says to each other, the Malay
  /// because that is what the person taking the medicine reads.
  patientLabelBm String @map("patient_label_bm")

  /// Doses per day, and NULL is a real answer that means "cannot be counted".
  /// PRN and STAT have no daily count, so quantity auto-compute must SKIP
  /// them rather than treat them as one — computing "1 × 5 days" for a
  /// when-required painkiller is a quantity nobody decided.
  timesPerDay Int? @map("times_per_day")

  origin    CatalogOrigin @default(CUSTOM)
  active    Boolean       @default(true)
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  items  Item[] @relation("ItemDefaultFrequency")

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("prescription_frequencies")
}

/// 1B — the unit a dose is measured in.
model DosageUnit {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// The doctor's view, in English: Tablet, Millilitre, Puff.
  systemNameEn String @map("system_name_en")

  /// The patient's view, in Malay: BIJI, mL, SEDUTAN. Deliberately not a
  /// translation of the English word but what a Malaysian label actually says.
  patientLabelBm String @map("patient_label_bm")

  /// Where this unit belongs — "syrup/liquid", "eye/ear/nasal". Guidance for
  /// whoever is choosing, not a rule the system enforces: a clinic may
  /// legitimately measure something in a way this note did not anticipate.
  useCase String? @map("use_case")

  origin    CatalogOrigin @default(CUSTOM)
  active    Boolean       @default(true)
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  items  Item[] @relation("ItemDefaultDoseUnit")

  @@unique([tenantId, systemNameEn])
  @@index([tenantId, active])
  @@map("dosage_units")
}

/// 1C — how the medicine is taken, and the instruction that prints for it.
///
/// Named `ConsumptionMethodRef` because `Item.consumptionMethod` is an
/// existing free-text column on the medicine and the two must not be confused
/// while the structured one is being adopted.
model ConsumptionMethodRef {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// Bilingual on purpose, as one string: "ORAL (MAKAN/MINUM)". The clinic
  /// reads both halves and splitting them would invite a screen that shows
  /// only one.
  methodBilingual String @map("method_bilingual")

  /// The sentence that PRINTS on the label: "Ambil melalui mulut". This is the
  /// row's reason for existing — a route with no instruction leaves the
  /// patient to guess.
  patientInstructionBm String @map("patient_instruction_bm")

  origin    CatalogOrigin @default(CUSTOM)
  active    Boolean       @default(true)
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  items  Item[] @relation("ItemDefaultConsumptionMethod")

  @@unique([tenantId, methodBilingual])
  @@index([tenantId, active])
  @@map("consumption_methods")
}

/// 1D — what the medicine is FOR, offered in both languages.
///
/// A preset list, not a closed one: free text remains allowed on the
/// prescription, because a doctor must never be unable to say why.
model IndicationPreset {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  labelEn String @map("label_en")
  labelBm String @map("label_bm")

  origin    CatalogOrigin @default(CUSTOM)
  active    Boolean       @default(true)
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, labelEn])
  @@index([tenantId, active])
  @@map("indication_presets")
}

/// 1E — how stock is COUNTED on the shelf: "TABLET PER STRIP", "VIAL".
///
/// The clinic does not add to this one. It is the platform's list, because the
/// number beside it (`Item.quantityPerStockUnit`) is what stock deduction
/// arithmetic depends on, and a clinic-invented packaging word with no agreed
/// meaning is a deduction nobody can check.
model StockUnitRef {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  name String

  // INVENTORY PIECE 1 — the shelf is read in two languages.
  //
  // Kuwick 1.0 prints the stock balance as "99 Strip / Papan", and the staff
  // who count the shelf read the Malay half. The English name is the
  // platform's word and stays the identifier (`@@unique([tenantId, name])`);
  // this is the label beside it.
  //
  // Nullable, and deliberately: the 13 SYSTEM units are translated in the
  // seed, and a unit a clinic adds itself has no translation until somebody
  // types one. A missing Malay label renders the English name alone rather
  // than a blank or a machine guess.
  nameMs String? @map("name_ms")

  origin    CatalogOrigin @default(SYSTEM)
  active    Boolean       @default(true)
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  items  Item[] @relation("ItemStockUnit")

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("stock_units")
}

enum DiagnosisCategory {
  CUSTOM
  SUMMARIZE
  FULL
}

// D-027 (docs/DECISIONS.md): category is the real meaning of the audited
// kuwick.com "Custom/Summarize/Full" toggle — CUSTOM is clinic-created (via
// the Diagnoses Directory admin screen), SUMMARIZE is a curated global
// subset (~162 entries as owner-supplied), FULL is the complete ICD-10
// standard catalog (~5,064 entries, owner-supplied separately). The visit's
// diagnosis picker filters its search by this field, not by how the
// already-added list is displayed.
model DiagnosisCatalog {
  id        String            @id @default(uuid())
  tenantId  String            @map("tenant_id")
  icd10Code String?           @map("icd10_code")
  name      String
  // KW2-Q3 — how the clinic actually says it. "URTI", "HTN", "AGE".
  // Searched alongside the code and the full name, because nobody types
  // "Acute upper respiratory infection" mid-consultation.
  shortform String?
  category  DiagnosisCategory @default(CUSTOM)
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  diagnoses Diagnosis[]

  @@unique([tenantId, name])
  @@unique([tenantId, icd10Code])
  @@index([tenantId])
  @@index([tenantId, category])
  @@map("diagnosis_catalog")
}

// One row per diagnosis added to a Visit — snapshots icd10Code/name from
// the catalog at add-time (same historical-stability convention as
// PanelInvoice's price snapshot, docs/DATABASE_ARCHITECTURE.md §7), so a
// later catalog rename never silently rewrites an existing visit's record.
// G2a (D-059) — a visit's diagnosis is an attributed clinical record in its
// own right, deliberately NOT part of the ClinicalNote authorship model.
enum DiagnosisPriority {
  PRIMARY
  SECONDARY
}

// G2 closure (D-061) — a saved diagnosis is never deleted. Removing one is a
// clinical correction that leaves the original row, its content and its
// original attribution intact, and records who removed it, when and why.
enum DiagnosisRecordStatus {
  ACTIVE
  REMOVED_IN_ERROR
}

model Diagnosis {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  visitId            String   @map("visit_id")
  diagnosisCatalogId String?  @map("diagnosis_catalog_id")
  icd10Code          String?  @map("icd10_code")
  name               String
  createdAt          DateTime @default(now()) @map("created_at")

  // NULL means "priority not recorded" — the honest state for every row that
  // existed before G2a. Historical priority is never inferred, so nothing is
  // backfilled to PRIMARY or SECONDARY. At most one PRIMARY per visit is
  // enforced by a partial unique index (see the migration), so two concurrent
  // requests cannot both win.
  priority DiagnosisPriority?

  // Attribution, always from the authenticated server session — never from
  // the browser. Snapshots are frozen at write time so a later rename or role
  // change cannot rewrite who recorded this diagnosis.
  addedByStaffId      String?  @map("added_by_staff_id")
  addedByNameSnapshot String?  @map("added_by_name_snapshot")
  addedByRoleSnapshot String?  @map("added_by_role_snapshot")
  addedAt             DateTime @default(now()) @map("added_at")

  // Explicit, like ClinicalNote.legacyAuthorUnknown (C0): distinguishes "we
  // know nobody recorded this" from a null that might just be a bug. Set only
  // by the migration, for rows that predate attribution.
  legacyAttributionUnknown Boolean @default(false) @map("legacy_attribution_unknown")

  // G2 closure (D-061) — removal is a correction, not a delete. The row, its
  // content, its priority and its ORIGINAL attribution all survive; only
  // recordStatus changes, plus who removed it, when and why. There is no
  // application path that deletes a saved diagnosis.
  recordStatus          DiagnosisRecordStatus @default(ACTIVE) @map("record_status")
  removedAt             DateTime?             @map("removed_at")
  removedByStaffId      String?               @map("removed_by_staff_id")
  removedByNameSnapshot String?               @map("removed_by_name_snapshot")
  removedByRoleSnapshot String?               @map("removed_by_role_snapshot")
  removalReason         String?               @map("removal_reason")

  // Optimistic concurrency, so a stale client cannot remove a diagnosis that
  // has changed since it was read.
  version Int @default(1)

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  visit            Visit             @relation(fields: [visitId], references: [id])
  diagnosisCatalog DiagnosisCatalog? @relation(fields: [diagnosisCatalogId], references: [id])
  addedBy          Staff?            @relation("DiagnosisRecorder", fields: [addedByStaffId], references: [id])
  removedBy        Staff?            @relation("DiagnosisRemover", fields: [removedByStaffId], references: [id])

  @@index([tenantId, visitId])
  @@index([tenantId, visitId, recordStatus])
  @@map("diagnoses")
}

/// b2 PHASE E — how soon the work is needed.
enum OrderUrgency {
  ROUTINE
  URGENT
}

enum OrderServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Clinical Operations, Phase 2c. Backs both the audited kuwick.com Orders &
// Services tab (per-visit, all statuses/types) and the standalone Procedure
// Queue (cross-visit, TASK_ORDER only — Clinical 2c plan, judgment call #1).
// Snapshots code/procedureName/orderType from ServiceCatalog at order time,
// same historical-stability convention as Diagnosis and PanelInvoice's
// price snapshot. clinicId is denormalized for the Procedure Queue's
// cross-visit query, same as QueueTicket.
model OrderService {
  id                 String             @id @default(uuid())
  tenantId           String             @map("tenant_id")
  clinicId           String             @map("clinic_id")
  visitId            String             @map("visit_id")
  serviceCatalogId   String             @map("service_catalog_id")
  code               String?
  procedureName      String             @map("procedure_name")
  orderType          ServiceOrderType   @map("order_type")
  instruction        String?
  // b2 PHASE E — where the work happens, how urgently, and how many.
  //
  // Nullable on purpose for the first two: an order placed before this existed
  // had no room and no urgency, and backfilling "Routine" would be a claim
  // about work nobody assessed. `quantity` is NOT NULL at 1 because every row
  // already written was exactly one of the thing — a fact, not a guess.
  roomId             String?            @map("room_id")
  urgency            OrderUrgency?
  quantity           Int                @default(1)
  result             String?
  status             OrderServiceStatus @default(PENDING)
  // Defaults to Visit.staffId at creation — no separate doctor-picker UI
  // this phase, since no real auth/user-identity exists yet (docs/DECISIONS.md
  // D-017) and Visit already captures the attending physician.
  requestedByStaffId String             @map("requested_by_staff_id")
  requestedAt        DateTime           @default(now()) @map("requested_at")
  completedAt        DateTime?          @map("completed_at")
  cancelReason       String?            @map("cancel_reason")
  // Phase A7 — set together at complete-time when the service has a
  // matching FormTemplate. formTemplateId is the template used at
  // completion time (kept even if the template is edited/deactivated
  // later, so a historical result still shows which form it came from);
  // formData is the filled-in {fieldId: value} map. `result` (free text)
  // stays populated too — either typed directly, or an auto-generated
  // plain-text summary of formData — so every existing reader (table
  // column, print view) keeps working without a template.
  formTemplateId     String?            @map("form_template_id")
  formData           Json?              @map("form_data")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  clinic         Clinic         @relation(fields: [clinicId], references: [id])
  visit          Visit          @relation(fields: [visitId], references: [id])
  serviceCatalog ServiceCatalog @relation(fields: [serviceCatalogId], references: [id])
  requestedBy    Staff          @relation(fields: [requestedByStaffId], references: [id])
  formTemplate   FormTemplate?  @relation(fields: [formTemplateId], references: [id])
  // SetNull, never Cascade: retiring a treatment room must not delete the
  // record that a procedure was carried out in it.
  room           Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  attachments    Attachment[]
  invoiceLines   InvoiceLine[]
  chatMessages   ChatMessage[]

  @@index([tenantId, visitId])
  @@index([tenantId, clinicId, orderType, status])
  @@index([tenantId, roomId, status])
  @@map("order_services")
}

// D-046 — one lightweight thread model backs two owner-requested surfaces:
// per-procedure chat (orderServiceId set — "tell the doctor this procedure
// was unsuccessful") and clinic-wide channel chat (channelId set — see
// D-048/ChatChannel). Polling-based (no WebSocket infrastructure in this
// environment), same convention as the Queue's 10s refetchInterval.
model ChatMessage {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  clinicId       String   @map("clinic_id")
  channelId      String?  @map("channel_id")
  orderServiceId String?  @map("order_service_id")
  staffId        String   @map("staff_id")
  message        String
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  channel      ChatChannel?  @relation(fields: [channelId], references: [id])
  orderService OrderService? @relation(fields: [orderServiceId], references: [id])
  staff        Staff         @relation(fields: [staffId], references: [id])

  @@index([tenantId, clinicId, orderServiceId, createdAt])
  @@index([tenantId, channelId, createdAt])
  @@map("chat_messages")
}

// D-048 — named team channels alongside the single "General" channel every
// clinic gets (owner: "any option group chat" beyond the one general
// thread — e.g. a "Doctors" or "Front Desk" channel). `isGeneral` marks the
// one channel every clinic always has (auto-created lazily, never deleted);
// any staff member can create additional named channels — this app has no
// RBAC enforcement anywhere yet, so channel creation isn't gated either,
// consistent with everything else.
model ChatChannel {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  clinicId  String   @map("clinic_id")
  name      String
  isGeneral Boolean  @default(false) @map("is_general")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  clinic   Clinic        @relation(fields: [clinicId], references: [id])
  messages ChatMessage[]

  @@unique([clinicId, name])
  @@index([tenantId, clinicId])
  @@map("chat_channels")
}

// Clinical Operations, Phase A3. Files attached to a task/procedure result
// (e.g. an X-ray image for an imaging order) — stored on local disk
// (docs/DECISIONS.md), not blob content in the DB. uploadedByStaffId
// defaults to the order's own requestedByStaffId at upload time, same
// no-separate-picker convention as OrderService.requestedByStaffId (D-017:
// no real auth/user-identity yet).
model Attachment {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  orderServiceId    String   @map("order_service_id")
  fileName          String   @map("file_name")
  filePath          String   @map("file_path")
  mimeType          String   @map("mime_type")
  fileSize          Int      @map("file_size")
  uploadedByStaffId String   @map("uploaded_by_staff_id")
  createdAt         DateTime @default(now()) @map("created_at")

  // G3a (D-062) — audited removal for investigation/procedure results. The
  // order relationship and the file itself are both preserved.
  recordStatus          AttachmentRecordStatus @default(ACTIVE) @map("record_status")
  removedAt             DateTime?              @map("removed_at")
  removedByStaffId      String?                @map("removed_by_staff_id")
  removedByNameSnapshot String?                @map("removed_by_name_snapshot")
  removedByRoleSnapshot String?                @map("removed_by_role_snapshot")
  removalReason         String?                @map("removal_reason")
  version               Int                    @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  orderService OrderService @relation(fields: [orderServiceId], references: [id])
  uploadedBy   Staff        @relation(fields: [uploadedByStaffId], references: [id])
  removedBy    Staff?       @relation("OrderAttachmentRemovedBy", fields: [removedByStaffId], references: [id])

  @@index([tenantId, orderServiceId])
  @@index([tenantId, orderServiceId, recordStatus])
  @@map("attachments")
}

enum DocumentType {
  MC
  REFERRAL
  MEMO
  QUARANTINE
  /// "Attended 14:00–16:30" — an attendance fact the counter can attest,
  /// not a clinical opinion. Carries `hours`; see the column comment for why
  /// a date-only start/end pair cannot express it.
  TIME_SLIP
  /// The patient's consent, recorded. What it holds is THEIR agreement, not
  /// the doctor's judgement, which is why it does not require clinical
  /// authorisation either.
  CONSENT
  // Document builder (D-040) — a document generated from a
  // CustomDocumentTemplate; Document.title carries its display name.
  CUSTOM
}

// Document builder (D-040) — a clinic's own document templates: the copies
// of platform defaults deployed at tenant creation (sourceDefault kept for
// provenance) plus any the clinic writes itself. Content is plain text
// with {{merge.field}} placeholders resolved client-side at generate time
// (same client-side convention as the Phase A4 hardcoded builders these
// replace).
model CustomDocumentTemplate {
  id                            String   @id @default(uuid())
  tenantId                      String   @map("tenant_id")
  name                          String
  content                       String
  active                        Boolean  @default(true)
  // G3b closure (D-064) — does a document made from this template carry a
  // doctor's clinical opinion?
  //
  // Defaults to TRUE, deliberately: an unclassified template is treated as
  // clinical until a clinic says otherwise. The alternative — inferring from
  // the template's name or text — is exactly what the closure forbids, and
  // getting it wrong the other way lets front desk authorise a referral.
  // Marking a template administrative is an explicit administrative act.
  requiresClinicalAuthorisation Boolean  @default(true) @map("requires_clinical_authorisation")
  // The DefaultDocumentTemplate this was copied from at tenant creation —
  // informational only; edits never sync back or forward (D-037's
  // no-retro-sync rule).
  sourceDefaultId               String?  @map("source_default_id")
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("custom_document_templates")
}

// Platform console (D-037/D-040) — the "Default Document Templates" the
// owner curates once; copied into each new tenant. No RLS, like the other
// default catalogs.
model DefaultDocumentTemplate {
  id        String   @id @default(uuid())
  name      String
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("default_document_templates")
}

// Clinical Operations, Phase A4 (owner feedback round 2). Structured
// fields (date range, diagnosis, issuing doctor, issued date, referred-to
// department) back a client-side generated starter template per type —
// still no server-side PDF rendering, `content` remains the single
// editable source of truth the doctor/staff can adjust before saving.
// issuedByStaffId is a real doctor picker now (not silently defaulted) —
// per the owner's clinical flow, invoices/documents must be
// staff-creatable for locum coverage, so the issuing doctor is whoever
// the form says, defaulting to the visit's attending physician only as a
// convenience starting value.
// G3a (D-062) — a saved clinical document is never deleted. Voiding is a
// correction that leaves the original content, issuer and signature intact.
enum DocumentRecordStatus {
  ACTIVE
  VOIDED
}

/// G3b closure (D-064) — WHAT KIND of sign-off a document actually carries.
///
/// `signedAt` alone cannot answer this. It was written by a route that let
/// any reachable user sign, so a historical row proves only that *somebody*
/// signed something off — not that a doctor accepted clinical responsibility.
/// Presenting all of those as "Signed" is the defect this closure fixes.
enum DocumentAuthorisationKind {
  /// A doctor (or an active MEDICAL_DOCTOR professional identity) accepted
  /// clinical responsibility. Only ever written by the authorise route.
  CLINICAL
  /// An administrative document issued by permitted staff. Carries no
  /// clinical opinion and never claims a doctor's authority.
  ADMINISTRATIVE
  /// Pre-closure rows: an operational sign-off whose authority was never
  /// recorded. Shown as "Legacy sign-off — authorisation type not recorded",
  /// never as a doctor's authorisation. Never written by new code.
  LEGACY_SIGN_OFF
}

// G3a (D-062) — shared by visit attachments and order/procedure attachments.
// The underlying FILE is never unlinked by an audited removal; only its
// status changes, so an authorised history request can still retrieve it.
enum AttachmentRecordStatus {
  ACTIVE
  REMOVED_IN_ERROR
}

// b0 — the three kinds of file a consultation actually accumulates, per the
// approved canvas (PDF p.2). Deliberately three and not a free-text label:
// the tag is a filing decision the whole team reads the same way, and an open
// vocabulary would produce "photo", "Photo", "pic" and "wound" in one clinic.
enum VisitAttachmentCategory {
  PHOTO
  LAB
  LETTER
}

model Document {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  visitId         String       @map("visit_id")
  type            DocumentType
  // Display name for CUSTOM documents (the template's name at generate
  // time) — null for the four built-in types, which label themselves.
  title           String?
  content         String
  issuedByStaffId String       @map("issued_by_staff_id")
  issuedDate      DateTime     @default(now()) @map("issued_date") @db.Date
  startDate       DateTime?    @map("start_date") @db.Date
  endDate         DateTime?    @map("end_date") @db.Date
  /// Hours attended, for a TIME_SLIP only. start/end are date-only — an MC
  /// covers whole days — so a duration needs a column of its own rather than
  /// a time component nobody could trust.
  hours           Float?
  diagnosisText   String?      @map("diagnosis_text")
  referredTo      String?      @map("referred_to")
  // The moment a document was signed off. G3b made this one-way (re-signing
  // is a 409); the G3b CLOSURE gave it meaning, because on its own it never
  // said WHO was entitled to sign or what the signature claimed.
  //
  // Kept rather than renamed: the column is referenced across the dispensary
  // workflow, and renaming it would be churn without changing behaviour. The
  // authorisation fields below carry the semantics. Recorded as technical
  // debt in D-064.
  signedAt        DateTime?    @map("signed_at")
  signedByStaffId String?      @map("signed_by_staff_id")

  // G3b closure (D-064) — is this a document that carries a doctor's clinical
  // opinion? Snapshotted AT CREATION from the type (or the template's own
  // setting for CUSTOM), so that editing a template later can never change
  // what an already-issued document required.
  requiresClinicalAuthorisation Boolean @default(true) @map("requires_clinical_authorisation")

  // What the sign-off actually was, plus frozen identity of whoever gave it.
  // Snapshots, not joins: a doctor who leaves the clinic must not turn a
  // year-old authorisation into a blank.
  authorisationKind               DocumentAuthorisationKind? @map("authorisation_kind")
  authorisedByNameSnapshot        String?                    @map("authorised_by_name_snapshot")
  authorisedByRoleSnapshot        String?                    @map("authorised_by_role_snapshot")
  authorisedByDesignationSnapshot String?                    @map("authorised_by_designation_snapshot")
  createdAt                       DateTime                   @default(now()) @map("created_at")
  updatedAt                       DateTime                   @updatedAt @map("updated_at")

  // G3a (D-062) — voiding is a correction, not a delete. content, issuedBy,
  // signedAt/signedBy and every other field survive untouched.
  recordStatus         DocumentRecordStatus @default(ACTIVE) @map("record_status")
  voidedAt             DateTime?            @map("voided_at")
  voidedByStaffId      String?              @map("voided_by_staff_id")
  voidedByNameSnapshot String?              @map("voided_by_name_snapshot")
  voidedByRoleSnapshot String?              @map("voided_by_role_snapshot")
  voidReason           String?              @map("void_reason")
  version              Int                  @default(1)

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  visit    Visit  @relation(fields: [visitId], references: [id])
  issuedBy Staff  @relation("DocumentIssuedBy", fields: [issuedByStaffId], references: [id])
  signedBy Staff? @relation("DocumentSignedBy", fields: [signedByStaffId], references: [id])
  voidedBy Staff? @relation("DocumentVoidedBy", fields: [voidedByStaffId], references: [id])

  @@index([tenantId, visitId])
  @@map("documents")
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

// Clinical Operations, Phase A5. Invoice creation is deliberately
// staff-creatable — not gated to the visit's own attending doctor — so a
// locum covering someone else's queue can still bill the visit
// (docs/DECISIONS.md D-017: no real auth/user-identity yet, so this is
// simply "no ownership check", not a role-based grant). Marking an
// invoice PAID is Phase A6's job (dispensary/payment step); this phase
// only creates the bill and its line items.
model Invoice {
  id                          String        @id @default(uuid())
  tenantId                    String        @map("tenant_id")
  visitId                     String        @map("visit_id")
  // Count-based sequence ("INV-000002"), same accepted non-atomic-race gap
  // as Visit.visitNumber.
  invoiceNumber               String        @map("invoice_number")
  status                      InvoiceStatus @default(UNPAID)
  totalAmount                 Decimal       @default(0) @map("total_amount") @db.Decimal(10, 2)
  createdByStaffId            String        @map("created_by_staff_id")
  cancelReason                String?       @map("cancel_reason")
  // Dispensary payment step (Phase A6) — paymentMethod is free text (same
  // convention as Visit.billingType) rather than a DB enum, since the
  // frontend's fixed option list can grow without a migration.
  paidAt                      DateTime?     @map("paid_at")
  paymentMethod               String?       @map("payment_method")
  // Phase 1e — computed and snapshotted server-side by InvoiceService#pay
  // (never trusted from the client, never live-recomputed after payment):
  // panelCoveredAmount is what the panel company owes the clinic for this
  // visit (0 for a self-pay invoice); patientPaidAmount is what the
  // patient actually paid at pay-time (the full total for self-pay, the
  // copay for a panel visit, or 0 for "Mark Fully Covered by Panel"). This
  // is the one place the Panel-Covers/Patient-Copay split becomes a fact
  // instead of a live UI computation — ClaimBatchLine.claimedAmount reads
  // panelCoveredAmount, so a later change to the panel's limit/exclusions
  // can never retroactively alter what's already been claimed.
  panelCoveredAmount          Decimal       @default(0) @map("panel_covered_amount") @db.Decimal(10, 2)
  patientPaidAmount           Decimal       @default(0) @map("patient_paid_amount") @db.Decimal(10, 2)
  /**
   * G4.5d3c-1b (D-084) — what the patient (or their responsible party) OWES,
   * as distinct from what has been RECEIVED.
   * `patientPaidAmount` is money already collected, and it is only computed
   * at pay time. That left no way to ask "does this patient still need to go
   * to the payment counter" before payment: a fully panel-covered invoice sits
   * at UNPAID with patientPaidAmount 0, exactly like a cash invoice nobody has
   * paid yet. This field is the difference between those two.
   * Invariant for newly calculated invoices:
   * panelCoveredAmount + patientResponsibilityAmount = totalAmount
   * Remaining patient-facing work:
   * max(patientResponsibilityAmount - patientPaidAmount, 0)
   * Nullable with no default and no backfill. NULL means payment
   * responsibility was not captured, and a destination rule must report it as
   * UNDETERMINED rather than guess. `Invoice.status = UNPAID` must never be
   * the sole test for whether the patient owes anything.
   */
  patientResponsibilityAmount Decimal?      @map("patient_responsibility_amount") @db.Decimal(10, 2)

  // G4.5d3c-3b1 (D-093) — the panel-side twin, written by the same engine in
  // the same transaction. Invariant once computed:
  //   panelResponsibilityAmount + patientResponsibilityAmount = totalAmount
  panelResponsibilityAmount Decimal?             @map("panel_responsibility_amount") @db.Decimal(10, 2)
  // Sum of active line amounts BEFORE any discount. totalAmount remains the
  // grand total after line and overall discounts.
  subtotalAmount            Decimal?             @map("subtotal_amount") @db.Decimal(10, 2)
  // Overall invoice discount (owner policy v1: AFTER_PANEL_SPLIT_PATIENT_ONLY
  // — reduces only the patient-responsible portion; the panel's contractual
  // receivable is never silently discounted).
  invoiceDiscountType       InvoiceDiscountType? @map("invoice_discount_type")
  invoiceDiscountValue      Decimal?             @map("invoice_discount_value") @db.Decimal(10, 2)
  invoiceDiscountAmount     Decimal?             @map("invoice_discount_amount") @db.Decimal(10, 2)
  invoiceDiscountReason     String?              @map("invoice_discount_reason")
  invoiceDiscountByStaffId  String?              @map("invoice_discount_by_staff_id")
  invoiceDiscountAt         DateTime?            @map("invoice_discount_at")
  /// WAVE 1 — service tax carried on the invoice as its own number, summed
  /// from the lines. `totalAmount` INCLUDES it. Both stay 0 for a clinic that
  /// is not tax-registered, which is every clinic until a TaxCode is mapped,
  /// so nothing about an existing invoice changes by this field existing.
  taxAmount                 Decimal              @default(0) @map("tax_amount") @db.Decimal(10, 2)
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  visit               Visit               @relation(fields: [visitId], references: [id])
  createdBy           Staff               @relation(fields: [createdByStaffId], references: [id])
  lines               InvoiceLine[]
  staffBenefitUsages  StaffBenefitUsage[]
  claimBatchLines     ClaimBatchLine[]
  /// Bookings whose deposit was applied to this invoice, so a deposit taken at
  /// booking is reconciled against the clinic bill rather than counted twice.
  payments            Payment[]
  creditNotes         CreditNote[]
  depositAppointments Appointment[]       @relation("AppointmentDepositInvoice")

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, visitId])
  @@map("invoices")
}

// D-041 — how a panel's per-claim fee is expressed: % of the claimed
// amount, or a flat RM value per claim.
enum PanelClaimFeeType {
  PERCENT
  AMOUNT
}

/// HOW A PANEL'S ADMIN FEE IS TREATED IN THE RECEIVABLE.
///
/// **D-041 is superseded on this point** (owner decision, 2026-08-31). D-041
/// recorded `receivable = claimed + fee`. The clinic's own claim workbook and
/// its bank credits say otherwise, and the owner has accepted that evidence as
/// the source of truth for the current panel setup:
///
///   - all 29 workbook sheets compute `CLAIM TO RECEIVE = CLAIMED - FEE`
///   - 2,615 of 2,640 paid fee-bearing claims banked at exactly claimed - fee
///   - 2 banked at the claimed amount, both investigated (below)
///   - **none** banked at claimed + fee
///
/// The two exceptions were investigated rather than averaged away. One is a
/// single claim inside a remittance that settled three OTHER claims the same
/// day WITH the fee deducted - a manual exception on one row, not a second
/// rule. The other is the only paid fee-bearing claim on its panel, which is
/// why that panel alone is UNCONFIGURED and flagged for owner review.
///
/// The architecture stays per-panel and effective-dated (`PanelFeeTerm`),
/// because a future contract may genuinely differ.
enum PanelFeeTreatment {
  /// `expected = claimed - fee`. The panel keeps its fee out of what it pays.
  /// The default for every existing panel, per the owner's 2026-08-31 decision.
  WITHHELD_FROM_CLAIM
  /// `expected = claimed + fee`. The clinic bills claim + fee and expects all
  /// of it back. Retained because a future contract may work this way.
  ADDED_TO_RECEIVABLE
  /// This panel charges no fee. `expected = claimed`, and there is no sign to
  /// get wrong - distinct from UNCONFIGURED, which means nobody knows.
  NO_FEE
  /// The rule genuinely cannot be established from evidence. The fee is applied
  /// in NEITHER direction and the balance is marked unresolved, so a screen
  /// says so rather than presenting guessed arithmetic. Never a resting state:
  /// it exists to be reported and answered.
  UNCONFIGURED
}

enum PanelTermUnit {
  CALENDAR_DAYS
  WORKING_DAYS
}

/// What the payment clock starts from. Most panels count from when the claim
/// was sent; two in the workbook count from the INVOICE date, which for a
/// monthly-invoiced panel can be four weeks after the service.
enum PanelTermAnchor {
  SERVICE_DATE
  SUBMISSION_DATE
  INVOICE_DATE
}

enum ClaimBatchStatus {
  BATCHED
  SUBMITTED
  PARTIALLY_PAID
  PAID
  RECONCILED
}

enum ClaimLineStatus {
  PENDING
  ACCEPTED
  REJECTED
  DEDUCTED
  PAID
}

// Phase 1e (Panel Claims Core). No panel in the owner's description has a
// real API Kuwick submits to — every path (AIA's own portal, MARA's
// courier, others' own portals) ends in a human acting outside Kuwick
// (D-031). So there's one status lifecycle for every panel
// (`PRODUCT_REQUIREMENTS.md` §7): batch creation has no fixed period —
// staff pick whichever unclaimed PAID panel invoices they want, whenever
// they want (AIA's near-daily aggregation and another panel's monthly
// cycle are just different staff habits against the same feature) — and
// "Submitted" records a method (Portal/Courier/Email/Other) rather than
// branching into different code per panel.
model ClaimBatch {
  id                  String           @id @default(uuid())
  tenantId            String           @map("tenant_id")
  panelClinicId       String           @map("panel_clinic_id")
  // Count-based sequence ("CLAIM-000002"), same accepted non-atomic-race
  // gap as Visit.visitNumber/Invoice.invoiceNumber.
  batchNumber         String           @map("batch_number")
  status              ClaimBatchStatus @default(BATCHED)
  submissionMethod    String?          @map("submission_method")
  submissionReference String?          @map("submission_reference")
  submittedAt         DateTime?        @map("submitted_at")
  reconciledAt        DateTime?        @map("reconciled_at")
  createdByStaffId    String           @map("created_by_staff_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  panelClinic PanelClinic      @relation(fields: [panelClinicId], references: [id])
  createdBy   Staff            @relation(fields: [createdByStaffId], references: [id])
  lines       ClaimBatchLine[]

  @@unique([tenantId, batchNumber])
  @@index([tenantId, panelClinicId])
  @@map("claim_batches")
}

// One row per invoice ever claimed — @@unique([tenantId, invoiceId])
// prevents the same invoice being pulled into a second batch. claimedAmount
// snapshots Invoice.panelCoveredAmount at batch-creation time (the batch
// total must stay fixed even if the invoice is somehow altered later);
// paidAmount/status/deductionReason are recorded per line, not just per
// batch, since a single batch commonly has some lines accepted-and-paid
// and others rejected/deducted.
// Panel workbook upgrade (D-041): invoiceId is no longer unique — the
// owner's real excess/rejected workflow re-claims the same invoice in a
// *new* claim ("buat claim baru untuk excess claim"), so an invoice may
// have multiple lines over time. ClaimBatchService guards that only one
// line can be ACTIVE (not REJECTED/DEDUCTED) at a time. feeAmount is the
// panel's add-on fee per claim ("claim RM100 → claimed RM108");
// receivable = claimedAmount + feeAmount.
model ClaimBatchLine {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  claimBatchId    String            @map("claim_batch_id")
  invoiceId       String            @map("invoice_id")
  claimedAmount   Decimal           @map("claimed_amount") @db.Decimal(10, 2)
  feeAmount       Decimal           @default(0) @map("fee_amount") @db.Decimal(10, 2)
  status          ClaimLineStatus   @default(PENDING)
  /// HOW THIS CLAIM'S FEE IS TREATED, snapshotted from the panel's fee term in
  /// force on the day the claim was raised — the same convention as
  /// `claimedAmount` and `feeAmount`. A contract change next year must never
  /// rewrite the arithmetic of a claim already sent and argued about; that is
  /// what makes the effective-dated `PanelFeeTerm` history safe to edit.
  ///
  /// A claim still sitting in BATCHED is re-stamped when the treatment changes,
  /// because a claim nobody has sent yet should carry the corrected fact.
  feeTreatment    PanelFeeTreatment @default(UNCONFIGURED) @map("fee_treatment")
  paidAmount      Decimal?          @map("paid_amount") @db.Decimal(10, 2)
  deductionReason String?           @map("deduction_reason")
  remarks         String?

  // WAVE 3 — the lifecycle and the money, kept apart.
  //
  // `ClaimLineStatus` (PENDING/ACCEPTED/REJECTED/DEDUCTED/PAID) stays exactly
  // as it is, because existing code reads it. `claimStatus` is the richer
  // lifecycle the workspace drives, and the two are kept in step by
  // ClaimWorkspaceService — one writer, so they cannot disagree.
  claimStatus PanelClaimStatus @default(BATCHED) @map("claim_status")

  /// The panel's own claim number, as keyed into their portal. This is the
  /// reference an argument six months later is conducted in.
  panelClaimNo        String?                 @map("panel_claim_no")
  /// When the claim was actually sent. Distinct from the batch's date: a claim
  /// can be pulled from a batch, re-keyed and sent a day later.
  submittedAt         DateTime?               @map("submitted_at")
  acknowledgedAt      DateTime?               @map("acknowledged_at")
  /// When the panel told us what they would pay.
  adjudicatedAt       DateTime?               @map("adjudicated_at")
  /// What the panel agreed to pay. NULL means they have not said — which is
  /// NOT zero, and the receivable calculation depends on the difference
  /// (see finance/financial-invariants.computeClaimBalance).
  approvedAmount      Decimal?                @map("approved_amount") @db.Decimal(10, 2)
  /// What they refused.
  rejectedAmount      Decimal?                @map("rejected_amount") @db.Decimal(10, 2)
  rejectionReason     String?                 @map("rejection_reason")
  /// The countable half of the reason above (G-6). NULL on a claim rejected
  /// before this existed, or where nobody chose one — which is itself worth
  /// seeing on a report, so it is not defaulted to OTHER.
  rejectionCategory   ClaimRejectionCategory? @map("rejection_category")
  /// Abandoned as uncollectable, with a reason and an actor.
  writtenOffAmount    Decimal?                @map("written_off_amount") @db.Decimal(10, 2)
  writtenOffAt        DateTime?               @map("written_off_at")
  writtenOffByStaffId String?                 @map("written_off_by_staff_id")
  writeOffReason      String?                 @map("write_off_reason")

  /// CHARGED TO THE PATIENT INSTEAD (G-5).
  ///
  /// One of the four routes out of a rejection in the clinic's own excess
  /// register, and the one no system usually models: the panel will not pay, so
  /// the patient does. In the spreadsheet it is the word "SELF PAY" typed into
  /// a column meant for dates, followed weeks later by a payment method and a
  /// date in another column.
  ///
  /// This is NOT a write-off. A write-off says the money is gone; this says the
  /// money is still coming, from somebody else. It is recorded here as a
  /// resolution of the claim, and the actual receivable moves onto the invoice
  /// where every other patient balance lives — so the patient is chased through
  /// `computePatientBalance` like anyone else, not through a panel report.
  chargedToPatientAmount    Decimal?  @map("charged_to_patient_amount") @db.Decimal(10, 2)
  chargedToPatientAt        DateTime? @map("charged_to_patient_at")
  chargedToPatientByStaffId String?   @map("charged_to_patient_by_staff_id")

  /// THE EXCESS/RESUBMISSION CHAIN. The owner's real workflow: a rejected
  /// claim is re-claimed under a NEW claim, and the two are linked so the
  /// original is not chased twice and the replacement is not counted as new
  /// revenue.
  supersedesLineId String? @map("supersedes_line_id")

  /// The work-item fields the Google Sheet carries today.
  dueDate            DateTime? @map("due_date") @db.Date
  responsibleStaffId String?   @map("responsible_staff_id")
  resolvedAt         DateTime? @map("resolved_at")
  resolutionNote     String?   @map("resolution_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant                      @relation(fields: [tenantId], references: [id])
  claimBatch         ClaimBatch                  @relation(fields: [claimBatchId], references: [id])
  invoice            Invoice                     @relation(fields: [invoiceId], references: [id])
  supersedes         ClaimBatchLine?             @relation("ClaimSupersession", fields: [supersedesLineId], references: [id])
  supersededBy       ClaimBatchLine[]            @relation("ClaimSupersession")
  responsible        Staff?                      @relation("ClaimResponsibleStaff", fields: [responsibleStaffId], references: [id])
  writtenOffBy       Staff?                      @relation("ClaimWrittenOffBy", fields: [writtenOffByStaffId], references: [id])
  chargedToPatientBy Staff?                      @relation("ClaimChargedToPatientBy", fields: [chargedToPatientByStaffId], references: [id])
  allocations        PanelRemittanceAllocation[]
  events             ClaimEvent[]

  @@index([tenantId, claimBatchId])
  @@index([tenantId, invoiceId])
  @@map("claim_batch_lines")
}

// Snapshots description/unitPrice/amount at add-time (same historical-
// stability convention as OrderService/Diagnosis catalog snapshots) —
// never a live reference to ServiceCatalog/Item pricing, so a later price
// change never silently alters an already-issued invoice.
//
// Phase A8: sourceOrderServiceId/sourcePrescriptionId are set when a line
// was Quick-Added from a completed service/dispensed medication (nullable
// — a line can still be typed freehand via AddLineForm), so the Quick-Add
// UI can tell which services/medications are already billed. excludedFromPanel
// is stamped server-side at add-time from PanelExclusion — always
// patient-payable, on top of the panel's per-visit limit rather than
// netted against it.
model InvoiceLine {
  id                          String   @id @default(uuid())
  tenantId                    String   @map("tenant_id")
  invoiceId                   String   @map("invoice_id")
  description                 String
  quantity                    Int      @default(1)
  unitPrice                   Decimal  @map("unit_price") @db.Decimal(10, 2)
  amount                      Decimal  @db.Decimal(10, 2)
  sourceOrderServiceId        String?  @map("source_order_service_id")
  sourcePrescriptionId        String?  @map("source_prescription_id")
  // G4.5d3c-3b2 (D-094) — the consultation charge's source link. The source
  // IS the visit's consultation (no order row exists for consulting), so the
  // visit id doubles as the duplicate-protection key: one ACTIVE consultation
  // line per visit. The rule that selected the service is kept so the charge
  // can always answer "which tariff produced this".
  sourceConsultationVisitId   String?  @map("source_consultation_visit_id")
  consultationTariffRuleId    String?  @map("consultation_tariff_rule_id")
  excludedFromPanel           Boolean  @default(false) @map("excluded_from_panel")
  // G4.5d3c-3b1a (D-092) — this LINE's share of the split, so patient
  // responsibility is explainable item by item instead of only as a visit
  // total. Nullable: NULL means the engine (3b1b) has not computed it, which
  // is reported as unresolved, never as zero. Invariant once computed:
  //   panelResponsibilityAmount + patientResponsibilityAmount = amount
  panelResponsibilityAmount   Decimal? @map("panel_responsibility_amount") @db.Decimal(10, 2)
  patientResponsibilityAmount Decimal? @map("patient_responsibility_amount") @db.Decimal(10, 2)
  // Why the line was excluded, snapshotted at exclusion time — the panel's
  // exclusion list can change later without rewriting this line's history.
  panelExclusionReason        String?  @map("panel_exclusion_reason")

  // G4.5d3c-3b1 (D-093) — internal pricing provenance. How unitPrice was
  // produced, for audit/management surfaces ONLY: never rendered on the
  // standard patient- or panel-facing invoice.
  unit              String?
  priceRule         InvoiceLinePriceRule? @map("price_rule")
  baseUnitPrice     Decimal?              @map("base_unit_price") @db.Decimal(10, 2)
  panelMarkupAmount Decimal?              @map("panel_markup_amount") @db.Decimal(10, 2)

  // Line-level discount, retained in full: type, value, computed amount,
  // mandatory reason, actor, timestamp. `amount` stays the PRE-discount
  // quantity × unitPrice; the discounted line total is amount − discount.
  lineDiscountType      InvoiceDiscountType? @map("line_discount_type")
  lineDiscountValue     Decimal?             @map("line_discount_value") @db.Decimal(10, 2)
  lineDiscountAmount    Decimal?             @map("line_discount_amount") @db.Decimal(10, 2)
  lineDiscountReason    String?              @map("line_discount_reason")
  lineDiscountByStaffId String?              @map("line_discount_by_staff_id")
  lineDiscountAt        DateTime?            @map("line_discount_at")

  // Auditable cancellation — a removed charge is a historical fact, not a
  // deleted row. Cancelled lines leave every total and worklist; the record
  // of who removed what, when and why survives.
  // WAVE 1 — tax is decided PER LINE, then summed. A clinic bills exempt
  // medicines and standard-rated procedures on the same invoice, so an
  // invoice-level rate would be wrong on one of them. The rate is SNAPSHOTTED
  // here at add-time from the rate in force on that date: a later rate change
  // is a new rate row, never a rewrite of an issued bill.
  taxCodeId          String?       @map("tax_code_id")
  taxTreatment       TaxTreatment? @map("tax_treatment")
  taxRatePercent     Decimal?      @map("tax_rate_percent") @db.Decimal(6, 3)
  taxAmount          Decimal       @default(0) @map("tax_amount") @db.Decimal(10, 2)
  cancelledAt        DateTime?     @map("cancelled_at")
  cancelledByStaffId String?       @map("cancelled_by_staff_id")
  cancelReason       String?       @map("cancel_reason")
  createdAt          DateTime      @default(now()) @map("created_at")

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  invoice                Invoice                 @relation(fields: [invoiceId], references: [id])
  sourceOrderService     OrderService?           @relation(fields: [sourceOrderServiceId], references: [id])
  sourcePrescription     Prescription?           @relation(fields: [sourcePrescriptionId], references: [id])
  consultationVisit      Visit?                  @relation("VisitConsultationChargeLines", fields: [sourceConsultationVisitId], references: [id])
  taxCode                TaxCode?                @relation(fields: [taxCodeId], references: [id])
  creditNoteLines        CreditNoteLine[]
  consultationTariffRule ConsultationTariffRule? @relation(fields: [consultationTariffRuleId], references: [id])

  @@index([tenantId, taxCodeId])
  @@index([tenantId, invoiceId])
  @@map("invoice_lines")
}

enum PrescriptionStatus {
  ORDERED
  DISPENSED
  CANCELLED
}

/**
 * G4.5d3c-1b (D-084) — where the medicine actually comes from.
 * Nothing in the model previously distinguished a script the clinic fills
 * from one the patient takes elsewhere, so the only available rule for "does
 * this patient need to go to the dispensary" was "a Prescription row exists"
 * — which is wrong for an external script, for medicine the patient already
 * has, and for advice with no supply at all. This is the missing input.
 * It describes INTENT at prescribing time. It is not a dispensing status:
 * `PrescriptionStatus` still records what happened.
 */
enum PrescriptionSupplyMode {
  /**
   * The clinic supplies and dispenses it. May require READY_FOR_DISPENSARY.
   */
  ONSITE_DISPENSE
  /**
   * Supplied outside the clinic. No clinic dispensary step.
   */
  EXTERNAL_PRESCRIPTION
  /**
   * The patient already has it. No dispensing.
   */
  PATIENT_OWN_SUPPLY
  /**
   * Supply deliberately left open. NOT dispensed, and NOT resolved — a future
   * completion workflow must treat it as unresolved rather than assuming
   * either way.
   */
  DEFERRED
  /**
   * A medication/advice record needing no supply at all.
   */
  NO_SUPPLY_REQUIRED
}

// Weight-based vs. age-based dosage calculator method used, if any —
// audit trail only (docs/DECISIONS.md D-028); doesn't drive behaviour.
enum DosageCalcMethod {
  WEIGHT_BASED
  AGE_BASED
  MANUAL
}

// Clinical Operations, Phase 3. Snapshots dose/unit/frequency/duration/
// indication from Item at prescribe-time (same historical-stability
// convention as Diagnosis/OrderService), so a later Item edit never
// rewrites a historical prescription. No hard delete
// (docs/DATABASE_ARCHITECTURE.md §1) — `remove()` sets deletedAt instead,
// only while still ORDERED.
model Prescription {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  visitId  String @map("visit_id")
  itemId   String @map("item_id")

  // THE CLINICAL QUANTITY — DOSE UNITS, NOT STOCK UNITS.
  //
  // What the doctor wrote: 30 tablets. The form computes it as
  // dose x doses-per-day x days (`computeQuantity`), and for PRN and STAT,
  // where there is no doses-per-day, a person types it — still in dose units.
  //
  // It is NOT what leaves the shelf. Stock moves in strips and boxes, and the
  // conversion is `ceil(quantity / divisor)` in `dispense-pricing.ts`. This
  // comment used to say "stock units", and both dispensing paths believed it:
  // a 30-tablet course deducted 30 strips.
  quantity Int @default(1)

  // "Dosage Instructions" — the per-dose amount (e.g. 1.64 mL), distinct
  // from quantity (the whole course).
  amount       Decimal @db.Decimal(10, 2)
  unit         String?
  frequency    String
  durationDays Int     @map("duration_days")
  indication   String?
  remark       String?

  // b1 PHASE A — what the LABEL has to say, SNAPSHOT at prescribing time.
  //
  // Deliberately not foreign keys into the reference catalogues. A prescription
  // is a statement about what a named person was told to take on a named day;
  // if it pointed at a catalogue row, correcting that row's Malay label would
  // silently rewrite every prescription ever written, including ones already in
  // a patient's hand. The catalogues decide what a NEW prescription opens with
  // and have no authority over one already written.
  //
  // All nullable, permanently: rows written before this captured no Malay
  // label, and the renderer omits what is absent rather than inventing it.
  doseUnitBm               String?       @map("dose_unit_bm")
  frequencyBm              String?       @map("frequency_bm")
  /// How the course was WRITTEN ("2 WEEK"); `durationDays` stays the canonical
  /// computed figure that every existing reader uses.
  durationValue            Int?          @map("duration_value")
  durationUnit             DurationUnit? @map("duration_unit")
  consumptionMethod        String?       @map("consumption_method")
  consumptionInstructionBm String?       @map("consumption_instruction_bm")
  indicationBm             String?       @map("indication_bm")

  // Calculator audit trail (docs/DECISIONS.md D-028) — nullable, populated
  // only when the doctor used Calculate Dosage rather than typing amount
  // directly.
  calcMethod       DosageCalcMethod? @map("calc_method")
  calcWeightKg     Decimal?          @map("calc_weight_kg") @db.Decimal(6, 2)
  calcDoseRateMgKg Decimal?          @map("calc_dose_rate_mg_kg") @db.Decimal(6, 2)
  calcTargetDoseMg Decimal?          @map("calc_target_dose_mg") @db.Decimal(10, 2)

  // KW2-C2 — Copy Rx provenance. `sourceVisitId` is the visit this row was
  // carried over from; `reviewFlag` says it has not been re-read against
  // today's weight, allergies and stock. The flag never blocks dispensing —
  // it makes Complete Consultation ask.
  sourceVisitId       String?                 @map("source_visit_id")
  reviewFlag          Boolean                 @default(false) @map("review_flag")
  // Who said it had been re-read, and when. Populated by the explicit
  // "reviewed" act AND by any edit of the row — editing a carried-over
  // medication IS reviewing it, and the editor is the reviewer.
  reviewedByStaffId   String?                 @map("reviewed_by_staff_id")
  reviewedAt          DateTime?               @map("reviewed_at")
  status              PrescriptionStatus      @default(ORDERED)
  // G4.5d3c-3b1 (D-093) — who actually handed the medication over. Distinct
  // from the prescriber; stamped by the atomic dispense claim.
  dispensedByStaffId  String?                 @map("dispensed_by_staff_id")
  /**
   * G4.5d3c-1b (D-084) — nullable, with NO database default, deliberately.
   * A default would make every row written during the compatibility period
   * indistinguishable from one where a prescriber actually chose. NULL means
   * supply mode was not captured, and a destination rule must treat it as
   * undetermined rather than assume ONSITE.
   */
  supplyMode          PrescriptionSupplyMode? @map("supply_mode")
  prescribedByStaffId String                  @map("prescribed_by_staff_id")
  prescribedAt        DateTime                @default(now()) @map("prescribed_at")
  dispensedAt         DateTime?               @map("dispensed_at")
  cancelReason        String?                 @map("cancel_reason")
  deletedAt           DateTime?               @map("deleted_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  visit        Visit         @relation(fields: [visitId], references: [id])
  sourceVisit  Visit?        @relation("PrescriptionCopySource", fields: [sourceVisitId], references: [id], onDelete: SetNull)
  item         Item          @relation(fields: [itemId], references: [id])
  prescribedBy Staff         @relation(fields: [prescribedByStaffId], references: [id])
  reviewedBy   Staff?        @relation("PrescriptionReviewer", fields: [reviewedByStaffId], references: [id], onDelete: Restrict)
  invoiceLines InvoiceLine[]
  labelPrints  LabelPrint[]

  @@index([tenantId, visitId])
  @@map("prescriptions")
}

/// G4.5d5b-2 — the audit trail for a printed medication label.
///
/// Printing a drug label was entirely client-side: `printTextDocument.ts`
/// assembled it in the browser from whatever the page happened to be holding,
/// and no record survived. Two consequences the clinic actually cares about —
/// nobody could answer "was this label ever printed, and by whom", and a label
/// could be generated from values the browser supplied rather than from the
/// prescription.
///
/// Deliberately SMALL. It records the act of printing, not a second copy of
/// the patient's medication: the label content is re-assembled from the live
/// Prescription/Visit/Patient/Clinic records every time, so this table can
/// never drift from the clinical record or become an uncontrolled duplicate of
/// it. What is stored is who, when, how many copies and which format.
///
/// Printing is NOT dispensing. Nothing here moves stock, changes prescription
/// status, touches the queue or touches an invoice.
model LabelPrint {
  id             String @id @default(uuid())
  tenantId       String @map("tenant_id")
  clinicId       String @map("clinic_id")
  prescriptionId String @map("prescription_id")

  printedByStaffId    String   @map("printed_by_staff_id")
  /// Snapshotted for the same reason clinical authorship is: a staff record
  /// can be renamed or deactivated, and the audit must still say who printed.
  printerNameSnapshot String   @map("printer_name_snapshot")
  printedAt           DateTime @default(now()) @map("printed_at")

  /// 1–3, enforced by the service. A label sheet is a physical thing.
  copies Int @default(1)

  /// Sequence within this prescription: 1 is the first print, anything above
  /// it is a reprint. A boolean would lose how many times.
  printSequence Int     @map("print_sequence")
  isReprint     Boolean @default(false) @map("is_reprint")

  /// Which physical preset was used, so a label printed at one size can be
  /// told from one printed at another after the preset changes.
  labelFormat String @default("KUWICK_STD_70x40") @map("label_format")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  clinic       Clinic       @relation(fields: [clinicId], references: [id])
  prescription Prescription @relation(fields: [prescriptionId], references: [id])
  printedBy    Staff        @relation(fields: [printedByStaffId], references: [id])

  @@index([tenantId, prescriptionId])
  @@index([tenantId, clinicId, printedAt])
  @@map("label_prints")
}

// ===========================================================================
// APPOINTMENTS & SCHEDULING — the roster, the log, and everything the public
// booking page needs. Added by the Appointment & Scheduling redesign.
// ===========================================================================

/// ONE SHIFT A PROVIDER ACTUALLY WORKS, as two instants.
///
/// This replaces the weekday + start-time + end-time representation for
/// ROSTER_LINKED providers, and it exists because that representation cannot
/// express three things a real clinic has:
///
///   1. AN OVERNIGHT SHIFT. 23:00 → 09:00 gave `end < start`, and the slot
///      loop `cursor + duration <= window.end` then ran zero times. A night
///      doctor was silently unbookable — no error, no empty state, just no
///      slots. Instants cross midnight, month ends and DST without a special
///      case, because they are moments and not times of day.
///   2. TWO SHIFTS IN ONE DAY. 08:00-15:00 and 20:00-23:00 is one provider,
///      one date, two rows. `ScheduleException` was `@@unique(... date)` and
///      could hold exactly one window.
///   3. WHY somebody is not there. OFF, LEAVE, BLOCKED and LOCUM are recorded
///      as shifts rather than as absences of shifts, so the monthly matrix can
///      say "Leave" instead of leaving a cell blank and meaning four things.
///
/// `shiftDate` is the CLINIC-LOCAL date the shift belongs to — the date it
/// STARTS. A 23:00 Wednesday shift ending 09:00 Thursday is Wednesday's, which
/// is how a roster is read aloud and how it is paid.
model ProviderShift {
  id        String            @id @default(uuid())
  tenantId  String            @map("tenant_id")
  clinicId  String            @map("clinic_id")
  staffId   String            @map("staff_id")
  shiftDate DateTime          @map("shift_date") @db.Date
  /// Instants. `endsAt` may fall on the following day; that is the point.
  startsAt  DateTime          @map("starts_at")
  endsAt    DateTime          @map("ends_at")
  shiftType ProviderShiftType @default(WORKING) @map("shift_type")

  /// §19 — appointment availability defaults to the roster, and may be
  /// NARROWER than it. A doctor working 09:00-17:00 who takes bookings only
  /// 09:00-12:00 sets these two; everything else in the shift is still worked,
  /// just not bookable. NULL on both = the whole shift is bookable.
  bookableStartsAt DateTime? @map("bookable_starts_at")
  bookableEndsAt   DateTime? @map("bookable_ends_at")

  note             String?
  /// The `DoctorSchedule` row this was generated from, when a weekly pattern
  /// was materialised into a month. Provenance, so a regeneration can tell its
  /// own rows from ones a human typed.
  sourceScheduleId String?  @map("source_schedule_id")
  createdByStaffId String?  @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant         Tenant @relation(fields: [tenantId], references: [id])
  clinic         Clinic @relation(fields: [clinicId], references: [id])
  staff          Staff  @relation("ProviderShiftProvider", fields: [staffId], references: [id])
  createdByStaff Staff? @relation("ProviderShiftAuthor", fields: [createdByStaffId], references: [id])

  @@index([tenantId, clinicId, shiftDate])
  @@index([tenantId, staffId, shiftDate])
  @@index([tenantId, clinicId, startsAt])
  @@map("provider_shifts")
}

/// §18b — WHICH SCHEDULING MODEL governs a provider, effective-dated.
///
/// `Staff.appointmentScheduleMode` is a single value and therefore a single
/// moment: flipping it re-interprets every date at once, and scheduling
/// "weekly from 1 September" was impossible without a background job to flip
/// the flag on the day. This table records mode DECISIONS instead — the mode
/// for any date is the latest period whose `effectiveFrom` is on or before
/// it, resolved by ProviderScheduleModeService (the one resolver everything
/// consumes). A provider with no periods falls back to the legacy column,
/// which nothing writes any more; no backfill was invented, because a
/// fabricated decision date would misrepresent history.
///
/// Past periods are IMMUTABLE at the database (a trigger refuses UPDATE and
/// DELETE once `effectiveFrom` is behind `CURRENT_DATE`); a today-or-future
/// period may still be re-decided or withdrawn, which together with the
/// unique key below keeps the timeline unambiguous without rewriting what
/// already governed real days.
model ProviderScheduleModePeriod {
  id               String               @id @default(uuid())
  tenantId         String               @map("tenant_id")
  clinicId         String               @map("clinic_id")
  staffId          String               @map("staff_id")
  mode             ProviderScheduleMode
  /// The first clinic calendar date this mode governs.
  effectiveFrom    DateTime             @map("effective_from") @db.Date
  createdByStaffId String?              @map("created_by_staff_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  tenant         Tenant @relation(fields: [tenantId], references: [id])
  clinic         Clinic @relation(fields: [clinicId], references: [id])
  staff          Staff  @relation("ScheduleModePeriodProvider", fields: [staffId], references: [id])
  createdByStaff Staff? @relation("ScheduleModePeriodAuthor", fields: [createdByStaffId], references: [id])

  @@unique([tenantId, staffId, effectiveFrom])
  @@index([tenantId, staffId, effectiveFrom(sort: Desc)])
  @@map("provider_schedule_mode_periods")
}

/// APPEND-ONLY. Everything that was done to an appointment, by whom, when and
/// why — the house pattern (`VisitWorkflowEvent`), written inside the same
/// transaction as the change it describes.
///
/// Deliberately ONE table rather than a status-history table plus a separate
/// audit table: "the provider was changed" and "the status became CANCELLED"
/// are the same kind of fact about the same row, and splitting them is how one
/// of the two ends up not being written.
model AppointmentEvent {
  id            String               @id @default(uuid())
  tenantId      String               @map("tenant_id")
  appointmentId String               @map("appointment_id")
  eventType     AppointmentEventType @map("event_type")
  fromStatus    AppointmentStatus?   @map("from_status")
  toStatus      AppointmentStatus?   @map("to_status")
  /// BEFORE and AFTER for anything that is not a status — the old provider,
  /// the old time, the old service. Json so one table can carry all of them
  /// without a column per field.
  beforeValue   Json?                @map("before_value")
  afterValue    Json?                @map("after_value")
  reason        String?
  /// WHERE the action came from — the same vocabulary as the booking source,
  /// so "who moved this" and "who booked this" are answerable the same way.
  source        AppointmentSource?
  actorStaffId  String?              @map("actor_staff_id")
  /// The actor's NAME as it was, snapshotted. A staff member who leaves must
  /// not erase their name from the record of what they did.
  actorLabel    String?              @map("actor_label")
  occurredAt    DateTime             @default(now()) @map("occurred_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor       Staff?      @relation("AppointmentEventActor", fields: [actorStaffId], references: [id])

  @@index([tenantId, appointmentId, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("appointment_events")
}

/// §23 — hours during which a SERVICE may be booked, narrower than the
/// provider's roster. Absence of rows means "whenever the provider is free",
/// which is the normal case and why this is a table rather than columns.
model ServiceBookableHour {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  serviceId String   @map("service_id")
  /// 0 = Sunday, matching `DoctorSchedule.dayOfWeek`.
  dayOfWeek Int      @map("day_of_week")
  startTime DateTime @map("start_time") @db.Time
  endTime   DateTime @map("end_time") @db.Time
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  service ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, serviceId, dayOfWeek])
  @@map("service_bookable_hours")
}

/// §34 — a question the booking page asks. Clinic-wide when `serviceId` is
/// null, service-specific when it is not.
model BookingFormField {
  id        String           @id @default(uuid())
  tenantId  String           @map("tenant_id")
  clinicId  String?          @map("clinic_id")
  serviceId String?          @map("service_id")
  label     String
  helpText  String?          @map("help_text")
  fieldType BookingFieldType @map("field_type")
  required  Boolean          @default(false)
  active    Boolean          @default(true)
  sortOrder Int              @default(0) @map("sort_order")
  /// Choices, for SINGLE_CHOICE and MULTI_CHOICE. Empty otherwise.
  options   String[]         @default([])
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  clinic  Clinic?         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  service ServiceCatalog? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, clinicId])
  @@index([tenantId, serviceId])
  @@map("booking_form_fields")
}

/// §34 — the ANSWERS, snapshotted with the question as it was asked.
///
/// The label and the type are copied rather than joined on purpose: a clinic
/// that rewords "Are you pregnant?" next March must not change what a booking
/// made in February appears to have asked. Same rule as the prescription
/// snapshot and the invoice line.
model AppointmentFormAnswer {
  id            String           @id @default(uuid())
  tenantId      String           @map("tenant_id")
  appointmentId String           @map("appointment_id")
  /// Provenance only — nullable, and never read for the wording.
  fieldId       String?          @map("field_id")
  label         String
  fieldType     BookingFieldType @map("field_type")
  answer        String?
  sortOrder     Int              @default(0) @map("sort_order")
  createdAt     DateTime         @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, appointmentId])
  @@map("appointment_form_answers")
}

/// §37 — what was sent, to whom, through what, and whether it actually left.
///
/// MANUAL is a first-class status, not a lesser one: a receptionist pressing
/// "WhatsApp patient" opens wa.me and sends the message with their own hands.
/// That IS the delivery. Recording it as SENT would claim an integration this
/// system does not have, and recording it as nothing would lose the fact.
model AppointmentCommunication {
  id                String               @id @default(uuid())
  tenantId          String               @map("tenant_id")
  appointmentId     String               @map("appointment_id")
  channel           CommunicationChannel
  /// Which message this was — 'CONFIRMATION', 'REMINDER_24H', 'CANCELLED'.
  template          String
  /// The phone number or address it went to, as it was at the time.
  destination       String?
  status            CommunicationStatus  @default(QUEUED)
  /// The gateway's own id, when there is a gateway.
  providerMessageId String?              @map("provider_message_id")
  error             String?
  queuedAt          DateTime             @default(now()) @map("queued_at")
  sentAt            DateTime?            @map("sent_at")
  failedAt          DateTime?            @map("failed_at")
  /// Who pressed the button, for MANUAL.
  actorStaffId      String?              @map("actor_staff_id")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor       Staff?      @relation("CommunicationActor", fields: [actorStaffId], references: [id])

  @@index([tenantId, appointmentId])
  @@index([tenantId, status, queuedAt])
  @@map("appointment_communications")
}

/// §38 — "remind me 24 hours before, and again 2 hours before". Rows, not two
/// columns: a clinic wanting three reminders, or none, must not need a
/// migration to say so.
model AppointmentReminderRule {
  id            String               @id @default(uuid())
  tenantId      String               @map("tenant_id")
  clinicId      String               @map("clinic_id")
  /// NULL = every bookable service at this branch.
  serviceId     String?              @map("service_id")
  /// MINUTES BEFORE the appointment starts. 1440 = a day.
  offsetMinutes Int                  @map("offset_minutes")
  channel       CommunicationChannel @default(WHATSAPP)
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  clinic  Clinic          @relation(fields: [clinicId], references: [id])
  service ServiceCatalog? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, clinicId])
  @@map("appointment_reminder_rules")
}

/// PHASE 8 — the clinic's own words, one row per customised (type, language).
///
/// A row exists ONLY where a clinic rewrote a template. Every absent pair
/// renders the built-in default (message-template.service), so "reset to
/// default" is a DELETE and improving a default in a later release reaches
/// every clinic that never customised it — without a migration rewriting
/// anybody's own words.
model AppointmentMessageTemplate {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  clinicId    String   @map("clinic_id")
  /// One of the canonical message types (MESSAGE_TEMPLATE_KEYS). A string,
  /// not an enum: adding a message type is content, not a migration.
  templateKey String   @map("template_key")
  /// 'en' or 'ms' — the same convention as ClinicBookingPage.language.
  language    String
  body        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, templateKey, language])
  @@index([tenantId, clinicId])
  @@map("appointment_message_templates")
}

/// §39/§40 — the public booking page for one branch, and the settings that
/// belong to it. One row per clinic, so there is one place these live rather
/// than four technical screens.
model ClinicBookingPage {
  id                         String               @id @default(uuid())
  tenantId                   String               @map("tenant_id")
  clinicId                   String               @unique @map("clinic_id")
  /// The public URL segment: /hijraa-bangi. Unique across the platform,
  /// because the link is public and shared outside any tenant.
  slug                       String               @unique
  displayName                String               @map("display_name")
  logoUrl                    String?              @map("logo_url")
  /// 'en' or 'ms'. Free text rather than an enum so adding a language is
  /// content, not a migration.
  language                   String               @default("en")
  introText                  String?              @map("intro_text")
  /// Which patient details the page insists on. Name is always required and
  /// is therefore not a flag.
  requirePhone               Boolean              @default(true) @map("require_phone")
  requireEmail               Boolean              @default(false) @map("require_email")
  requireNric                Boolean              @default(false) @map("require_nric")
  showReasonField            Boolean              @default(true) @map("show_reason_field")
  /// Whether the page is live at all. False = the link 404s.
  active                     Boolean              @default(false)
  /// §42 — what a patient may do with their own booking, and up to when.
  allowPatientReschedule     Boolean              @default(true) @map("allow_patient_reschedule")
  allowPatientCancel         Boolean              @default(true) @map("allow_patient_cancel")
  /// Hours before the appointment after which the patient can no longer
  /// change it themselves. 0 = right up to the start.
  patientChangeCutoffHours   Int                  @default(4) @map("patient_change_cutoff_hours")
  /// PHASE 7 — the tri-state policies. NULL means "never decided under the
  /// new model": behaviour then falls back to the frozen booleans above
  /// (true → INSTANT, false → NOT_ALLOWED), so no existing page changes
  /// behaviour by migration. The settings screen writes these from now on.
  patientRescheduleMode      PatientChangePolicy? @map("patient_reschedule_mode")
  patientCancelMode          PatientChangePolicy? @map("patient_cancel_mode")
  /// Cutoff with minute precision (owner: value + minutes/hours/days). NULL
  /// falls back to patientChangeCutoffHours × 60.
  patientChangeCutoffMinutes Int?                 @map("patient_change_cutoff_minutes")
  confirmationMessage        String?              @map("confirmation_message")
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([tenantId])
  @@map("clinic_booking_pages")
}

/// §43 — the INTENT that produced a run of appointments. Every real session is
/// its own `Appointment` row with its own time, status and history; this
/// records only that they were meant as a course, so "this and all future"
/// has something to mean.
model AppointmentSeries {
  id               String              @id @default(uuid())
  tenantId         String              @map("tenant_id")
  clinicId         String              @map("clinic_id")
  patientId        String              @map("patient_id")
  staffId          String              @map("staff_id")
  serviceId        String              @map("service_id")
  frequency        RecurrenceFrequency
  /// For CUSTOM_DAYS: the gap in days. Ignored otherwise.
  intervalDays     Int?                @map("interval_days")
  occurrences      Int?
  endDate          DateTime?           @map("end_date") @db.Date
  active           Boolean             @default(true)
  createdByStaffId String?             @map("created_by_staff_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  clinic       Clinic         @relation(fields: [clinicId], references: [id])
  patient      Patient        @relation(fields: [patientId], references: [id])
  staff        Staff          @relation("AppointmentSeriesProvider", fields: [staffId], references: [id])
  service      ServiceCatalog @relation(fields: [serviceId], references: [id])
  createdBy    Staff?         @relation("AppointmentSeriesAuthor", fields: [createdByStaffId], references: [id])
  appointments Appointment[]

  @@index([tenantId, clinicId])
  @@index([tenantId, patientId])
  @@map("appointment_series")
}

/// §44 — a patient who wants this service but has no time yet.
///
/// Deliberately its own table and not an appointment in a WAITLIST status:
/// a waitlist entry has no time, spans a RANGE of acceptable dates, and may
/// name a daypart rather than an hour. Forcing that into a row whose primary
/// key facts are `scheduledStart` and `scheduledEnd` would mean inventing
/// times nobody agreed to.
model WaitlistEntry {
  id                  String         @id @default(uuid())
  tenantId            String         @map("tenant_id")
  clinicId            String         @map("clinic_id")
  patientId           String         @map("patient_id")
  serviceId           String         @map("service_id")
  /// NULL = any qualified provider.
  preferredStaffId    String?        @map("preferred_staff_id")
  earliestDate        DateTime?      @map("earliest_date") @db.Date
  latestDate          DateTime?      @map("latest_date") @db.Date
  /// 'MORNING' | 'AFTERNOON' | 'EVENING' | 'ANY'. Free text so a clinic that
  /// thinks in "after school" is not blocked by an enum.
  preferredDaypart    String?        @map("preferred_daypart")
  /// Higher goes first. Only staff holding appointment.override may raise it.
  priority            Int            @default(0)
  note                String?
  status              WaitlistStatus @default(ACTIVE)
  offeredAt           DateTime?      @map("offered_at")
  /// The appointment that finally came out of this entry.
  bookedAppointmentId String?        @unique @map("booked_appointment_id")
  createdByStaffId    String?        @map("created_by_staff_id")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  clinic            Clinic         @relation(fields: [clinicId], references: [id])
  patient           Patient        @relation(fields: [patientId], references: [id])
  service           ServiceCatalog @relation(fields: [serviceId], references: [id])
  preferredStaff    Staff?         @relation("WaitlistPreferredProvider", fields: [preferredStaffId], references: [id])
  createdBy         Staff?         @relation("WaitlistAuthor", fields: [createdByStaffId], references: [id])
  bookedAppointment Appointment?   @relation("WaitlistBookedAppointment", fields: [bookedAppointmentId], references: [id])

  @@index([tenantId, clinicId, status])
  @@index([tenantId, serviceId, status])
  @@map("waitlist_entries")
}

// ===========================================================================
// ADMIN PROGRAMME — WAVE 1: THE FINANCIAL MODEL
//
// The rule this wave exists to enforce (owner brief §7): INVOICE, PAYMENT,
// CLAIM, RECEIVABLE, CREDIT NOTE and REFUND are separate facts. Before this
// wave, `Invoice.paidAt` / `paymentMethod` / `patientPaidAmount` carried all
// six of them on one row, which made four things impossible to record:
// a partial payment, a second payment, a payment on a day other than the
// invoice's, and a refund. None of those are exotic — they are Tuesday.
//
// Nothing here rewrites the invoice. `Invoice.patientPaidAmount` stays
// exactly what it was (money collected at settlement) and remains the
// backfill source for the first Payment row of every historical invoice, so
// every existing report keeps returning the number it returned yesterday.
// ===========================================================================

/// A payment ROW is money moving, in one direction, once.
/// A refund is not a negative payment on the same row — it is its own row,
/// because "we took RM80 and later gave RM30 back" is two events that both
/// happened, and collapsing them to RM50 destroys the second one.
enum PaymentKind {
  PAYMENT
  REFUND
}

/// The tender types day-end reconciliation counts. Free-text payment methods
/// (Invoice.paymentMethod) are mapped onto these once, in `tenderOf()`, so
/// that a spelling difference at the counter can never split a settlement
/// line in two.
enum PaymentTender {
  CASH
  CARD
  QR
  EWALLET
  BANK_TRANSFER
  CHEQUE
  /// No money moved at the counter — the panel carries the bill. Recorded so
  /// that a fully-covered invoice still has a settlement event with an actor
  /// and a timestamp, and never looks like an unpaid one.
  PANEL
  OTHER
}

/// One movement of patient money against one invoice.
///
/// APPEND-ONLY BY POLICY AND BY TRIGGER (see the wave-1 migration): a payment
/// that should not have been taken is REVERSED — a second row pointing at the
/// first — never edited and never deleted. `reversedAt` on the original is the
/// single exception the trigger allows, and only to stamp the reversal.
model Payment {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  /// Denormalised from the invoice's visit so day-end can scope by branch
  /// without a three-table join on every reconciliation query.
  clinicId  String @map("clinic_id")
  invoiceId String @map("invoice_id")

  kind        PaymentKind   @default(PAYMENT)
  tender      PaymentTender
  /// The exact string the counter chose, kept beside the canonical tender so a
  /// clinic can report on "Touch 'n Go" vs "GrabPay" without either becoming a
  /// reconciliation bucket of its own.
  methodLabel String?       @map("method_label")

  /// ALWAYS POSITIVE, for both kinds. Direction is `kind`, never the sign —
  /// a signed amount is how a refund gets double-counted by a query that
  /// forgot to filter.
  amount Decimal @db.Decimal(10, 2)

  /// When the money moved, which is NOT when the invoice was raised. Day-end
  /// buckets on this; the sales report buckets on the invoice date. Two
  /// different questions, two different dates, and the reason both exist.
  receivedAt DateTime @map("received_at")

  referenceNo       String? @map("reference_no")
  receivedByStaffId String  @map("received_by_staff_id")
  notes             String?

  /// Set when this row reverses another. The reversal carries the reason;
  /// the original keeps its own record of having happened.
  reversesPaymentId String?   @map("reverses_payment_id")
  reversalReason    String?   @map("reversal_reason")
  reversedAt        DateTime? @map("reversed_at")

  /// Which day-end this settled into, stamped when the day is closed. A
  /// payment with a closing attached is inside a reconciled day and cannot be
  /// reversed without reopening it.
  dayEndClosingId String? @map("day_end_closing_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  invoice       Invoice        @relation(fields: [invoiceId], references: [id])
  receivedBy    Staff          @relation("PaymentReceivedBy", fields: [receivedByStaffId], references: [id])
  reverses      Payment?       @relation("PaymentReversal", fields: [reversesPaymentId], references: [id])
  reversedBy    Payment[]      @relation("PaymentReversal")
  dayEndClosing DayEndClosing? @relation(fields: [dayEndClosingId], references: [id])

  @@index([tenantId, invoiceId])
  @@index([tenantId, clinicId, receivedAt])
  @@index([tenantId, dayEndClosingId])
  @@map("payments")
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  VOID
}

/// Correcting revenue WITHOUT destroying the record of what was billed.
///
/// The alternative — editing or deleting the invoice — is what makes a
/// clinic's reported revenue unauditable, because the number changes and
/// nothing says why. A credit note leaves the original invoice exactly as
/// issued and records the reduction as its own dated, attributed, approvable
/// document.
model CreditNote {
  id               String           @id @default(uuid())
  tenantId         String           @map("tenant_id")
  clinicId         String           @map("clinic_id")
  creditNoteNumber String           @map("credit_note_number")
  invoiceId        String           @map("invoice_id")
  status           CreditNoteStatus @default(DRAFT)
  reason           String

  subtotalAmount Decimal @default(0) @map("subtotal_amount") @db.Decimal(10, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(10, 2)
  totalAmount    Decimal @default(0) @map("total_amount") @db.Decimal(10, 2)

  createdByStaffId  String    @map("created_by_staff_id")
  approvedByStaffId String?   @map("approved_by_staff_id")
  approvedAt        DateTime? @map("approved_at")
  issuedAt          DateTime? @map("issued_at")
  voidedByStaffId   String?   @map("voided_by_staff_id")
  voidedAt          DateTime? @map("voided_at")
  voidReason        String?   @map("void_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  clinic     Clinic           @relation(fields: [clinicId], references: [id])
  invoice    Invoice          @relation(fields: [invoiceId], references: [id])
  createdBy  Staff            @relation("CreditNoteCreatedBy", fields: [createdByStaffId], references: [id])
  approvedBy Staff?           @relation("CreditNoteApprovedBy", fields: [approvedByStaffId], references: [id])
  voidedBy   Staff?           @relation("CreditNoteVoidedBy", fields: [voidedByStaffId], references: [id])
  lines      CreditNoteLine[]

  @@unique([tenantId, creditNoteNumber])
  @@index([tenantId, invoiceId])
  @@index([tenantId, clinicId, status])
  @@map("credit_notes")
}

model CreditNoteLine {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  creditNoteId  String  @map("credit_note_id")
  /// Which invoice line is being credited, when the credit is line-specific.
  /// NULL for a whole-invoice credit (a goodwill write-down, say), which is a
  /// real case and must not be forced into a fake line reference.
  invoiceLineId String? @map("invoice_line_id")
  description   String
  quantity      Int     @default(1)
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  amount        Decimal @db.Decimal(10, 2)
  taxAmount     Decimal @default(0) @map("tax_amount") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  creditNote  CreditNote   @relation(fields: [creditNoteId], references: [id])
  invoiceLine InvoiceLine? @relation(fields: [invoiceLineId], references: [id])

  @@index([tenantId, creditNoteId])
  @@map("credit_note_lines")
}

/// How a line is treated for service tax, independent of the RATE — a
/// zero-rated line and an exempt line both add RM0 and are reported apart.
enum TaxTreatment {
  STANDARD_RATED
  ZERO_RATED
  EXEMPT
}

/// A named tax treatment ("SST-6", "Exempt — medicines"). The RATE lives on
/// TaxRate and is effective-dated, because a rate change is a date, not an
/// edit: invoices issued before it must keep computing at the old rate
/// forever.
model TaxCode {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  code      String
  name      String
  treatment TaxTreatment @default(STANDARD_RATED)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  rates        TaxRate[]
  invoiceLines InvoiceLine[]
  items        Item[]
  services     ServiceCatalog[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("tax_codes")
}

model TaxRate {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  taxCodeId     String    @map("tax_code_id")
  ratePercent   Decimal   @map("rate_percent") @db.Decimal(6, 3)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  /// NULL means "still in force". Closing a rate is setting this, never
  /// deleting the row.
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  taxCode TaxCode @relation(fields: [taxCodeId], references: [id])

  @@index([tenantId, taxCodeId, effectiveFrom])
  @@map("tax_rates")
}

enum DayEndStatus {
  OPEN
  COUNTED
  CLOSED
}

/// One branch, one business day, one reconciliation.
///
/// This is a WORKFLOW, not a report (owner brief §6B). The report can be run
/// again tomorrow and will say the same thing; the closing records what a
/// named person counted in the drawer at the time, what the system expected,
/// and what they said about the difference. Those three facts are not
/// recoverable after the fact from anything else.
model DayEndClosing {
  id           String       @id @default(uuid())
  tenantId     String       @map("tenant_id")
  clinicId     String       @map("clinic_id")
  businessDate DateTime     @map("business_date") @db.Date
  status       DayEndStatus @default(OPEN)

  /// What the ledger says should be there, snapshotted when the day is
  /// counted. Recomputed live while OPEN; frozen at CLOSED so a late
  /// back-dated payment cannot silently rewrite a signed-off day.
  expectedCash  Decimal @default(0) @map("expected_cash") @db.Decimal(12, 2)
  expectedCard  Decimal @default(0) @map("expected_card") @db.Decimal(12, 2)
  expectedQr    Decimal @default(0) @map("expected_qr") @db.Decimal(12, 2)
  expectedOther Decimal @default(0) @map("expected_other") @db.Decimal(12, 2)
  expectedTotal Decimal @default(0) @map("expected_total") @db.Decimal(12, 2)

  /// What a person actually counted or read off the terminal. NULL means not
  /// yet counted — which is not the same as counted-and-found-zero, and the
  /// variance must not be computed from a guess.
  countedCash  Decimal? @map("counted_cash") @db.Decimal(12, 2)
  countedCard  Decimal? @map("counted_card") @db.Decimal(12, 2)
  countedQr    Decimal? @map("counted_qr") @db.Decimal(12, 2)
  countedOther Decimal? @map("counted_other") @db.Decimal(12, 2)

  varianceAmount Decimal? @map("variance_amount") @db.Decimal(12, 2)
  varianceReason String?  @map("variance_reason")

  /// Operational counts frozen with the day, so the closed record answers
  /// "what kind of day was it" without re-running a report over data that
  /// has since moved on.
  invoiceCount Int   @default(0) @map("invoice_count")
  paymentCount Int   @default(0) @map("payment_count")
  snapshot     Json?

  countedByStaffId  String?   @map("counted_by_staff_id")
  countedAt         DateTime? @map("counted_at")
  closedByStaffId   String?   @map("closed_by_staff_id")
  closedAt          DateTime? @map("closed_at")
  reopenedByStaffId String?   @map("reopened_by_staff_id")
  reopenedAt        DateTime? @map("reopened_at")
  reopenReason      String?   @map("reopen_reason")
  reopenCount       Int       @default(0) @map("reopen_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  clinic     Clinic    @relation(fields: [clinicId], references: [id])
  countedBy  Staff?    @relation("DayEndCountedBy", fields: [countedByStaffId], references: [id])
  closedBy   Staff?    @relation("DayEndClosedBy", fields: [closedByStaffId], references: [id])
  reopenedBy Staff?    @relation("DayEndReopenedBy", fields: [reopenedByStaffId], references: [id])
  payments   Payment[]

  @@unique([tenantId, clinicId, businessDate])
  @@index([tenantId, clinicId, businessDate])
  @@map("day_end_closings")
}

// ===========================================================================
// ADMIN PROGRAMME — WAVE 2: THE STOCK LEDGER
//
// `StockMovement` was already an append-only ledger with `StockLevel` as its
// derived cache — the right shape. What it could not express was most of what
// actually moves stock in a two-branch clinic: a transfer, a stock take, an
// expiry write-off, a wastage, an internal consumption, an opening balance.
// Three movement types (GOODS_RECEIVED, ADJUSTMENT, DISPENSED) meant every one
// of those arrived as an unexplained ADJUSTMENT, and an unexplained adjustment
// is indistinguishable from a mistake.
//
// This wave adds the movement types, a REASON on every non-routine movement,
// and the two workflows that must never write stock directly: transfers, where
// the sender cannot decide what the receiver counted, and stock takes, where
// nothing changes until a second person approves the variance.
// ===========================================================================

/// Why a stock quantity changed, on the movements where "because a
/// prescription was dispensed" is not the answer.
///
/// Free text was the alternative and it is not searchable, not reportable, and
/// not comparable across branches. A clinic asking "how much did we lose to
/// expiry last quarter" needs this to be a column.
enum StockAdjustmentReason {
  OPENING_BALANCE
  COUNT_CORRECTION
  DAMAGED
  EXPIRED
  WASTAGE
  RETURN_TO_SUPPLIER
  RETURN_FROM_PATIENT
  INTERNAL_USE
  DATA_ENTRY_ERROR
  OTHER
}

enum StockTransferStatus {
  DRAFT
  SENT
  /// Received with every line matching what was sent.
  RECEIVED
  /// Received, but at least one line's count differed from the sender's.
  RECEIVED_WITH_DISCREPANCY
  CANCELLED
}

/// Stock moving between two branches, as a document with two ends.
///
/// THE RULE THIS MODEL EXISTS TO ENFORCE (owner brief §3D): the sender cannot
/// silently alter a receiver-confirmed quantity. `quantitySent` is written when
/// the transfer is SENT and never again; `quantityReceived` is written by the
/// receiving branch and never by the sender. A difference between them is a
/// discrepancy that has to be explained, not a number somebody edits until the
/// two ends agree.
///
/// Stock leaves the sending branch at SENT and arrives at the receiving branch
/// at RECEIVED — two movements, both on the ledger, with the goods legitimately
/// "in transit" and belonging to neither in between. Deducting and adding in
/// one step would make a lorry-load of medicine appear at a branch that has not
/// opened the box.
model StockTransfer {
  id             String              @id @default(uuid())
  tenantId       String              @map("tenant_id")
  transferNumber String              @map("transfer_number")
  fromClinicId   String              @map("from_clinic_id")
  toClinicId     String              @map("to_clinic_id")
  status         StockTransferStatus @default(DRAFT)
  notes          String?

  createdByStaffId   String    @map("created_by_staff_id")
  sentByStaffId      String?   @map("sent_by_staff_id")
  sentAt             DateTime? @map("sent_at")
  receivedByStaffId  String?   @map("received_by_staff_id")
  receivedAt         DateTime? @map("received_at")
  cancelledByStaffId String?   @map("cancelled_by_staff_id")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelReason       String?   @map("cancel_reason")

  /// PHYSICAL MOVEMENT AND ACCOUNTING SETTLEMENT ARE NOT THE SAME EVENT
  /// (owner brief §3E). Where two branches belong to different companies, the
  /// stock moves here and the money is settled by a separate document. This
  /// field records that such a document exists and its reference; it does NOT
  /// make this row an invoice.
  interCompany          Boolean @default(false) @map("inter_company")
  interCompanyReference String? @map("inter_company_reference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  fromClinic  Clinic              @relation("StockTransferFrom", fields: [fromClinicId], references: [id])
  toClinic    Clinic              @relation("StockTransferTo", fields: [toClinicId], references: [id])
  createdBy   Staff               @relation("StockTransferCreatedBy", fields: [createdByStaffId], references: [id])
  sentBy      Staff?              @relation("StockTransferSentBy", fields: [sentByStaffId], references: [id])
  receivedBy  Staff?              @relation("StockTransferReceivedBy", fields: [receivedByStaffId], references: [id])
  cancelledBy Staff?              @relation("StockTransferCancelledBy", fields: [cancelledByStaffId], references: [id])
  lines       StockTransferLine[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId, fromClinicId, status])
  @@index([tenantId, toClinicId, status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id         String @id @default(uuid())
  tenantId   String @map("tenant_id")
  transferId String @map("transfer_id")
  itemId     String @map("item_id")

  /// STOCK UNITS, the same unit `StockLevel` counts and a person counting the
  /// shelf counts. Never dose units — see `StockMovement.quantityDelta`.
  quantitySent      Int     @map("quantity_sent")
  /// NULL until the receiving branch confirms. NULL is not zero: "not yet
  /// received" and "received nothing" are different, and only one of them is a
  /// discrepancy.
  quantityReceived  Int?    @map("quantity_received")
  discrepancyReason String? @map("discrepancy_reason")

  /// The sending branch's unit cost at the time, snapshotted so an
  /// inter-company settlement and a stock valuation both have a number that
  /// does not move when the catalogue price does.
  unitCost Decimal? @map("unit_cost") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     Item          @relation(fields: [itemId], references: [id])

  @@unique([transferId, itemId])
  @@index([tenantId, transferId])
  @@map("stock_transfer_lines")
}

enum StockTakeStatus {
  DRAFT
  COUNTING
  /// Counted and submitted; variances await a reviewer.
  IN_REVIEW
  /// Approved and POSTED to the ledger. Terminal.
  POSTED
  CANCELLED
}

/// A stock take, as a cycle rather than as a spreadsheet.
///
/// THE RULE (owner brief §3G): "Do NOT change live stock simply because
/// someone typed a count before approval." Counting writes to
/// `StockTakeLine.countedQuantity` and nowhere else. Live stock changes once,
/// at POST, as ordinary `StockMovement` rows with a STOCK_TAKE type and this
/// take as their reference — so the correction is on the same ledger as every
/// other movement and can be read back the same way.
model StockTake {
  id         String          @id @default(uuid())
  tenantId   String          @map("tenant_id")
  clinicId   String          @map("clinic_id")
  takeNumber String          @map("take_number")
  status     StockTakeStatus @default(DRAFT)
  name       String
  notes      String?
  /// Free text: "Cold room", "Front dispensary shelf 3". A location model of
  /// its own would be a fifth source of truth about where things are; the
  /// clinic's own words are enough to split a count between two people.
  location   String?

  createdByStaffId   String    @map("created_by_staff_id")
  submittedAt        DateTime? @map("submitted_at")
  submittedByStaffId String?   @map("submitted_by_staff_id")
  reviewedByStaffId  String?   @map("reviewed_by_staff_id")
  reviewedAt         DateTime? @map("reviewed_at")
  postedAt           DateTime? @map("posted_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelReason       String?   @map("cancel_reason")

  /// Frozen at POST: the variance and its value, so the historic take answers
  /// "what did this cost us" without re-deriving it from stock that has moved
  /// on since.
  varianceValue Decimal? @map("variance_value") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  clinic      Clinic                @relation(fields: [clinicId], references: [id])
  createdBy   Staff                 @relation("StockTakeCreatedBy", fields: [createdByStaffId], references: [id])
  submittedBy Staff?                @relation("StockTakeSubmittedBy", fields: [submittedByStaffId], references: [id])
  reviewedBy  Staff?                @relation("StockTakeReviewedBy", fields: [reviewedByStaffId], references: [id])
  lines       StockTakeLine[]
  counters    StockTakeAssignment[]

  @@unique([tenantId, takeNumber])
  @@index([tenantId, clinicId, status])
  @@map("stock_takes")
}

/// Who is counting what. A take split between two people needs to know which
/// of them has finished.
model StockTakeAssignment {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  stockTakeId String    @map("stock_take_id")
  staffId     String    @map("staff_id")
  location    String?
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  stockTake StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  staff     Staff     @relation("StockTakeCounter", fields: [staffId], references: [id])

  @@unique([stockTakeId, staffId, location])
  @@index([tenantId, stockTakeId])
  @@map("stock_take_assignments")
}

model StockTakeLine {
  id          String @id @default(uuid())
  tenantId    String @map("tenant_id")
  stockTakeId String @map("stock_take_id")
  itemId      String @map("item_id")

  /// What the system believed when the sheet was generated. Frozen: the
  /// variance is measured against what the counter was told, not against a
  /// number that moved while they were counting.
  systemQuantity   Int       @map("system_quantity")
  /// What a person counted. NULL means not counted — which is not zero, and a
  /// take with uncounted lines is not a take that can be posted.
  countedQuantity  Int?      @map("counted_quantity")
  /// Loose units found outside a full pack, recorded separately so a counter
  /// does not have to do the division on the shelf.
  looseUnits       Int?      @map("loose_units")
  countedByStaffId String?   @map("counted_by_staff_id")
  countedAt        DateTime? @map("counted_at")
  /// A second count of a line whose first count looked wrong.
  recountQuantity  Int?      @map("recount_quantity")
  recountAt        DateTime? @map("recount_at")
  varianceReason   String?   @map("variance_reason")
  /// Excluded from the posted adjustment by a reviewer, with the reason kept.
  excluded         Boolean   @default(false)
  unitCost         Decimal?  @map("unit_cost") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  stockTake StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id])
  countedBy Staff?    @relation("StockTakeLineCounter", fields: [countedByStaffId], references: [id])

  @@unique([stockTakeId, itemId])
  @@index([tenantId, stockTakeId])
  @@map("stock_take_lines")
}

/// A monthly purchasing budget, by branch and optionally by category.
///
/// Actual spend is never stored here — it is summed from purchase orders, so
/// the budget cannot drift away from what was really committed.
model ProcurementBudget {
  id       String   @id @default(uuid())
  tenantId String   @map("tenant_id")
  clinicId String   @map("clinic_id")
  /// First day of the month the budget applies to.
  period   DateTime @map("period") @db.Date
  /// NULL means the whole branch. Set means this category's own allowance.
  category String?
  amount   Decimal  @db.Decimal(12, 2)
  notes    String?

  createdByStaffId String   @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  clinic    Clinic @relation(fields: [clinicId], references: [id])
  createdBy Staff  @relation("ProcurementBudgetCreatedBy", fields: [createdByStaffId], references: [id])

  @@unique([tenantId, clinicId, period, category])
  @@index([tenantId, clinicId, period])
  @@map("procurement_budgets")
}

// ===========================================================================
// ADMIN PROGRAMME — WAVE 3: THE PANEL CLAIM WORKSPACE
//
// What existed: a `ClaimBatch` with five statuses and a `ClaimBatchLine` with
// `claimedAmount`, `feeAmount`, `paidAmount` and a status. Enough to record
// that a batch went out and some money came back. Not enough to run the
// workflow the clinic actually runs, which today lives in a Google Sheet:
// rejected claims that must be re-claimed under a NEW claim number, partial
// approvals, per-panel portals with different submission rules, aging against
// each panel's own payment terms, and a receivable that reconciles.
//
// WHAT THIS DOES NOT DO, and says so everywhere it appears: submit to a
// panel's portal. No panel in the owner's list exposes an API to Kuwick
// (D-031). Staff still open the portal and key the claim in. The system's job
// is to make sure they know WHICH claims, that the claims are complete before
// they start, and that what came back reconciles — not to pretend the keying
// happened by itself.
// ===========================================================================

/// The lifecycle a real claim goes through. Deliberately NOT collapsed:
/// "we sent it" and "they said yes" and "the money arrived" are three
/// different facts, and a clinic that cannot tell them apart cannot tell
/// which of its receivables is actually collectable.
enum PanelClaimStatus {
  /// Everything needed is on the invoice; it can go in the next batch.
  READY
  /// Something required by this panel is missing — an IC, a diagnosis, an MC
  /// count. It is not submittable and the reason says what is absent.
  NEEDS_INFORMATION
  /// Batched but not yet sent.
  BATCHED
  SUBMITTED
  /// The portal acknowledged receipt. Not the same as approval.
  ACKNOWLEDGED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  /// Rejected with a route back: re-claim under a new number.
  RESUBMISSION_REQUIRED
  RESUBMITTED
  PAID
  PARTIALLY_PAID
  WRITTEN_OFF
  CLOSED
}

/// WHY A PANEL REFUSED TO PAY, as a countable fact rather than a sentence.
///
/// Every value here was read off the clinic's own excess/rejected register
/// (`docs/PANEL_LEGACY_WORKFLOW_AUDIT.md` §8.3), where the reason is free text
/// in a column meant for dates. Free text cannot answer "what did exhausted
/// member limits cost us this year", which is the question that decides whether
/// to renegotiate a panel or drop it.
///
/// The free-text `rejectionReason` stays: the category is what can be counted,
/// the sentence is what actually happened. Neither replaces the other.
enum ClaimRejectionCategory {
  /// The member's annual or per-visit limit was already spent.
  PATIENT_LIMIT_EXHAUSTED
  /// A specific drug or procedure is not on this panel's formulary at all.
  ITEM_NOT_COVERED
  /// Covered, but only up to a ceiling below what was claimed.
  PARTIALLY_COVERED
  /// A named benefit carries its own cap, lower than the claim.
  BENEFIT_SUBLIMIT
  /// Pre-authorisation or a bypass had not come through.
  AUTHORISATION_PENDING
  /// Something the panel requires was not attached to the submission.
  DOCUMENTATION_INCOMPLETE
  /// Recorded rather than forced into a category that would be wrong.
  OTHER
}

/// How a panel wants claims delivered. Recorded so the workspace can show the
/// right checklist and the right link — never so that Kuwick can claim to have
/// delivered anything itself.
enum PanelSubmissionMethod {
  PORTAL
  EMAIL
  COURIER
  IN_PERSON
  OTHER
}

/// Money arriving from a panel, against one or more claims.
///
/// A panel pays in BATCHES that rarely line up with the batches the clinic
/// submitted: one bank transfer settles fourteen claims from three different
/// submissions, minus a deduction on two of them. So a remittance is its own
/// document, and its allocation to claims is explicit.
model PanelRemittance {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  panelClinicId  String   @map("panel_clinic_id")
  remittanceRef  String?  @map("remittance_ref")
  /// When the money reached the clinic's account.
  receivedAt     DateTime @map("received_at") @db.Date
  /// The gross amount the panel says it paid.
  grossAmount    Decimal  @map("gross_amount") @db.Decimal(12, 2)
  /// What the panel withheld across the whole remittance — its admin fee, or
  /// tax. Kept apart from per-claim deductions, which are adjudication.
  withheldAmount Decimal  @default(0) @map("withheld_amount") @db.Decimal(12, 2)
  /// grossAmount − withheldAmount. Stored rather than derived so a remittance
  /// that does not add up is visible instead of quietly recomputed.
  netAmount      Decimal  @map("net_amount") @db.Decimal(12, 2)
  notes          String?

  recordedByStaffId String   @map("recorded_by_staff_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant      Tenant                      @relation(fields: [tenantId], references: [id])
  panelClinic PanelClinic                 @relation(fields: [panelClinicId], references: [id])
  recordedBy  Staff                       @relation("PanelRemittanceRecordedBy", fields: [recordedByStaffId], references: [id])
  allocations PanelRemittanceAllocation[]

  @@index([tenantId, panelClinicId, receivedAt])
  @@map("panel_remittances")
}

/// How much of a remittance settled which claim. The join that makes
/// "received" a number derived from records rather than typed on a claim.
model PanelRemittanceAllocation {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  remittanceId     String   @map("remittance_id")
  claimBatchLineId String   @map("claim_batch_line_id")
  amount           Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  remittance PanelRemittance @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  claimLine  ClaimBatchLine  @relation(fields: [claimBatchLineId], references: [id])

  @@unique([remittanceId, claimBatchLineId])
  @@index([tenantId, claimBatchLineId])
  @@map("panel_remittance_allocations")
}

/// Every status change and financial edit on a claim, in order.
///
/// Panel claims are the part of this system most likely to be argued about
/// with an outside party months later, and "who marked this rejected and when"
/// is exactly the question that gets asked. `AuditLog` records it too; this
/// table is the CLAIM'S OWN timeline, readable in one query beside the claim
/// rather than filtered out of a tenant-wide audit stream.
model ClaimEvent {
  id               String            @id @default(uuid())
  tenantId         String            @map("tenant_id")
  claimBatchLineId String            @map("claim_batch_line_id")
  eventType        String            @map("event_type")
  fromStatus       PanelClaimStatus? @map("from_status")
  toStatus         PanelClaimStatus? @map("to_status")
  amount           Decimal?          @db.Decimal(10, 2)
  reason           String?
  reference        String?
  actorStaffId     String?           @map("actor_staff_id")
  createdAt        DateTime          @default(now()) @map("created_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  claimLine ClaimBatchLine @relation(fields: [claimBatchLineId], references: [id], onDelete: Cascade)
  actor     Staff?         @relation("ClaimEventActor", fields: [actorStaffId], references: [id])

  @@index([tenantId, claimBatchLineId, createdAt])
  @@map("claim_events")
}

// ===========================================================================
// ADMIN PROGRAMME — WAVE 4: HR, WORKFORCE AND PAYROLL
//
// THE IDENTITY RULE, which shapes everything here (owner brief §5A):
//
//   USER ACCOUNT        — how somebody signs in                    (User)
//   EMPLOYEE PROFILE    — their employment with this clinic group  (EmployeeProfile)
//   CLINICAL PROVIDER   — their professional identity              (Staff.professionalType…)
//
// A person may be all three at once: an owner who is also a doctor and also on
// the payroll. `Staff` is the single hub they all hang off, and none of them is
// forced into another. `EmployeeProfile` is 1:1 with `Staff` — it EXTENDS the
// staff row, it does not become a second answer to "who is this person".
//
// THE ROSTER IS NOT DUPLICATED. `ProviderShift` / `DoctorSchedule` /
// `ScheduleException` remain the one scheduling domain (D-090). Attendance
// records what happened; the roster records what was planned; approved leave
// feeds the roster rather than forking it.
//
// THE STATUTORY RULE, which is the reason payroll is built the way it is:
// Malaysian EPF, SOCSO, EIS and PCB rates are NOT hardcoded anywhere in this
// system. They live in `StatutoryRuleSet` as effective-dated, tenant-owned
// configuration, and a payroll run computed without one is marked
// NOT_CONFIGURED and refuses to present a statutory figure at all — rather
// than presenting a plausible wrong one. See PayrollRun.statutoryStatus.
// ===========================================================================

enum EmploymentType {
  PERMANENT
  CONTRACT
  LOCUM
  PART_TIME
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  NOTICE
  SUSPENDED
  RESIGNED
  TERMINATED
}

/// The employment half of a person. 1:1 with `Staff`, never a second identity.
///
/// SENSITIVE BY CONSTRUCTION: salary, bank details and statutory identifiers
/// live here rather than on `Staff`, so that the ordinary staff read — which
/// half the application performs — cannot accidentally return them. Access is
/// gated on `hr.employee.manage` / `hr.payroll.view`, not on being logged in.
model EmployeeProfile {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  staffId  String @unique @map("staff_id")

  employeeNo      String?   @map("employee_no")
  legalName       String?   @map("legal_name")
  /// IC or passport. Stored because payroll and statutory filing need it;
  /// never returned by any endpoint that is not payroll- or HR-gated.
  identifierType  String?   @map("identifier_type")
  identifierValue String?   @map("identifier_value")
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  gender          String?
  nationality     String?
  maritalStatus   String?   @map("marital_status")

  phone   String?
  email   String?
  address String?

  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactPhone    String? @map("emergency_contact_phone")
  emergencyContactRelation String? @map("emergency_contact_relation")

  employmentType   EmploymentType   @default(PERMANENT) @map("employment_type")
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  department       String?
  position         String?
  managerStaffId   String?          @map("manager_staff_id")
  startDate        DateTime?        @map("start_date") @db.Date
  confirmedDate    DateTime?        @map("confirmed_date") @db.Date
  endDate          DateTime?        @map("end_date") @db.Date
  endReason        String?          @map("end_reason")

  /// Monthly basic. NULL means "not set", which is why a payroll run over an
  /// employee with no salary is an EXCEPTION rather than a zero payslip.
  basicSalary Decimal? @map("basic_salary") @db.Decimal(12, 2)
  /// For hourly/locum staff, where basic salary does not apply.
  hourlyRate  Decimal? @map("hourly_rate") @db.Decimal(10, 2)

  bankName        String? @map("bank_name")
  bankAccountNo   String? @map("bank_account_no")
  bankAccountName String? @map("bank_account_name")

  /// Statutory identifiers. Stored, never used to derive a RATE — rates come
  /// only from StatutoryRuleSet.
  epfNumber       String?  @map("epf_number")
  socsoNumber     String?  @map("socso_number")
  taxNumber       String?  @map("tax_number")
  /// PCB category ("S", "TP1"…). Free text: the categories are the tenant's
  /// configuration, not this schema's opinion.
  taxCategory     String?  @map("tax_category")
  /// Whether statutory contributions apply at all. A foreign locum on a
  /// service contract may be outside EPF/SOCSO entirely.
  /// The employee's elected EPF share: 11 (statutory) or 9 (reduced). Selects
  /// between two different Third Schedule tables, so it is a rate ELECTION and
  /// not a percentage this system multiplies by.
  epfEmployeeRate Decimal? @default(11) @map("epf_employee_rate") @db.Decimal(4, 2)
  epfApplicable   Boolean  @default(true) @map("epf_applicable")
  socsoApplicable Boolean  @default(true) @map("socso_applicable")
  eisApplicable   Boolean  @default(true) @map("eis_applicable")
  pcbApplicable   Boolean  @default(true) @map("pcb_applicable")

  leavePolicyId String? @map("leave_policy_id")
  notes         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  staff       Staff        @relation("StaffEmployeeProfile", fields: [staffId], references: [id], onDelete: Cascade)
  manager     Staff?       @relation("EmployeeManager", fields: [managerStaffId], references: [id])
  leavePolicy LeavePolicy? @relation(fields: [leavePolicyId], references: [id])

  @@unique([tenantId, employeeNo])
  @@index([tenantId, employmentStatus])
  @@map("employee_profiles")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  HOLIDAY
  REST_DAY
  /// Clocked in and never clocked out, or the reverse.
  MISSING_PUNCH
}

/// One person, one day, at one branch.
///
/// SEPARATE FROM THE ROSTER, deliberately. The roster says what was planned;
/// this says what happened. And it is NOT derived from `Visit.checkInAt`,
/// which is what the old attendance report did: a doctor who saw no patients
/// was absent by that measure, and a receptionist who sees none ever was
/// permanently absent.
model AttendanceRecord {
  id       String   @id @default(uuid())
  tenantId String   @map("tenant_id")
  staffId  String   @map("staff_id")
  clinicId String?  @map("clinic_id")
  workDate DateTime @map("work_date") @db.Date

  clockInAt      DateTime? @map("clock_in_at")
  clockOutAt     DateTime? @map("clock_out_at")
  /// The shift this was measured against, when there was one. Read from the
  /// roster; never written back to it.
  scheduledStart DateTime? @map("scheduled_start")
  scheduledEnd   DateTime? @map("scheduled_end")

  status                    AttendanceStatus @default(PRESENT)
  /// Minutes late against the scheduled start. NULL when there was no shift to
  /// be late for.
  lateMinutes               Int?             @map("late_minutes")
  earlyOutMinutes           Int?             @map("early_out_minutes")
  /// Worked minutes, computed from the punches. NULL until both exist.
  workedMinutes             Int?             @map("worked_minutes")
  /// Overtime minutes, APPROVED separately — a long day is not automatically
  /// overtime, which is the assumption that turns a payroll into a dispute.
  overtimeMinutes           Int              @default(0) @map("overtime_minutes")
  overtimeApproved          Boolean          @default(false) @map("overtime_approved")
  overtimeApprovedByStaffId String?          @map("overtime_approved_by_staff_id")

  /// A correction to a punch. The ORIGINAL values survive alongside, because
  /// "the manager changed my clock-in" is exactly the thing an employee
  /// disputes.
  correctedAt        DateTime? @map("corrected_at")
  correctedByStaffId String?   @map("corrected_by_staff_id")
  correctionReason   String?   @map("correction_reason")
  originalClockInAt  DateTime? @map("original_clock_in_at")
  originalClockOutAt DateTime? @map("original_clock_out_at")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant  @relation(fields: [tenantId], references: [id])
  staff              Staff   @relation("AttendanceStaff", fields: [staffId], references: [id], onDelete: Cascade)
  clinic             Clinic? @relation(fields: [clinicId], references: [id])
  correctedBy        Staff?  @relation("AttendanceCorrectedBy", fields: [correctedByStaffId], references: [id])
  overtimeApprovedBy Staff?  @relation("AttendanceOvertimeApprover", fields: [overtimeApprovedByStaffId], references: [id])

  @@unique([tenantId, staffId, workDate])
  @@index([tenantId, clinicId, workDate])
  @@map("attendance_records")
}

/// A named bundle of leave entitlements. Employees point at one, so changing
/// "annual leave for permanent staff" is one edit rather than forty.
model LeavePolicy {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  name             String
  active           Boolean @default(true)
  /// Whether unused annual leave carries into the next year, and how much.
  carryForwardDays Int?    @map("carry_forward_days")
  /// Whether entitlement is pro-rated for a mid-year joiner.
  proRateOnJoin    Boolean @default(true) @map("pro_rate_on_join")
  notes            String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant                   @relation(fields: [tenantId], references: [id])
  entitlements LeavePolicyEntitlement[]
  employees    EmployeeProfile[]

  @@unique([tenantId, name])
  @@map("leave_policies")
}

model LeavePolicyEntitlement {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  leavePolicyId      String    @map("leave_policy_id")
  leaveType          LeaveType @map("leave_type")
  /// Days per benefit year. Zero means the type exists but carries no
  /// entitlement (unpaid leave), which is different from the type being absent.
  daysPerYear        Decimal   @map("days_per_year") @db.Decimal(5, 1)
  /// Whether taking it reduces pay.
  paid               Boolean   @default(true)
  requiresAttachment Boolean   @default(false) @map("requires_attachment")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  leavePolicy LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)

  @@unique([leavePolicyId, leaveType])
  @@map("leave_policy_entitlements")
}

/// One employee's balance for one leave type in one benefit year.
///
/// `taken` is DERIVED from approved LeaveRequests by the service, never
/// incremented on approval — so a balance and the requests behind it cannot
/// disagree, and a cancelled leave returns its days without a compensating
/// edit.
model LeaveBalance {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  staffId          String    @map("staff_id")
  leaveType        LeaveType @map("leave_type")
  /// The calendar year the entitlement belongs to.
  benefitYear      Int       @map("benefit_year")
  entitledDays     Decimal   @map("entitled_days") @db.Decimal(5, 1)
  carriedInDays    Decimal   @default(0) @map("carried_in_days") @db.Decimal(5, 1)
  adjustmentDays   Decimal   @default(0) @map("adjustment_days") @db.Decimal(5, 1)
  adjustmentReason String?   @map("adjustment_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  staff  Staff  @relation("LeaveBalanceStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([tenantId, staffId, leaveType, benefitYear])
  @@index([tenantId, benefitYear])
  @@map("leave_balances")
}

// ---------------------------------------------------------------------------
// DOCTOR INCENTIVES
//
// Parked since Phase 1c on Open Question #2 ("the exact formula semantics need
// a worked numeric example before this can be built correctly, since it's a
// compensation calculation"). Built now with the answer the brief gives, and
// with the property that answer implies: RULES ARE VERSIONED AND
// EFFECTIVE-DATED, and a paid incentive is NEVER recalculated with today's
// rules. `IncentiveResult` snapshots the rule version it was computed under.
// ---------------------------------------------------------------------------

enum IncentiveRuleType {
  /// Threshold + flat amount + percentage of everything above the threshold.
  SALES_COMMISSION
  /// A rate per qualifying procedure or item.
  PROCEDURE
}

model IncentiveRule {
  id             String            @id @default(uuid())
  tenantId       String            @map("tenant_id")
  name           String
  ruleType       IncentiveRuleType @map("rule_type")
  /// NULL means every branch.
  clinicId       String?           @map("clinic_id")
  /// NULL means every eligible doctor; set targets one person.
  staffId        String?           @map("staff_id")
  /// NULL means every employment type; set narrows to (say) LOCUM, which is
  /// how the "different rate for resident vs locum" requirement is expressed
  /// without a second rule table.
  employmentType EmploymentType?   @map("employment_type")

  /// SALES_COMMISSION: monthly sales the doctor must exceed before anything is
  /// earned.
  thresholdAmount Decimal? @map("threshold_amount") @db.Decimal(12, 2)
  /// Paid once on reaching the threshold.
  flatAmount      Decimal? @map("flat_amount") @db.Decimal(12, 2)
  /// Percentage of the amount ABOVE the threshold.
  percentAbove    Decimal? @map("percent_above") @db.Decimal(6, 3)

  /// PROCEDURE: which services qualify, and what each pays.
  serviceCatalogIds   String[] @default([]) @map("service_catalog_ids")
  perProcedureAmount  Decimal? @map("per_procedure_amount") @db.Decimal(10, 2)
  perProcedurePercent Decimal? @map("per_procedure_percent") @db.Decimal(6, 3)

  /// Services or items this rule never pays on, whatever else it says.
  excludedServiceCatalogIds String[] @default([]) @map("excluded_service_catalog_ids")

  /// EFFECTIVE DATING AND VERSIONING. A change is a NEW ROW with a new
  /// `version` and a new `effectiveFrom`; the old row is closed with
  /// `effectiveTo`. Nothing is ever edited in place, because a rule edited in
  /// place makes every historic payment unreproducible.
  version       Int       @default(1)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  active        Boolean   @default(true)
  notes         String?

  createdByStaffId String   @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  clinic    Clinic?           @relation(fields: [clinicId], references: [id])
  staff     Staff?            @relation("IncentiveRuleTarget", fields: [staffId], references: [id])
  createdBy Staff             @relation("IncentiveRuleAuthor", fields: [createdByStaffId], references: [id])
  results   IncentiveResult[]

  @@index([tenantId, effectiveFrom])
  @@map("incentive_rules")
}

enum IncentiveRunStatus {
  DRAFT
  CALCULATED
  APPROVED
  /// Carried into a payroll run. Terminal — the figures can no longer move.
  PAID
  CANCELLED
}

model IncentiveRun {
  id       String             @id @default(uuid())
  tenantId String             @map("tenant_id")
  clinicId String?            @map("clinic_id")
  /// First day of the month being paid.
  period   DateTime           @map("period") @db.Date
  status   IncentiveRunStatus @default(DRAFT)
  notes    String?

  calculatedAt      DateTime? @map("calculated_at")
  approvedByStaffId String?   @map("approved_by_staff_id")
  approvedAt        DateTime? @map("approved_at")
  totalAmount       Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)

  createdByStaffId String   @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  clinic     Clinic?           @relation(fields: [clinicId], references: [id])
  createdBy  Staff             @relation("IncentiveRunAuthor", fields: [createdByStaffId], references: [id])
  approvedBy Staff?            @relation("IncentiveRunApprover", fields: [approvedByStaffId], references: [id])
  results    IncentiveResult[]

  @@unique([tenantId, clinicId, period])
  @@index([tenantId, period])
  @@map("incentive_runs")
}

/// One doctor's incentive for one period under one rule VERSION.
///
/// `ruleVersion` and `ruleSnapshot` are frozen at calculation. Re-running a
/// closed period with today's rules would produce a different number for a
/// payment already made, and "the system now says I was owed less" is not a
/// conversation any clinic should have to have.
model IncentiveResult {
  id              String @id @default(uuid())
  tenantId        String @map("tenant_id")
  incentiveRunId  String @map("incentive_run_id")
  staffId         String @map("staff_id")
  incentiveRuleId String @map("incentive_rule_id")
  ruleVersion     Int    @map("rule_version")
  ruleSnapshot    Json   @map("rule_snapshot")

  /// What the rule measured: sales in the period, or procedures counted.
  basisAmount Decimal @default(0) @map("basis_amount") @db.Decimal(12, 2)
  basisCount  Int     @default(0) @map("basis_count")
  /// What it pays.
  amount      Decimal @default(0) @db.Decimal(12, 2)
  /// The workings, so a doctor asking "why this number" gets an answer rather
  /// than a total.
  calculation Json?

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  incentiveRun IncentiveRun  @relation(fields: [incentiveRunId], references: [id], onDelete: Cascade)
  staff        Staff         @relation("IncentiveResultStaff", fields: [staffId], references: [id])
  rule         IncentiveRule @relation(fields: [incentiveRuleId], references: [id])

  @@index([tenantId, incentiveRunId])
  @@index([tenantId, staffId])
  @@map("incentive_results")
}

// ---------------------------------------------------------------------------
// STAFF MEDICAL BENEFIT
// ---------------------------------------------------------------------------

/// An employee's medical allowance for a benefit year, shared with dependants.
model StaffBenefitAccount {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  staffId     String  @map("staff_id")
  benefitYear Int     @map("benefit_year")
  /// The allowance for the employee AND their dependants together, unless a
  /// member carries an override.
  allowance   Decimal @db.Decimal(10, 2)
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant               @relation(fields: [tenantId], references: [id])
  staff   Staff                @relation("StaffBenefitAccountStaff", fields: [staffId], references: [id], onDelete: Cascade)
  members StaffBenefitMember[]
  usages  StaffBenefitUsage[]

  @@unique([tenantId, staffId, benefitYear])
  @@map("staff_benefit_accounts")
}

model StaffBenefitMember {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  accountId         String   @map("account_id")
  name              String
  relationship      String
  /// The patient record this family member corresponds to, when they have one.
  /// This is what links a benefit to a real visit rather than to a name.
  patientId         String?  @map("patient_id")
  /// A personal cap inside the family allowance, when one is agreed.
  allowanceOverride Decimal? @map("allowance_override") @db.Decimal(10, 2)
  active            Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant              @relation(fields: [tenantId], references: [id])
  account StaffBenefitAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  patient Patient?            @relation(fields: [patientId], references: [id])
  usages  StaffBenefitUsage[]

  @@index([tenantId, accountId])
  @@map("staff_benefit_members")
}

/// One use of the benefit, against a real invoice. Derived totals only —
/// "remaining balance" is allowance minus the sum of these, never a stored
/// number that can drift.
model StaffBenefitUsage {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  accountId String   @map("account_id")
  memberId  String?  @map("member_id")
  invoiceId String?  @map("invoice_id")
  usedAt    DateTime @map("used_at") @db.Date
  amount    Decimal  @db.Decimal(10, 2)
  notes     String?

  recordedByStaffId String   @map("recorded_by_staff_id")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  account    StaffBenefitAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  member     StaffBenefitMember? @relation(fields: [memberId], references: [id])
  invoice    Invoice?            @relation(fields: [invoiceId], references: [id])
  recordedBy Staff               @relation("StaffBenefitUsageRecorder", fields: [recordedByStaffId], references: [id])

  @@index([tenantId, accountId, usedAt])
  @@map("staff_benefit_usages")
}

// ---------------------------------------------------------------------------
// PAYROLL
// ---------------------------------------------------------------------------

/// Whether a run's statutory figures can be trusted, stated on the run itself.
///
/// THE POINT OF THIS ENUM: the brief forbids calculating Malaysian statutory
/// figures "with unverified hard-coded assumptions". So the system does not.
/// A run with no configured rule set for its period is NOT_CONFIGURED, its
/// statutory lines are absent rather than zero, and every payslip and export
/// carries the fact. A wrong EPF number that looks right is worse than no EPF
/// number at all.
/// How far a rate set has been checked. `VERIFIED` is the ONLY value that lets
/// a payroll run be approved, and it means a person opened the authority's
/// published schedule and compared it — not that the numbers look plausible,
/// and not that they came from the clinic's own spreadsheet.
enum StatutoryVerificationStatus {
  /// Entered, unchecked.
  DRAFT
  /// Cross-checked against secondary references and internally consistent, but
  /// NOT against kwsp.gov.my / perkeso.gov.my / hasil.gov.my.
  CORROBORATED
  /// Checked against the authority's own published schedule by a named person.
  VERIFIED
}

enum StatutoryStatus {
  /// A tenant-owned, effective-dated rule set was in force and was applied.
  CONFIGURED
  /// No rule set covers this period. Statutory amounts are NOT computed.
  NOT_CONFIGURED
  /// A rule set exists but the tenant has marked it provisional — figures are
  /// computed and labelled as unverified everywhere they appear.
  PROVISIONAL
}

/// Effective-dated statutory rate tables, owned by the tenant.
///
/// The tables themselves are JSON because their SHAPE differs per scheme (EPF
/// is a percentage pair with a wage ceiling; SOCSO is a bracket table; PCB is a
/// schedule with reliefs) and because they change by law on dates nobody can
/// predict. Encoding them as columns would mean a migration every budget.
///
/// NOTHING IS SEEDED. A fresh tenant has no rule set, and payroll says so.
model StatutoryRuleSet {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  name          String
  /// "MY" today. Present so a second jurisdiction is a row rather than a fork.
  jurisdiction  String    @default("MY")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  /// Marked by the tenant when the figures have been checked against the
  /// authority's published tables. Until then the run is PROVISIONAL and every
  /// payslip says so.
  verificationStatus StatutoryVerificationStatus @default(DRAFT) @map("verification_status")
  /// Where the figures came from. Recorded so a later reviewer can repeat the
  /// check rather than take the last one on trust.
  sourceUrl          String?                     @map("source_url")
  verifiedAt         DateTime?                   @map("verified_at")
  verifiedByStaffId  String?                     @map("verified_by_staff_id")
  verificationNote   String?                     @map("verification_note")

  /// { employeeRate, employerRate, wageCeiling, ageBands: [...] }
  epfRules   Json? @map("epf_rules")
  /// { brackets: [{ from, to, employee, employer }] }
  socsoRules Json? @map("socso_rules")
  eisRules   Json? @map("eis_rules")
  /// { brackets: [...], reliefs: {...} } — or absent, which is the honest
  /// state for a clinic that files PCB through its accountant.
  pcbRules   Json? @map("pcb_rules")

  createdByStaffId String   @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  createdBy  Staff  @relation("StatutoryRuleSetAuthor", fields: [createdByStaffId], references: [id])
  verifiedBy Staff? @relation("StatutoryRuleSetVerifier", fields: [verifiedByStaffId], references: [id])

  @@index([tenantId, effectiveFrom])
  @@map("statutory_rule_sets")
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  /// Approved and LOCKED. Immutable except through a controlled adjustment.
  APPROVED
  PAID
  CANCELLED
}

model PayrollRun {
  id       String           @id @default(uuid())
  tenantId String           @map("tenant_id")
  clinicId String?          @map("clinic_id")
  /// First day of the month.
  period   DateTime         @map("period") @db.Date
  status   PayrollRunStatus @default(DRAFT)

  statutoryStatus    StatutoryStatus @default(NOT_CONFIGURED) @map("statutory_status")
  statutoryRuleSetId String?         @map("statutory_rule_set_id")
  /// The rules AS APPLIED, frozen. A later correction to the rule set cannot
  /// change what an already-approved run computed.
  statutorySnapshot  Json?           @map("statutory_snapshot")

  grossTotal        Decimal @default(0) @map("gross_total") @db.Decimal(14, 2)
  deductionTotal    Decimal @default(0) @map("deduction_total") @db.Decimal(14, 2)
  netTotal          Decimal @default(0) @map("net_total") @db.Decimal(14, 2)
  employerCostTotal Decimal @default(0) @map("employer_cost_total") @db.Decimal(14, 2)
  employeeCount     Int     @default(0) @map("employee_count")

  /// Employees the run could not compute — no salary set, no attendance, an
  /// unapproved overtime claim. Surfaced BEFORE approval, never silently
  /// dropped or zeroed.
  exceptions Json?

  /// Ordinary Rate of Pay divisors AS APPLIED. Clinic policy, not law, and the
  /// clinic uses two different day counts on purpose: overtime is priced on a
  /// 26-day month, unpaid leave is deducted on a 31-day one. Frozen here so a
  /// later policy change cannot silently reprice a historical run.
  orpOvertimeDays    Decimal @default(26) @map("orp_overtime_days") @db.Decimal(4, 1)
  orpUnpaidLeaveDays Decimal @default(31) @map("orp_unpaid_leave_days") @db.Decimal(4, 1)
  orpHoursPerDay     Decimal @default(7.5) @map("orp_hours_per_day") @db.Decimal(4, 2)

  calculatedAt      DateTime? @map("calculated_at")
  approvedByStaffId String?   @map("approved_by_staff_id")
  approvedAt        DateTime? @map("approved_at")
  paidAt            DateTime? @map("paid_at")
  notes             String?

  createdByStaffId String   @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  clinic      Clinic?             @relation(fields: [clinicId], references: [id])
  createdBy   Staff               @relation("PayrollRunAuthor", fields: [createdByStaffId], references: [id])
  approvedBy  Staff?              @relation("PayrollRunApprover", fields: [approvedByStaffId], references: [id])
  lines       PayrollLine[]
  adjustments PayrollAdjustment[]

  @@unique([tenantId, clinicId, period])
  @@index([tenantId, period])
  @@map("payroll_runs")
}

model PayrollLine {
  id           String @id @default(uuid())
  tenantId     String @map("tenant_id")
  payrollRunId String @map("payroll_run_id")
  staffId      String @map("staff_id")

  /// The employee's details AS AT the run, frozen: a payslip must keep saying
  /// what it said even after somebody's position or bank account changes.
  employeeSnapshot Json @map("employee_snapshot")

  basicSalary Decimal @default(0) @map("basic_salary") @db.Decimal(12, 2)
  allowances  Decimal @default(0) @db.Decimal(12, 2)
  overtimePay Decimal @default(0) @map("overtime_pay") @db.Decimal(12, 2)
  incentives  Decimal @default(0) @db.Decimal(12, 2)
  bonus       Decimal @default(0) @db.Decimal(12, 2)
  grossPay    Decimal @default(0) @map("gross_pay") @db.Decimal(12, 2)

  unpaidLeaveDeduction Decimal @default(0) @map("unpaid_leave_deduction") @db.Decimal(12, 2)
  otherDeductions      Decimal @default(0) @map("other_deductions") @db.Decimal(12, 2)

  /// NULL — not zero — when the run is NOT_CONFIGURED. The difference is the
  /// whole reason `StatutoryStatus` exists.
  epfEmployee   Decimal? @map("epf_employee") @db.Decimal(12, 2)
  epfEmployer   Decimal? @map("epf_employer") @db.Decimal(12, 2)
  socsoEmployee Decimal? @map("socso_employee") @db.Decimal(12, 2)
  socsoEmployer Decimal? @map("socso_employer") @db.Decimal(12, 2)
  eisEmployee   Decimal? @map("eis_employee") @db.Decimal(12, 2)
  eisEmployer   Decimal? @map("eis_employer") @db.Decimal(12, 2)
  pcb           Decimal? @db.Decimal(12, 2)

  netPay       Decimal @default(0) @map("net_pay") @db.Decimal(12, 2)
  employerCost Decimal @default(0) @map("employer_cost") @db.Decimal(12, 2)

  /// Worked/absent/OT inputs, so a payslip can explain itself.
  workedDays    Decimal? @map("worked_days") @db.Decimal(5, 1)
  unpaidDays    Decimal? @map("unpaid_days") @db.Decimal(5, 1)
  overtimeHours Decimal? @map("overtime_hours") @db.Decimal(6, 2)
  breakdown     Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  staff      Staff      @relation("PayrollLineStaff", fields: [staffId], references: [id])

  @@unique([payrollRunId, staffId])
  @@index([tenantId, payrollRunId])
  @@map("payroll_lines")
}

/// A PAYROLL INPUT — something a person supplies for a period that the system
/// cannot derive.
///
/// Three kinds of thing land here, and they are the reason a clinic can run
/// payroll at all while parts of the calculation remain unimplemented:
///
///   - Amounts only a human knows: this month's allowance, a bonus, a
///     reimbursed claim, a salary advance being recovered.
///   - PCB. This system does not calculate monthly tax deduction, and until it
///     does, an employee with no PCB input raises a BLOCKING exception. The
///     clinic already computes PCB outside its spreadsheet and keys it in; this
///     is that step, with an actor and a timestamp on it.
///   - Corrections to a derived figure, where the derivation is wrong and
///     waiting for a fix would stop payday.
///
/// Keyed by COMPONENT CODE, so each input carries the statutory liability of
/// the component it is an instance of — an allowance is EPF wages, a mileage
/// claim is not — instead of every caller having to remember.
model PayrollInputEntry {
  id       String   @id @default(uuid())
  tenantId String   @map("tenant_id")
  clinicId String?  @map("clinic_id")
  staffId  String   @map("staff_id")
  /// First day of the month this input belongs to.
  period   DateTime @db.Date

  /// Matches a key of DEFAULT_COMPONENT_LIABILITY, e.g. ALLOWANCE, BONUS, PCB.
  componentCode String  @map("component_code")
  label         String?
  /// Always positive; the component's kind carries the sign.
  amount        Decimal @db.Decimal(12, 2)

  /// Where the money was earned, when that is not the period it is paid in.
  /// The clinic pays December's overtime and locum fees in January, so a
  /// payslip that cannot say "this is December's overtime" is misleading.
  earnedPeriod DateTime? @map("earned_period") @db.Date

  note             String?
  createdByStaffId String   @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  clinic    Clinic? @relation(fields: [clinicId], references: [id])
  staff     Staff   @relation("PayrollInputStaff", fields: [staffId], references: [id])
  createdBy Staff   @relation("PayrollInputAuthor", fields: [createdByStaffId], references: [id])

  @@unique([tenantId, staffId, period, componentCode])
  @@index([tenantId, period])
  @@map("payroll_input_entries")
}

/// The ONLY way an approved run changes.
///
/// A locked payroll is immutable; a correction is an adjustment ROW against it,
/// with an actor and a reason, which appears on the next payslip. Editing the
/// locked line instead would make "what did we actually pay in March" a
/// question with no answer.
model PayrollAdjustment {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  payrollRunId String  @map("payroll_run_id")
  staffId      String  @map("staff_id")
  description  String
  /// Signed: negative is a deduction.
  amount       Decimal @db.Decimal(12, 2)
  reason       String

  createdByStaffId String   @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  staff      Staff      @relation("PayrollAdjustmentStaff", fields: [staffId], references: [id])
  createdBy  Staff      @relation("PayrollAdjustmentAuthor", fields: [createdByStaffId], references: [id])

  @@index([tenantId, payrollRunId])
  @@map("payroll_adjustments")
}

// ===========================================================================
// ADMIN PROGRAMME — WAVE 5: OPERATIONS ANALYTICS
//
// Hijraa's admin segments its P&L into Maternal & Obstetric, NCD, Minor OT,
// Weight Loss and Outpatient. That segmentation is genuinely useful and worth
// keeping — but as CONFIGURATION, not as five hardcoded branches in a report.
// A clinic that opens a dermatology line should add a segment, not wait for a
// deployment.
//
// AND ONE THING THIS DELIBERATELY DOES NOT DO: fabricate clinical indicators.
// A programme dashboard reports what is actually recorded. Where a clinic has
// no structured HbA1c, the NCD screen says the data is not captured rather
// than inventing a control rate from nothing.
// ===========================================================================

/// A reporting segment — a service line the clinic wants its P&L split by.
model BusinessSegment {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  name      String
  code      String
  colour    String?
  /// Lower sorts first on every segment report.
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)
  notes     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant               @relation(fields: [tenantId], references: [id])
  rules  SegmentMappingRule[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("business_segments")
}

/// How a billed line finds its segment.
///
/// EVERY LINE BELONGS TO AT MOST ONE SEGMENT (owner brief §2B). Rules are
/// evaluated in `priority` order and the FIRST match wins, so a line that
/// matches two rules is counted once — under the more specific one, which is
/// the one with the lower priority number. Summing a line into two segments
/// would make the segment totals exceed the clinic's revenue.
model SegmentMappingRule {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  segmentId String @map("segment_id")
  /// Lower runs first. First match wins.
  priority  Int    @default(100)

  /// Exactly one of these decides what the rule matches. A rule with none
  /// matches nothing and is reported as misconfigured rather than matching
  /// everything.
  serviceCatalogId String? @map("service_catalog_id")
  itemId           String? @map("item_id")
  itemCategory     String? @map("item_category")
  serviceCategory  String? @map("service_category")
  /// A case-insensitive substring of the line description — the fallback for
  /// freehand lines, and the only rule type that can match one.
  descriptionMatch String? @map("description_match")

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  segment BusinessSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, priority])
  @@map("segment_mapping_rules")
}

/// A clinical programme a patient can be enrolled in — NCD, weight management,
/// antenatal. Configuration, so a specialised dashboard is a programme rather
/// than a code branch.
model ClinicProgramme {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  name              String
  code              String
  description       String?
  active            Boolean  @default(true)
  /// Services whose delivery counts as programme activity.
  serviceCatalogIds String[] @default([]) @map("service_catalog_ids")
  /// Items whose dispensing counts — the injections and medications that make
  /// a weight-management or NCD programme measurable.
  itemIds           String[] @default([]) @map("item_ids")
  /// Diagnoses that suggest a patient belongs, for the enrolment prompt. Never
  /// auto-enrols anybody: enrolment is a decision a clinician makes.
  diagnosisCodes    String[] @default([]) @map("diagnosis_codes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  enrolments ProgrammeEnrolment[]

  @@unique([tenantId, code])
  @@map("clinic_programmes")
}

model ProgrammeEnrolment {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  programmeId String    @map("programme_id")
  patientId   String    @map("patient_id")
  enrolledAt  DateTime  @map("enrolled_at") @db.Date
  exitedAt    DateTime? @map("exited_at") @db.Date
  exitReason  String?   @map("exit_reason")
  notes       String?

  enrolledByStaffId String   @map("enrolled_by_staff_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  programme  ClinicProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  patient    Patient         @relation(fields: [patientId], references: [id])
  enrolledBy Staff           @relation("ProgrammeEnroller", fields: [enrolledByStaffId], references: [id])

  @@unique([programmeId, patientId, enrolledAt])
  @@index([tenantId, programmeId, exitedAt])
  @@map("programme_enrolments")
}

/// A saved audience definition. The audience itself is COMPUTED on demand from
/// live data — storing a list of patient ids would go stale the moment somebody
/// registers.
model MarketingAudience {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  name     String
  /// The filter, as the builder produced it.
  criteria Json
  notes    String?

  createdByStaffId String   @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  createdBy Staff  @relation("MarketingAudienceAuthor", fields: [createdByStaffId], references: [id])

  @@unique([tenantId, name])
  @@map("marketing_audiences")
}

/// A WhatsApp message template.
///
/// WHAT THIS IS NOT: a sending integration. Kuwick has no WhatsApp Business API
/// connection, so a staff member copies the message or opens WhatsApp with it
/// pre-filled and sends it themselves. `MarketingDispatch` records that the
/// message was PREPARED — never that it was delivered, because nothing here
/// receives a delivery acknowledgement (owner brief §15.5).
model MarketingTemplate {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  /// The body, with {{placeholders}} the preview fills from the patient.
  body         String
  /// Which placeholders this template uses, so the builder can validate them.
  placeholders String[] @default([])
  category     String?
  active       Boolean  @default(true)

  createdByStaffId String   @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  createdBy  Staff               @relation("MarketingTemplateAuthor", fields: [createdByStaffId], references: [id])
  dispatches MarketingDispatch[]

  @@unique([tenantId, name])
  @@map("marketing_templates")
}

/// A record that a message was PREPARED for a patient, by whom, and when.
///
/// The status vocabulary is deliberately short and honest: PREPARED means the
/// text was generated and handed to a person; OPENED means they clicked through
/// to WhatsApp. There is no SENT and no DELIVERED, because Kuwick receives no
/// acknowledgement of either and recording one would be a claim it cannot
/// support.
model MarketingDispatch {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  templateId   String?   @map("template_id")
  patientId    String    @map("patient_id")
  audienceName String?   @map("audience_name")
  /// The exact text handed to the staff member, so what a patient received is
  /// answerable later.
  renderedBody String    @map("rendered_body")
  /// PREPARED | OPENED. Nothing further, deliberately.
  status       String    @default("PREPARED")
  openedAt     DateTime? @map("opened_at")

  preparedByStaffId String   @map("prepared_by_staff_id")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  template   MarketingTemplate? @relation(fields: [templateId], references: [id])
  patient    Patient            @relation(fields: [patientId], references: [id])
  preparedBy Staff              @relation("MarketingDispatchAuthor", fields: [preparedByStaffId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, patientId])
  @@map("marketing_dispatches")
}
