# Copy to .env.test and adjust for your local PostgreSQL.
#
# TEST_DATABASE_URL is the connection the integration suite runs as — the
# NON-SUPERUSER application role (provision-app-role.sql), because RLS and
# the append-only guarantees do not bind a superuser, and a suite that runs
# as one quietly proves nothing about either.
TEST_DATABASE_URL="postgresql://kuwick_app:CHANGE_ME@127.0.0.1:5432/kuwick_test?schema=public"

# The role that applied the migrations (the table owner) on the SAME
# database — appointment-audit-immutability.e2e-spec.ts uses it to prove the
# append-only triggers hold even for the owner/superuser seat.
TEST_OWNER_DATABASE_URL="postgresql://kuwick_dev:CHANGE_ME@127.0.0.1:5432/kuwick_test?schema=public"

# auth.service.ts reads these when a spec boots the Nest app.
JWT_ACCESS_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"
