// Core / Shared Foundation only — see docs/DATABASE_ARCHITECTURE.md §2.
// Clinical, Appointment, HR, Inventory, Panel Claims, and Reports models
// arrive with their respective Phase 1 sub-phase, not here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER_ADMIN
  DOCTOR_RESIDENT
  DOCTOR_LOCUM
  FRONT_DESK_CLINICAL_STAFF
  FINANCE_STAFF
  HR_STAFF
  STOCK_STAFF
  PANEL_STAFF
  PATIENT_PORTAL
}

enum PatientIdentifierType {
  NRIC
  PASSPORT
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinics                     Clinic[]
  users                       User[]
  patients                    Patient[]
  globalSettings              GlobalSetting[]
  notificationLogs            NotificationLog[]
  auditLogs                   AuditLog[]
  staff                       Staff[]
  services                    ServiceCatalog[]
  doctorSchedules             DoctorSchedule[]
  scheduleExceptions          ScheduleException[]
  slotCapacityConfigs         SlotCapacityConfig[]
  doctorServiceQualifications DoctorServiceQualification[]
  appointments                Appointment[]
  items                       Item[]
  suppliers                   Supplier[]
  stockLevels                 StockLevel[]
  stockBatches                StockBatch[]
  stockMovements              StockMovement[]
  procurementRequests         ProcurementRequest[]
  purchaseOrders              PurchaseOrder[]
  purchaseOrderLines          PurchaseOrderLine[]
  goodsReceivedNotes          GoodsReceivedNote[]
  goodsReceivedNoteLines      GoodsReceivedNoteLine[]
  visits                      Visit[]
  queueTickets                QueueTicket[]
  clinicalNotes               ClinicalNote[]
  diagnosisCatalogs           DiagnosisCatalog[]
  diagnoses                   Diagnosis[]
  orderServices               OrderService[]
  itemAgeDosages              ItemAgeDosage[]
  prescriptions               Prescription[]
  panelClinics                PanelClinic[]
  attachments                 Attachment[]
  documents                   Document[]
  invoices                    Invoice[]
  invoiceLines                InvoiceLine[]
  formTemplates               FormTemplate[]
  panelPriceOverrides         PanelPriceOverride[]
  panelExclusions             PanelExclusion[]
  claimBatches                ClaimBatch[]
  claimBatchLines             ClaimBatchLine[]

  @@map("tenants")
}

model Clinic {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  address   String?
  // Printed on document letterheads (MC/Referral/Memo, Phase A4) — kept
  // optional since not every existing seeded clinic has these set yet.
  phone     String?
  email     String?
  timezone  String   @default("Asia/Kuala_Lumpur")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  access              UserClinicAccess[]
  doctorSchedules     DoctorSchedule[]
  scheduleExceptions  ScheduleException[]
  slotCapacityConfigs SlotCapacityConfig[]
  appointments        Appointment[]
  stockLevels         StockLevel[]
  stockBatches        StockBatch[]
  stockMovements      StockMovement[]
  procurementRequests ProcurementRequest[]
  purchaseOrders      PurchaseOrder[]
  goodsReceivedNotes  GoodsReceivedNote[]
  visits              Visit[]
  queueTickets        QueueTicket[]
  orderServices       OrderService[]

  @@index([tenantId])
  @@map("clinics")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  email        String
  passwordHash String    @map("password_hash")
  status       String    @default("active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant Tenant             @relation(fields: [tenantId], references: [id])
  access UserClinicAccess[]
  staff  Staff?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model UserClinicAccess {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  clinicId String @map("clinic_id")
  role     Role

  user   User   @relation(fields: [userId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@map("user_clinic_access")
}

model Patient {
  id                    String                @id @default(uuid())
  tenantId              String                @map("tenant_id")
  identifierType        PatientIdentifierType @map("identifier_type")
  identifierValue       String                @map("identifier_value")
  name                  String
  phone                 String?
  dob                   DateTime?
  gender                String?
  race                  String?
  address               String?
  emergencyContactName  String?               @map("emergency_contact_name")
  emergencyContactPhone String?               @map("emergency_contact_phone")
  allergies             Json?
  deletedAt             DateTime?             @map("deleted_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]
  visits       Visit[]

  @@unique([tenantId, identifierType, identifierValue])
  @@index([tenantId])
  @@map("patients")
}

model GlobalSetting {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  key      String
  value    Json

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("global_settings")
}

model NotificationLog {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  triggerType String    @map("trigger_type")
  channel     String
  recipient   String
  payload     Json?
  status      String    @default("pending")
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("notification_logs")
}

// Append-only. No update/delete path is exposed at the application layer.
model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// HR-lite: just enough of a Staff/Doctor entity for the Appointment module
// (docs/DATABASE_ARCHITECTURE.md §4) to check roster/qualification rules
// against. Full HR (attendance, leave, incentives) is not built here.
model Staff {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String?  @unique @map("user_id")
  role        Role
  fullName    String   @map("full_name")
  staffNumber String?  @map("staff_number")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id])
  user                        User?                        @relation(fields: [userId], references: [id])
  doctorSchedules             DoctorSchedule[]
  scheduleExceptions          ScheduleException[]
  slotCapacityConfigs         SlotCapacityConfig[]
  doctorServiceQualifications DoctorServiceQualification[]
  appointments                Appointment[]
  visits                      Visit[]
  orderServices               OrderService[]
  prescriptions               Prescription[]
  attachments                 Attachment[]
  documentsIssued             Document[]                   @relation("DocumentIssuedBy")
  documentsSigned             Document[]                   @relation("DocumentSignedBy")
  invoices                    Invoice[]
  stockBatchesAdded           StockBatch[]
  claimBatchesCreated         ClaimBatch[]

  @@index([tenantId])
  @@index([tenantId, role])
  @@map("staff")
}

// Appointment status mirrors packages/shared's AppointmentStatus exactly
// (docs/CODING_STANDARDS.md §2) — Prisma can't import a TS enum from another
// package, so keep these two in sync by hand rather than redefining wording.
enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  REMINDED
  ARRIVED
  IN_QUEUE
  COMPLETED
  RESCHEDULED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE_PORTAL
  FRONT_DESK
}

// Owned by Clinical Operations (Phase 1a), consolidating the temporary
// `appointment_services` stand-in built during 1b (docs/DECISIONS.md).
// `price` is the base selfpay rate used to itemize "Standard Services" on
// an Invoice (Phase 1a Phase 5) — panel-tier pricing stays owned by Panel
// Claims' future `PanelPriceTier`, same convention as Inventory's `Item`.
enum ServiceOrderType {
  STANDARD_SERVICE
  TASK_ORDER
}

model ServiceCatalog {
  id                     String           @id @default(uuid())
  tenantId               String           @map("tenant_id")
  name                   String
  // Procedures (Task Orders, e.g. XRAYCHEST) carry a code; booking-time
  // consultation services (Standard Services) generally don't.
  code                   String?
  // Free text (e.g. "Laboratory", "Imaging", "Procedure", "Consultation") —
  // matches the audited kuwick.com Services & Procedures admin screen's
  // CATEGORY column. Not an enum: the clinic's own set of categories isn't
  // fixed/known ahead of time, unlike orderType's two-value distinction.
  category               String?
  // Distinguishes the audited kuwick.com "Orders & Services" sub-filters
  // (Clinical 2c plan) — unifies Task Orders and Standard Services into one
  // catalog/picker rather than two, matching the single "Add Order or
  // Service" selector. Defaults to STANDARD_SERVICE so every row created
  // before this phase (all booking-time services) is unaffected.
  orderType              ServiceOrderType @default(STANDARD_SERVICE) @map("order_type")
  durationMinutesDefault Int              @map("duration_minutes_default")
  price                  Decimal          @default(0) @db.Decimal(10, 2)
  active                 Boolean          @default(true)
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id])
  slotCapacityConfigs         SlotCapacityConfig[]
  doctorServiceQualifications DoctorServiceQualification[]
  appointments                Appointment[]
  orderServices               OrderService[]
  formTemplates               FormTemplate[]
  panelPriceOverrides         PanelPriceOverride[]
  panelExclusions             PanelExclusion[]

  @@index([tenantId])
  @@map("service_catalog")
}

// Clinical Operations, Phase A7. Admin-defined result forms ("Google
// Forms but for lab/procedure results") — clinic owner builds a field
// list once per service (e.g. "Full Blood Count": Hb/WBC/Platelets with
// units and normal ranges), and every future FBC completion renders that
// form instead of a bare free-text box. `fields` is JSON, not a normalized
// child table: a field list is edited as a whole array in the builder UI
// and read as a whole array when rendering, so there's no per-field query
// need that would justify the extra join.
model FormTemplate {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  name             String
  serviceCatalogId String?  @map("service_catalog_id")
  fields           Json
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  serviceCatalog ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])
  orderServices  OrderService[]

  @@index([tenantId])
  @@index([tenantId, serviceCatalogId])
  @@map("form_templates")
}

model DoctorSchedule {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  clinicId      String    @map("clinic_id")
  staffId       String    @map("staff_id")
  dayOfWeek     Int       @map("day_of_week")
  startTime     DateTime  @map("start_time") @db.Time
  endTime       DateTime  @map("end_time") @db.Time
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])
  staff  Staff  @relation(fields: [staffId], references: [id])

  @@index([tenantId])
  @@index([tenantId, clinicId])
  @@index([tenantId, staffId, dayOfWeek])
  @@map("doctor_schedules")
}

// One row per (staff, clinic, date): a populated window overrides the
// recurring DoctorSchedule for that date; a null window means unavailable
// that whole date. Deliberately doesn't support split "leave AM, extra
// session PM" on the same date — flagged as a simplification, not a spec
// requirement.
model ScheduleException {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  clinicId  String    @map("clinic_id")
  staffId   String    @map("staff_id")
  date      DateTime  @db.Date
  startTime DateTime? @map("start_time") @db.Time
  endTime   DateTime? @map("end_time") @db.Time
  reason    String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])
  staff  Staff  @relation(fields: [staffId], references: [id])

  @@unique([tenantId, staffId, clinicId, date])
  @@index([tenantId, clinicId])
  @@map("schedule_exceptions")
}

model SlotCapacityConfig {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  clinicId          String   @map("clinic_id")
  staffId           String   @map("staff_id")
  serviceId         String   @map("service_id")
  slotLengthMinutes Int      @map("slot_length_minutes")
  dailyCapacity     Int?     @map("daily_capacity")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  clinic  Clinic         @relation(fields: [clinicId], references: [id])
  staff   Staff          @relation(fields: [staffId], references: [id])
  service ServiceCatalog @relation(fields: [serviceId], references: [id])

  @@unique([tenantId, clinicId, staffId, serviceId])
  @@index([tenantId, clinicId])
  @@index([tenantId, staffId])
  @@map("slot_capacity_configs")
}

// Presence of a row = qualified; revoke by deleting it.
model DoctorServiceQualification {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  staffId   String   @map("staff_id")
  serviceId String   @map("service_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  staff   Staff          @relation(fields: [staffId], references: [id])
  service ServiceCatalog @relation(fields: [serviceId], references: [id])

  @@unique([tenantId, staffId, serviceId])
  @@index([tenantId, staffId])
  @@index([tenantId, serviceId])
  @@map("doctor_service_qualifications")
}

model Appointment {
  id                String            @id @default(uuid())
  tenantId          String            @map("tenant_id")
  clinicId          String            @map("clinic_id")
  patientId         String            @map("patient_id")
  staffId           String            @map("staff_id")
  serviceId         String            @map("service_id")
  status            AppointmentStatus @default(REQUESTED)
  source            AppointmentSource
  scheduledStart    DateTime          @map("scheduled_start")
  scheduledEnd      DateTime          @map("scheduled_end")
  notes             String?
  cancelReason      String?           @map("cancel_reason")
  arrivedAt         DateTime?         @map("arrived_at")
  rescheduledFromId String?           @unique @map("rescheduled_from_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  clinic          Clinic         @relation(fields: [clinicId], references: [id])
  patient         Patient        @relation(fields: [patientId], references: [id])
  staff           Staff          @relation(fields: [staffId], references: [id])
  service         ServiceCatalog @relation(fields: [serviceId], references: [id])
  rescheduledFrom Appointment?   @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Appointment?   @relation("AppointmentReschedule")

  @@index([tenantId])
  @@index([tenantId, clinicId])
  @@index([tenantId, staffId, scheduledStart])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("appointments")
}

// Inventory & Procurement — Phase 1 core (docs/DATABASE_ARCHITECTURE.md §6,
// docs/DEVELOPMENT_ROADMAP.md 1d). Stock take/variance and inter-branch
// transfer are Phase 2 and not modeled here.

enum StockMovementType {
  GOODS_RECEIVED
  ADJUSTMENT
  // D-028 (docs/DECISIONS.md): stock deducts when a Prescription is marked
  // DISPENSED, not when it's written — this is that ledger entry.
  DISPENSED
}

// Mirrors packages/shared's ProcurementRequestStatus and PurchaseOrderStatus
// exactly (docs/CODING_STANDARDS.md §2) — Prisma can't import a TS enum from
// another package, so keep these in sync by hand, same as AppointmentStatus.
enum ProcurementRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CONVERTED
}

enum PurchaseOrderStatus {
  ORDERED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
  CANCELLED
}

// Selfpay price only — panel-tier pricing lives on PanelPriceOverride
// (Phase A8), not duplicated here.
model Item {
  id                      String   @id @default(uuid())
  tenantId                String   @map("tenant_id")
  code                    String?
  name                    String
  category                String?
  // "Stock Unit (Form)" on the audited kuwick.com Edit Inventory screen —
  // the packaging unit (e.g. "Bottle / Botol"), distinct from
  // doseUnitDefault (the per-dose unit, e.g. "ml").
  unitOfMeasure           String?  @map("unit_of_measure")
  doseDefault             String?  @map("dose_default")
  doseUnitDefault         String?  @map("dose_unit_default")
  frequencyDefault        String?  @map("frequency_default")
  durationDefault         String?  @map("duration_default")
  instruction             String?
  indication              String?
  // Clinical Phase 3 (Medications): "Conc. Vol (mL)" / "Strength (mg)" on
  // the audited Edit Inventory screen — e.g. 457mg per 5mL — feeds the
  // weight-based dosage calculator's volume step (Dose × concVolMl ÷
  // strengthMg). Nullable: only liquid/syrup medicines carry these.
  concVolMl               Decimal? @map("conc_vol_ml") @db.Decimal(10, 2)
  strengthMg              Decimal? @map("strength_mg") @db.Decimal(10, 2)
  consumptionMethod       String?  @map("consumption_method")
  defaultDispenseQuantity Int?     @map("default_dispense_quantity")
  // Free-text clinician guidance (e.g. "25-40MG/KG") — not a structured
  // default plugged into the calculator; the doctor reads this and types
  // the Dose Rate manually at prescribe time.
  prescriptionReference   String?
  remark                  String?
  sellPrice               Decimal  @map("sell_price") @db.Decimal(10, 2)
  cost                    Decimal? @db.Decimal(10, 2)
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  stockLevels            StockLevel[]
  stockBatches           StockBatch[]
  stockMovements         StockMovement[]
  procurementRequests    ProcurementRequest[]
  purchaseOrderLines     PurchaseOrderLine[]
  goodsReceivedNoteLines GoodsReceivedNoteLine[]
  ageDosages             ItemAgeDosage[]
  prescriptions          Prescription[]
  panelPriceOverrides    PanelPriceOverride[]
  panelExclusions        PanelExclusion[]

  @@index([tenantId])
  @@map("items")
}

// Clinical Phase 3 (Medications): per-medicine age-based dosage brackets
// (e.g. "2y-5y: 2.5ml OD", "5y-11y: 5ml OD") — a lookup table, not a
// formula, since age-based dosing doesn't scale linearly the way
// weight-based dosing does. No admin screen for this exists in the
// audited kuwick.com reference yet (owner confirmed it's unfinished
// there); built here with a minimal editor so the mechanism is usable.
model ItemAgeDosage {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  itemId        String   @map("item_id")
  ageFromMonths Int      @map("age_from_months")
  ageToMonths   Int      @map("age_to_months")
  amount        Decimal  @db.Decimal(10, 2)
  unit          String
  frequency     String
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])

  @@index([tenantId, itemId])
  @@map("item_age_dosages")
}

model Supplier {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]
  stockBatches   StockBatch[]

  @@index([tenantId])
  @@map("suppliers")
}

// Cached/derived total (docs/DATABASE_ARCHITECTURE.md §6) — only ever
// written in the same transaction as a StockMovement row, never directly.
// quantityOnHand is deliberately allowed to go negative (docs/DECISIONS.md
// D-020, product-owner decision 2026-07-30): front-line staff dispense/
// invoice immediately even when system stock hasn't caught up with
// physically-received goods, and admin reconciles negative rows afterward
// via GET /stock/negative-stock (StockService.listNegativeStock) rather
// than being blocked at the point of dispensing. A DB CHECK constraint
// enforcing >= 0 was tried first and removed — see the
// allow_negative_stock migration.
model StockLevel {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  clinicId       String   @map("clinic_id")
  itemId         String   @map("item_id")
  quantityOnHand Int      @default(0) @map("quantity_on_hand")
  minThreshold   Int      @default(0) @map("min_threshold")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])

  @@unique([tenantId, clinicId, itemId])
  @@index([tenantId, clinicId])
  @@map("stock_levels")
}

// supplierId/addedByStaffId are only ever set by the quick "Inventory In"
// modal (StockService.quickAdd) — batches coming from a formal Purchase
// Order receive (GoodsReceivingService) leave both null, since the
// supplier is already known from the PO and there's no separate "who
// added this" picker in that flow. Both nullable/optional at the DTO
// level, same no-real-auth convention as OrderService.requestedByStaffId
// (D-017).
model StockBatch {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  clinicId       String    @map("clinic_id")
  itemId         String    @map("item_id")
  batchNumber    String?   @map("batch_number")
  quantity       Int
  expiryDate     DateTime? @map("expiry_date") @db.Date
  receivedDate   DateTime  @map("received_date") @db.Date
  supplierId     String?   @map("supplier_id")
  addedByStaffId String?   @map("added_by_staff_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  clinic                 Clinic                  @relation(fields: [clinicId], references: [id])
  item                   Item                    @relation(fields: [itemId], references: [id])
  supplier               Supplier?               @relation(fields: [supplierId], references: [id])
  addedByStaff           Staff?                  @relation(fields: [addedByStaffId], references: [id])
  stockMovements         StockMovement[]
  goodsReceivedNoteLines GoodsReceivedNoteLine[]

  @@index([tenantId, clinicId])
  @@index([tenantId, itemId, expiryDate])
  @@map("stock_batches")
}

// Append-only ledger — every quantity change is a row here; StockLevel is
// the derived/cached total, never the only record of truth
// (docs/DATABASE_ARCHITECTURE.md §6).
model StockMovement {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  clinicId        String            @map("clinic_id")
  itemId          String            @map("item_id")
  batchId         String?           @map("batch_id")
  movementType    StockMovementType @map("movement_type")
  quantityDelta   Int               @map("quantity_delta")
  referenceType   String?           @map("reference_type")
  referenceId     String?           @map("reference_id")
  createdByUserId String?           @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  clinic Clinic      @relation(fields: [clinicId], references: [id])
  item   Item        @relation(fields: [itemId], references: [id])
  batch  StockBatch? @relation(fields: [batchId], references: [id])

  @@index([tenantId, clinicId])
  @@index([tenantId, itemId])
  @@map("stock_movements")
}

model ProcurementRequest {
  id                String                   @id @default(uuid())
  tenantId          String                   @map("tenant_id")
  clinicId          String                   @map("clinic_id")
  itemId            String                   @map("item_id")
  requestedQuantity Int                      @map("requested_quantity")
  status            ProcurementRequestStatus @default(PENDING)
  requestedByUserId String?                  @map("requested_by_user_id")
  approvedByUserId  String?                  @map("approved_by_user_id")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  clinic             Clinic              @relation(fields: [clinicId], references: [id])
  item               Item                @relation(fields: [itemId], references: [id])
  purchaseOrderLines PurchaseOrderLine[]

  @@index([tenantId, clinicId])
  @@index([tenantId, status])
  @@map("procurement_requests")
}

model PurchaseOrder {
  id         String              @id @default(uuid())
  tenantId   String              @map("tenant_id")
  clinicId   String              @map("clinic_id")
  supplierId String              @map("supplier_id")
  status     PurchaseOrderStatus @default(ORDERED)
  orderedAt  DateTime            @default(now()) @map("ordered_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  clinic             Clinic              @relation(fields: [clinicId], references: [id])
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  lines              PurchaseOrderLine[]
  goodsReceivedNotes GoodsReceivedNote[]

  @@index([tenantId, clinicId])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  purchaseOrderId      String   @map("purchase_order_id")
  itemId               String   @map("item_id")
  procurementRequestId String?  @map("procurement_request_id")
  orderedQuantity      Int      @map("ordered_quantity")
  receivedQuantity     Int      @default(0) @map("received_quantity")
  unitCost             Decimal  @map("unit_cost") @db.Decimal(10, 2)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  purchaseOrder          PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id])
  item                   Item                    @relation(fields: [itemId], references: [id])
  procurementRequest     ProcurementRequest?     @relation(fields: [procurementRequestId], references: [id])
  goodsReceivedNoteLines GoodsReceivedNoteLine[]

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_lines")
}

// Header for one receiving event. D-019 (docs/DECISIONS.md): line detail
// lives on GoodsReceivedNoteLine, not here, since one delivery routinely
// covers multiple PO lines with different quantities/batches/expiries.
model GoodsReceivedNote {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  clinicId         String   @map("clinic_id")
  purchaseOrderId  String   @map("purchase_order_id")
  receivedByUserId String?  @map("received_by_user_id")
  receivedAt       DateTime @default(now()) @map("received_at")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant        Tenant                  @relation(fields: [tenantId], references: [id])
  clinic        Clinic                  @relation(fields: [clinicId], references: [id])
  purchaseOrder PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id])
  lines         GoodsReceivedNoteLine[]

  @@index([tenantId, clinicId])
  @@index([tenantId, purchaseOrderId])
  @@map("goods_received_notes")
}

// D-019: the line-level detail that makes partial, multi-item receiving
// possible. Receiving a line is the single write path that must, in one
// transaction: increment PurchaseOrderLine.receivedQuantity, create/reuse a
// StockBatch, append a StockMovement, and update StockLevel.quantityOnHand —
// see InventoryReceivingService (apps/api/src/inventory).
model GoodsReceivedNoteLine {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  goodsReceivedNoteId String    @map("goods_received_note_id")
  purchaseOrderLineId String    @map("purchase_order_line_id")
  itemId              String    @map("item_id")
  batchId             String?   @map("batch_id")
  quantityReceived    Int       @map("quantity_received")
  batchNumber         String?   @map("batch_number")
  expiryDate          DateTime? @map("expiry_date") @db.Date
  unitCost            Decimal?  @map("unit_cost") @db.Decimal(10, 2)
  createdAt           DateTime  @default(now()) @map("created_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  goodsReceivedNote GoodsReceivedNote @relation(fields: [goodsReceivedNoteId], references: [id])
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  item              Item              @relation(fields: [itemId], references: [id])
  batch             StockBatch?       @relation(fields: [batchId], references: [id])

  @@index([tenantId, goodsReceivedNoteId])
  @@map("goods_received_note_lines")
}

// Clinical Operations, Phase 1a. The hub entity: Appointment's "Arrived"
// action and the front-desk "Add to Daily Queue" action both create one of
// these; Panel Claims' PanelInvoice and HR's IncentiveResult (both target
// design) will bill/total against it, never write to it.
// Clinical Operations, Phase A1 (Queue End-to-End), extended Phase A8.
// Panel/TPA catalog — audited against the live kuwick.com "Panel Clinics"
// admin screen (26 pre-loaded TPA panels with pricing overrides/
// exclusions) and Klinik Hijraa's "Panel Companies" section. limitAmount
// is still informational only — not automatically deducted across visits,
// just used to compute a single visit's copay (Invoice.totalAmount minus
// this limit, for the non-excluded portion — see InvoiceLine). Full claims
// submission/reconciliation stays a later phase (future admin "Panel
// Claims" menu), since that's an external workflow on the panel's own
// website today.
model PanelClinic {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  code        String?
  limitAmount Decimal? @map("limit_amount") @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  visits         Visit[]
  priceOverrides PanelPriceOverride[]
  exclusions     PanelExclusion[]
  claimBatches   ClaimBatch[]

  @@index([tenantId])
  @@map("panel_clinics")
}

// Clinical Operations, Phase A8. Per-panel negotiated rate for a
// medication/vaccine/consumable (Item) or a service/procedure
// (ServiceCatalog) — panels frequently pay a different price than the
// clinic's self-pay rate. Exactly one of itemId/serviceCatalogId is set
// per row (enforced in the DTO, not a DB constraint, matching how other
// optional "which kind of thing" FKs are handled in this schema). Read at
// invoice Quick-Add time to suggest the correct unit price for a panel
// visit; never retroactively rewrites an already-added InvoiceLine
// (snapshot-at-add-time, same convention as every other invoice line).
model PanelPriceOverride {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  panelClinicId    String   @map("panel_clinic_id")
  itemId           String?  @map("item_id")
  serviceCatalogId String?  @map("service_catalog_id")
  overridePrice    Decimal  @map("override_price") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  panelClinic    PanelClinic     @relation(fields: [panelClinicId], references: [id])
  item           Item?           @relation(fields: [itemId], references: [id])
  serviceCatalog ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])

  @@index([tenantId, panelClinicId])
  @@index([tenantId, itemId])
  @@index([tenantId, serviceCatalogId])
  @@map("panel_price_overrides")
}

// Clinical Operations, Phase A8. Items/services a panel does NOT cover.
// When a staff member Quick-Adds a completed OrderService/Prescription to
// a panel visit's invoice, InvoiceService checks this table and stamps
// InvoiceLine.excludedFromPanel — so that line is always counted as
// patient-payable copay, on top of (not netted against) the panel's
// per-visit limitAmount.
model PanelExclusion {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  panelClinicId    String   @map("panel_clinic_id")
  itemId           String?  @map("item_id")
  serviceCatalogId String?  @map("service_catalog_id")
  reason           String?
  createdAt        DateTime @default(now()) @map("created_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  panelClinic    PanelClinic     @relation(fields: [panelClinicId], references: [id])
  item           Item?           @relation(fields: [itemId], references: [id])
  serviceCatalog ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])

  @@index([tenantId, panelClinicId])
  @@index([tenantId, itemId])
  @@index([tenantId, serviceCatalogId])
  @@map("panel_exclusions")
}

model Visit {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  clinicId            String    @map("clinic_id")
  patientId           String    @map("patient_id")
  staffId             String    @map("staff_id")
  // Count-based sequence ("V-000002"), not a DB sequence — same accepted
  // non-atomic-race gap as Inventory's document numbers (docs/DECISIONS.md).
  visitNumber         String    @map("visit_number")
  // Display label ("Self-pay" or the panel's name) — kept as the single
  // source of truth for existing UI that already reads this field.
  // panelClinicId is the structured relation added alongside it; when set,
  // VisitService derives billingType from the panel's name server-side
  // rather than trusting client-supplied text for a panel visit.
  billingType         String    @map("billing_type")
  panelClinicId       String?   @map("panel_clinic_id")
  presentingComplaint String?   @map("presenting_complaint")
  checkInAt           DateTime  @default(now()) @map("check_in_at")
  checkOutAt          DateTime? @map("check_out_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  staff         Staff          @relation(fields: [staffId], references: [id])
  panelClinic   PanelClinic?   @relation(fields: [panelClinicId], references: [id])
  queueTicket   QueueTicket?
  clinicalNote  ClinicalNote?
  diagnoses     Diagnosis[]
  orderServices OrderService[]
  prescriptions Prescription[]
  documents     Document[]
  invoices      Invoice[]

  @@unique([tenantId, visitNumber])
  @@index([tenantId, clinicId])
  @@index([tenantId, patientId])
  @@map("visits")
}

enum QueueTicketStatus {
  WAITING
  IN_CONSULTATION
  DISPENSARY_PAYMENT
  COMPLETED
  CANCELLED
}

// Mirrors the audited kuwick.com Queue module's five tabs (Overview folds
// into the others; Waiting/Consultation/Dispensary & Payment/Completed map
// 1:1 onto this enum plus CANCELLED). One ticket per Visit — see D-023,
// D-024 (docs/DECISIONS.md) for why Dispensary & Payment/Completed stay
// thin here, matching the reference system, while the state machine itself
// is fully real.
model QueueTicket {
  id           String            @id @default(uuid())
  tenantId     String            @map("tenant_id")
  clinicId     String            @map("clinic_id")
  visitId      String            @unique @map("visit_id")
  // Resets daily per clinic — same accepted gap as Visit.visitNumber.
  ticketNumber Int               @map("ticket_number")
  status       QueueTicketStatus @default(WAITING)
  location     String?
  calledAt     DateTime?         @map("called_at")
  cancelReason String?           @map("cancel_reason")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])
  visit  Visit  @relation(fields: [visitId], references: [id])

  @@index([tenantId, clinicId, status])
  @@index([tenantId, clinicId, createdAt])
  @@map("queue_tickets")
}

enum NoteLanguage {
  EN
  MS
}

// Clinical Operations, Phase 2a. One per Visit — matches the audited
// kuwick.com Clinical Notes tab (Vital Signs, Anthropometry, Point-of-Care,
// Notes with a language toggle). Filled in progressively during a
// consultation, so every clinical field is optional; created lazily on
// first save rather than alongside the Visit (docs/DECISIONS.md). BMI is
// intentionally not a stored column — it's derived from weight/height at
// read time so it can't go stale if either is edited later.
model ClinicalNote {
  id                String       @id @default(uuid())
  tenantId          String       @map("tenant_id")
  visitId           String       @unique @map("visit_id")
  bpSystolic        Int?         @map("bp_systolic")
  bpDiastolic       Int?         @map("bp_diastolic")
  pulse             Int?
  temperature       Decimal?     @db.Decimal(4, 1)
  spo2              Int?
  respRate          Int?         @map("resp_rate")
  painScore         Int?         @map("pain_score")
  weight            Decimal?     @db.Decimal(5, 2)
  height            Decimal?     @db.Decimal(5, 2)
  headCircumference Decimal?     @map("head_circumference") @db.Decimal(5, 2)
  glucose           Decimal?     @db.Decimal(5, 2)
  notes             String?
  noteLanguage      NoteLanguage @default(EN) @map("note_language")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  visit  Visit  @relation(fields: [visitId], references: [id])

  @@index([tenantId])
  @@map("clinical_notes")
}

// Clinical Operations, Phase 2b. Per-tenant catalog matching the audited
// kuwick.com Diagnosis tab's "search/add diagnosis from catalog" — no
// dedicated admin CRUD screen this phase; entries are created inline when a
// diagnosis isn't found (Clinical 2b plan, judgment call #3).
enum DiagnosisCategory {
  CUSTOM
  SUMMARIZE
  FULL
}

// D-027 (docs/DECISIONS.md): category is the real meaning of the audited
// kuwick.com "Custom/Summarize/Full" toggle — CUSTOM is clinic-created (via
// the Diagnoses Directory admin screen), SUMMARIZE is a curated global
// subset (~162 entries as owner-supplied), FULL is the complete ICD-10
// standard catalog (~5,064 entries, owner-supplied separately). The visit's
// diagnosis picker filters its search by this field, not by how the
// already-added list is displayed.
model DiagnosisCatalog {
  id        String            @id @default(uuid())
  tenantId  String            @map("tenant_id")
  icd10Code String?           @map("icd10_code")
  name      String
  category  DiagnosisCategory @default(CUSTOM)
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  diagnoses Diagnosis[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, category])
  @@map("diagnosis_catalog")
}

// One row per diagnosis added to a Visit — snapshots icd10Code/name from
// the catalog at add-time (same historical-stability convention as
// PanelInvoice's price snapshot, docs/DATABASE_ARCHITECTURE.md §7), so a
// later catalog rename never silently rewrites an existing visit's record.
model Diagnosis {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  visitId            String   @map("visit_id")
  diagnosisCatalogId String?  @map("diagnosis_catalog_id")
  icd10Code          String?  @map("icd10_code")
  name               String
  createdAt          DateTime @default(now()) @map("created_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  visit            Visit             @relation(fields: [visitId], references: [id])
  diagnosisCatalog DiagnosisCatalog? @relation(fields: [diagnosisCatalogId], references: [id])

  @@index([tenantId, visitId])
  @@map("diagnoses")
}

enum OrderServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Clinical Operations, Phase 2c. Backs both the audited kuwick.com Orders &
// Services tab (per-visit, all statuses/types) and the standalone Procedure
// Queue (cross-visit, TASK_ORDER only — Clinical 2c plan, judgment call #1).
// Snapshots code/procedureName/orderType from ServiceCatalog at order time,
// same historical-stability convention as Diagnosis and PanelInvoice's
// price snapshot. clinicId is denormalized for the Procedure Queue's
// cross-visit query, same as QueueTicket.
model OrderService {
  id                 String             @id @default(uuid())
  tenantId           String             @map("tenant_id")
  clinicId           String             @map("clinic_id")
  visitId            String             @map("visit_id")
  serviceCatalogId   String             @map("service_catalog_id")
  code               String?
  procedureName      String             @map("procedure_name")
  orderType          ServiceOrderType   @map("order_type")
  instruction        String?
  result             String?
  status             OrderServiceStatus @default(PENDING)
  // Defaults to Visit.staffId at creation — no separate doctor-picker UI
  // this phase, since no real auth/user-identity exists yet (docs/DECISIONS.md
  // D-017) and Visit already captures the attending physician.
  requestedByStaffId String             @map("requested_by_staff_id")
  requestedAt        DateTime           @default(now()) @map("requested_at")
  completedAt        DateTime?          @map("completed_at")
  cancelReason       String?            @map("cancel_reason")
  // Phase A7 — set together at complete-time when the service has a
  // matching FormTemplate. formTemplateId is the template used at
  // completion time (kept even if the template is edited/deactivated
  // later, so a historical result still shows which form it came from);
  // formData is the filled-in {fieldId: value} map. `result` (free text)
  // stays populated too — either typed directly, or an auto-generated
  // plain-text summary of formData — so every existing reader (table
  // column, print view) keeps working without a template.
  formTemplateId     String?            @map("form_template_id")
  formData           Json?              @map("form_data")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  clinic         Clinic         @relation(fields: [clinicId], references: [id])
  visit          Visit          @relation(fields: [visitId], references: [id])
  serviceCatalog ServiceCatalog @relation(fields: [serviceCatalogId], references: [id])
  requestedBy    Staff          @relation(fields: [requestedByStaffId], references: [id])
  formTemplate   FormTemplate?  @relation(fields: [formTemplateId], references: [id])
  attachments    Attachment[]
  invoiceLines   InvoiceLine[]

  @@index([tenantId, visitId])
  @@index([tenantId, clinicId, orderType, status])
  @@map("order_services")
}

// Clinical Operations, Phase A3. Files attached to a task/procedure result
// (e.g. an X-ray image for an imaging order) — stored on local disk
// (docs/DECISIONS.md), not blob content in the DB. uploadedByStaffId
// defaults to the order's own requestedByStaffId at upload time, same
// no-separate-picker convention as OrderService.requestedByStaffId (D-017:
// no real auth/user-identity yet).
model Attachment {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  orderServiceId    String   @map("order_service_id")
  fileName          String   @map("file_name")
  filePath          String   @map("file_path")
  mimeType          String   @map("mime_type")
  fileSize          Int      @map("file_size")
  uploadedByStaffId String   @map("uploaded_by_staff_id")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  orderService OrderService @relation(fields: [orderServiceId], references: [id])
  uploadedBy   Staff        @relation(fields: [uploadedByStaffId], references: [id])

  @@index([tenantId, orderServiceId])
  @@map("attachments")
}

enum DocumentType {
  MC
  REFERRAL
  MEMO
  QUARANTINE
}

// Clinical Operations, Phase A4 (owner feedback round 2). Structured
// fields (date range, diagnosis, issuing doctor, issued date, referred-to
// department) back a client-side generated starter template per type —
// still no server-side PDF rendering, `content` remains the single
// editable source of truth the doctor/staff can adjust before saving.
// issuedByStaffId is a real doctor picker now (not silently defaulted) —
// per the owner's clinical flow, invoices/documents must be
// staff-creatable for locum coverage, so the issuing doctor is whoever
// the form says, defaulting to the visit's attending physician only as a
// convenience starting value.
model Document {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  visitId         String       @map("visit_id")
  type            DocumentType
  content         String
  issuedByStaffId String       @map("issued_by_staff_id")
  issuedDate      DateTime     @default(now()) @map("issued_date") @db.Date
  startDate       DateTime?    @map("start_date") @db.Date
  endDate         DateTime?    @map("end_date") @db.Date
  diagnosisText   String?      @map("diagnosis_text")
  referredTo      String?      @map("referred_to")
  // Dispensary "prep, sign MC" step (Phase A6) — a lightweight sign-off
  // checkbox, not a cryptographic signature. Nullable/re-settable rather
  // than a one-way status: correcting who signed is more common in
  // practice than needing an immutable audit lock this phase.
  signedAt        DateTime?    @map("signed_at")
  signedByStaffId String?      @map("signed_by_staff_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  visit    Visit  @relation(fields: [visitId], references: [id])
  issuedBy Staff  @relation("DocumentIssuedBy", fields: [issuedByStaffId], references: [id])
  signedBy Staff? @relation("DocumentSignedBy", fields: [signedByStaffId], references: [id])

  @@index([tenantId, visitId])
  @@map("documents")
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

// Clinical Operations, Phase A5. Invoice creation is deliberately
// staff-creatable — not gated to the visit's own attending doctor — so a
// locum covering someone else's queue can still bill the visit
// (docs/DECISIONS.md D-017: no real auth/user-identity yet, so this is
// simply "no ownership check", not a role-based grant). Marking an
// invoice PAID is Phase A6's job (dispensary/payment step); this phase
// only creates the bill and its line items.
model Invoice {
  id                 String        @id @default(uuid())
  tenantId           String        @map("tenant_id")
  visitId            String        @map("visit_id")
  // Count-based sequence ("INV-000002"), same accepted non-atomic-race gap
  // as Visit.visitNumber.
  invoiceNumber      String        @map("invoice_number")
  status             InvoiceStatus @default(UNPAID)
  totalAmount        Decimal       @default(0) @map("total_amount") @db.Decimal(10, 2)
  createdByStaffId   String        @map("created_by_staff_id")
  cancelReason       String?       @map("cancel_reason")
  // Dispensary payment step (Phase A6) — paymentMethod is free text (same
  // convention as Visit.billingType) rather than a DB enum, since the
  // frontend's fixed option list can grow without a migration.
  paidAt             DateTime?     @map("paid_at")
  paymentMethod      String?       @map("payment_method")
  // Phase 1e — computed and snapshotted server-side by InvoiceService#pay
  // (never trusted from the client, never live-recomputed after payment):
  // panelCoveredAmount is what the panel company owes the clinic for this
  // visit (0 for a self-pay invoice); patientPaidAmount is what the
  // patient actually paid at pay-time (the full total for self-pay, the
  // copay for a panel visit, or 0 for "Mark Fully Covered by Panel"). This
  // is the one place the Panel-Covers/Patient-Copay split becomes a fact
  // instead of a live UI computation — ClaimBatchLine.claimedAmount reads
  // panelCoveredAmount, so a later change to the panel's limit/exclusions
  // can never retroactively alter what's already been claimed.
  panelCoveredAmount Decimal       @default(0) @map("panel_covered_amount") @db.Decimal(10, 2)
  patientPaidAmount  Decimal       @default(0) @map("patient_paid_amount") @db.Decimal(10, 2)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  visit          Visit           @relation(fields: [visitId], references: [id])
  createdBy      Staff           @relation(fields: [createdByStaffId], references: [id])
  lines          InvoiceLine[]
  claimBatchLine ClaimBatchLine?

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, visitId])
  @@map("invoices")
}

enum ClaimBatchStatus {
  BATCHED
  SUBMITTED
  PARTIALLY_PAID
  PAID
  RECONCILED
}

enum ClaimLineStatus {
  PENDING
  ACCEPTED
  REJECTED
  DEDUCTED
  PAID
}

// Phase 1e (Panel Claims Core). No panel in the owner's description has a
// real API Kuwick submits to — every path (AIA's own portal, MARA's
// courier, others' own portals) ends in a human acting outside Kuwick
// (D-031). So there's one status lifecycle for every panel
// (`PRODUCT_REQUIREMENTS.md` §7): batch creation has no fixed period —
// staff pick whichever unclaimed PAID panel invoices they want, whenever
// they want (AIA's near-daily aggregation and another panel's monthly
// cycle are just different staff habits against the same feature) — and
// "Submitted" records a method (Portal/Courier/Email/Other) rather than
// branching into different code per panel.
model ClaimBatch {
  id                  String           @id @default(uuid())
  tenantId            String           @map("tenant_id")
  panelClinicId       String           @map("panel_clinic_id")
  // Count-based sequence ("CLAIM-000002"), same accepted non-atomic-race
  // gap as Visit.visitNumber/Invoice.invoiceNumber.
  batchNumber         String           @map("batch_number")
  status              ClaimBatchStatus @default(BATCHED)
  submissionMethod    String?          @map("submission_method")
  submissionReference String?          @map("submission_reference")
  submittedAt         DateTime?        @map("submitted_at")
  reconciledAt        DateTime?        @map("reconciled_at")
  createdByStaffId    String           @map("created_by_staff_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  panelClinic PanelClinic      @relation(fields: [panelClinicId], references: [id])
  createdBy   Staff            @relation(fields: [createdByStaffId], references: [id])
  lines       ClaimBatchLine[]

  @@unique([tenantId, batchNumber])
  @@index([tenantId, panelClinicId])
  @@map("claim_batches")
}

// One row per invoice ever claimed — @@unique([tenantId, invoiceId])
// prevents the same invoice being pulled into a second batch. claimedAmount
// snapshots Invoice.panelCoveredAmount at batch-creation time (the batch
// total must stay fixed even if the invoice is somehow altered later);
// paidAmount/status/deductionReason are recorded per line, not just per
// batch, since a single batch commonly has some lines accepted-and-paid
// and others rejected/deducted.
model ClaimBatchLine {
  id              String          @id @default(uuid())
  tenantId        String          @map("tenant_id")
  claimBatchId    String          @map("claim_batch_id")
  invoiceId       String          @unique @map("invoice_id")
  claimedAmount   Decimal         @map("claimed_amount") @db.Decimal(10, 2)
  status          ClaimLineStatus @default(PENDING)
  paidAmount      Decimal?        @map("paid_amount") @db.Decimal(10, 2)
  deductionReason String?         @map("deduction_reason")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  claimBatch ClaimBatch @relation(fields: [claimBatchId], references: [id])
  invoice    Invoice    @relation(fields: [invoiceId], references: [id])

  @@index([tenantId, claimBatchId])
  @@map("claim_batch_lines")
}

// Snapshots description/unitPrice/amount at add-time (same historical-
// stability convention as OrderService/Diagnosis catalog snapshots) —
// never a live reference to ServiceCatalog/Item pricing, so a later price
// change never silently alters an already-issued invoice.
//
// Phase A8: sourceOrderServiceId/sourcePrescriptionId are set when a line
// was Quick-Added from a completed service/dispensed medication (nullable
// — a line can still be typed freehand via AddLineForm), so the Quick-Add
// UI can tell which services/medications are already billed. excludedFromPanel
// is stamped server-side at add-time from PanelExclusion — always
// patient-payable, on top of the panel's per-visit limit rather than
// netted against it.
model InvoiceLine {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  invoiceId            String   @map("invoice_id")
  description          String
  quantity             Int      @default(1)
  unitPrice            Decimal  @map("unit_price") @db.Decimal(10, 2)
  amount               Decimal  @db.Decimal(10, 2)
  sourceOrderServiceId String?  @map("source_order_service_id")
  sourcePrescriptionId String?  @map("source_prescription_id")
  excludedFromPanel    Boolean  @default(false) @map("excluded_from_panel")
  createdAt            DateTime @default(now()) @map("created_at")

  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  invoice            Invoice       @relation(fields: [invoiceId], references: [id])
  sourceOrderService OrderService? @relation(fields: [sourceOrderServiceId], references: [id])
  sourcePrescription Prescription? @relation(fields: [sourcePrescriptionId], references: [id])

  @@index([tenantId, invoiceId])
  @@map("invoice_lines")
}

enum PrescriptionStatus {
  ORDERED
  DISPENSED
  CANCELLED
}

// Weight-based vs. age-based dosage calculator method used, if any —
// audit trail only (docs/DECISIONS.md D-028); doesn't drive behaviour.
enum DosageCalcMethod {
  WEIGHT_BASED
  AGE_BASED
  MANUAL
}

// Clinical Operations, Phase 3. Snapshots dose/unit/frequency/duration/
// indication from Item at prescribe-time (same historical-stability
// convention as Diagnosis/OrderService), so a later Item edit never
// rewrites a historical prescription. No hard delete
// (docs/DATABASE_ARCHITECTURE.md §1) — `remove()` sets deletedAt instead,
// only while still ORDERED.
model Prescription {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  visitId  String @map("visit_id")
  itemId   String @map("item_id")

  // "Dispense Quantity" — stock units (e.g. bottles), decremented from
  // StockLevel only at DISPENSED (D-028), never at ORDERED.
  quantity Int @default(1)

  // "Dosage Instructions" — the per-dose amount (e.g. 1.64 mL), distinct
  // from quantity (stock units dispensed).
  amount       Decimal @db.Decimal(10, 2)
  unit         String?
  frequency    String
  durationDays Int     @map("duration_days")
  indication   String?
  remark       String?

  // Calculator audit trail (docs/DECISIONS.md D-028) — nullable, populated
  // only when the doctor used Calculate Dosage rather than typing amount
  // directly.
  calcMethod       DosageCalcMethod? @map("calc_method")
  calcWeightKg     Decimal?          @map("calc_weight_kg") @db.Decimal(6, 2)
  calcDoseRateMgKg Decimal?          @map("calc_dose_rate_mg_kg") @db.Decimal(6, 2)
  calcTargetDoseMg Decimal?          @map("calc_target_dose_mg") @db.Decimal(10, 2)

  status              PrescriptionStatus @default(ORDERED)
  prescribedByStaffId String             @map("prescribed_by_staff_id")
  prescribedAt        DateTime           @default(now()) @map("prescribed_at")
  dispensedAt         DateTime?          @map("dispensed_at")
  cancelReason        String?            @map("cancel_reason")
  deletedAt           DateTime?          @map("deleted_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  visit        Visit         @relation(fields: [visitId], references: [id])
  item         Item          @relation(fields: [itemId], references: [id])
  prescribedBy Staff         @relation(fields: [prescribedByStaffId], references: [id])
  invoiceLines InvoiceLine[]

  @@index([tenantId, visitId])
  @@map("prescriptions")
}
