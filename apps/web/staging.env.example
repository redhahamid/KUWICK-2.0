# G4.5-STAGING — Web service variables. TEMPLATE ONLY: no real values here.
#
# VITE_* values are read at BUILD time and baked into the JavaScript bundle.
# Changing this variable requires a redeploy, not just a restart, and anything
# put here is publicly readable in the bundle. Never place a secret here.

# The public HTTPS URL of the API service. No trailing slash.
# If this is left unset the bundle falls back to http://localhost:3000, which
# is what makes an iPhone fail to reach the API.
VITE_API_BASE_URL=https://<your-api-service>.up.railway.app

# Railway injects PORT for the static server. Do not hard-code it.
# PORT=
