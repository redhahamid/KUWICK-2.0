model User {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  email        String
  passwordHash String    @map("password_hash")
  status       String    @default("active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant Tenant             @relation(fields: [tenantId], references: [id])
  access UserClinicAccess[]
  staff  Staff?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model UserClinicAccess {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  clinicId String @map("clinic_id")
  role     Role

  user   User   @relation(fields: [userId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@map("user_clinic_access")
}

// Real auth (D-034). The ONE model in this schema with no tenantId and no
// RLS policy — a platform admin manages tenants themselves (create new
// clinic businesses onto the SaaS, deactivate them, etc.), which is
// structurally cross-tenant by definition, not an accident (OQ#7 already
// flagged this exact need: "a deliberate platform-admin path across that
// boundary, not an incidental one"). Kept as a wholly separate identity
// from Staff/User — a platform admin is not a member of any clinic's
// staff, and logs in through a separate endpoint issuing a differently-
// shaped JWT (no tenantId claim).
model PlatformAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("platform_admins")
}

// Platform console (D-037) — deliberately outside RLS/tenant scoping, same
// as PlatformAdmin: these are the system owner's own billing catalog, not
// any single clinic's data.
model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String
  description  String?
  priceMyr     Decimal  @default(0) @map("price_myr") @db.Decimal(10, 2)
  durationDays Int      @map("duration_days")
  maxUsers     Int?     @map("max_users")
  maxPatients  Int?     @map("max_patients")
  // Null = unlimited (matches the owner's "Storage: ∞" reference screen).
  maxStorageMb Int?     @map("max_storage_mb")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions TenantSubscription[]

  @@map("subscription_plans")
}

enum TenantSubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

// tenantId carries the ordinary tenant_isolation RLS policy (like every
// other tenant-scoped table) — a clinic could read its own subscription
// history someday. The platform console reads/writes across all tenants via
// the same app.bypass_tenant_scope GUC already used for the tenants table
// itself (migration 20260731280000, D-036).
model TenantSubscription {
  id          String                   @id @default(uuid())
  tenantId    String                   @map("tenant_id")
  planId      String?                  @map("plan_id")
  status      TenantSubscriptionStatus @default(TRIAL)
  startsAt    DateTime                 @default(now()) @map("starts_at")
  endsAt      DateTime                 @map("ends_at")
  cancelledAt DateTime?                @map("cancelled_at")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  tenant Tenant            @relation(fields: [tenantId], references: [id])
  plan   SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("tenant_subscriptions")
}

// Platform console (D-037) — global template catalogs the owner curates
// once; each gets copied into a new tenant's own table at creation time
// (the owner's reference screens: "these serve as the initial default list
// deployed to each clinic"). Deliberately outside RLS, like PlatformAdmin.
model DefaultPanelClinic {
  id        String   @id @default(uuid())
  name      String
  url       String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("default_panel_clinics")
}

model DefaultProcedure {
  id        String   @id @default(uuid())
  code      String?
  name      String
  price     Decimal  @default(0) @db.Decimal(10, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("default_procedures")
}

// Platform console (D-037) — singleton key/value store for system-wide
// settings (General/Billing/Notification/LHDN fallback credentials in the
// owner's reference screens). One row per key, no tenantId — this is the
// operator's own configuration, not any clinic's.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model Patient {
  id                    String                @id @default(uuid())
  tenantId              String                @map("tenant_id")
  identifierType        PatientIdentifierType @map("identifier_type")
  identifierValue       String                @map("identifier_value")
  name                  String
  phone                 String?
  dob                   DateTime?
  gender                String?
  race                  String?
  address               String?
  emergencyContactName  String?               @map("emergency_contact_name")
  emergencyContactPhone String?               @map("emergency_contact_phone")
  deletedAt             DateTime?             @map("deleted_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  tenant              Tenant                  @relation(fields: [tenantId], references: [id])
  appointments        Appointment[]
  appointmentSeries   AppointmentSeries[]
  waitlistEntries     WaitlistEntry[]
  visits              Visit[]
  programmeEnrolments ProgrammeEnrolment[]
  marketingDispatches MarketingDispatch[]
  benefitMemberships  StaffBenefitMember[]
  alerts              PatientAlert[]
  identityChanges     PatientIdentityChange[]

  @@unique([tenantId, identifierType, identifierValue])
  @@index([tenantId])
  @@map("patients")
}

/// Every correction to an IC, identifier type or date of birth.
///
/// The identifier is what ties a person's visits, panel claims and e-Invoice
/// submissions together, so changing it has to stay answerable. One row per
/// FIELD changed, so "IC 12345678901 → 900101145566, by Dr X, on the 16th"
/// reads as a sentence rather than a JSON blob of everything that moved.
///
/// Append-only in the database, not by convention: no UPDATE policy, no DELETE
/// policy, and BEFORE DELETE/TRUNCATE triggers that fire for every role.
model PatientIdentityChange {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  patientId             String   @map("patient_id")
  /// 'identifierType' | 'identifierValue' | 'dob'. A string, so renaming a
  /// column later cannot rewrite what this row says used to be true.
  field                 String
  /// Null where nothing was recorded before — "was blank" is a different fact
  /// from "was wrong".
  oldValue              String?  @map("old_value")
  newValue              String?  @map("new_value")
  changedByStaffId      String   @map("changed_by_staff_id")
  /// Snapshots. A staff member who leaves must not turn last year's
  /// correction into a blank.
  changedByNameSnapshot String   @map("changed_by_name_snapshot")
  changedByRoleSnapshot String   @map("changed_by_role_snapshot")
  createdAt             DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId])
  @@map("patient_identity_changes")
}

// A2 — PATIENT ALERTS (owner spec): standing facts about a person, visible
// to the whole team, structured by type so each surface can show only what
// it needs. Deactivate, never delete — audited, and the migration writes NO
// DELETE policy so the database itself refuses a hard delete.
enum PatientAlertType {
  /// DO NOT PRESCRIBE. Feeds the allergy chip and the prescribing banner.
  /// Split out of MEDICAL because the two are different instructions: an
  /// allergy forbids, a chronic condition qualifies.
  ALLERGY
  /// The CONFIRMED NEGATIVE — somebody asked and the answer was none. Not the
  /// same as no ALLERGY row, which means nobody has recorded one and is the
  /// same shape as nobody having asked.
  NO_KNOWN_ALLERGY
  /// Take into account — chronic conditions, pregnancy, anticoagulation.
  MEDICAL
  ACCESSIBILITY
  COMMUNICATION
  ADMINISTRATIVE
}

/// Where an alert came from. HUMAN means somebody recorded it and
/// `createdByStaffId` names them; MIGRATED means it was carried over from the
/// old free-text `patients.allergies`, which had no author. Nothing in the API
/// can write MIGRATED — it is in no DTO and the service does not accept it.
enum PatientAlertOrigin {
  HUMAN
  MIGRATED
}

model PatientAlert {
  id                   String             @id @default(uuid())
  tenantId             String             @map("tenant_id")
  patientId            String             @map("patient_id")
  type                 PatientAlertType
  label                String
  note                 String?
  active               Boolean            @default(true)
  // Plain staff-id audit columns, same convention as Staff's
  // professionalVerifiedByStaffId — attribution on record without adding two
  // more relations to the Staff constellation.
  /// Null ONLY on a MIGRATED row, and a CHECK constraint enforces that: the
  /// values carried over from `patients.allergies` had no author to name, and
  /// inventing one was judged worse than an honest blank.
  createdByStaffId     String?            @map("created_by_staff_id")
  origin               PatientAlertOrigin @default(HUMAN)
  createdAt            DateTime           @default(now()) @map("created_at")
  deactivatedByStaffId String?            @map("deactivated_by_staff_id")
  deactivatedAt        DateTime?          @map("deactivated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId, active])
  @@map("patient_alerts")
}

model GlobalSetting {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  key      String
  value    Json

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("global_settings")
}

model NotificationLog {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  triggerType String    @map("trigger_type")
  channel     String
  recipient   String
  payload     Json?
  status      String    @default("pending")
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("notification_logs")
}

/// PHASE 7 — a patient's request to change their own booking, awaiting a
/// staff decision.
///
/// A REQUEST OBJECT, deliberately not a status on the appointment: the
/// original booking must stand untouched (same slot, same status, still
/// occupying its time) until somebody with authority decides — and a decision
/// needs its own record of who asked, for what, who answered, and with what
/// words. Overloading AppointmentStatus.REQUESTED would have conflated "the
/// clinic has not accepted this booking yet" with "the patient wants to move
/// an accepted one", which are different facts about different things.
model AppointmentChangeRequest {
  id               String                         @id @default(uuid())
  tenantId         String                         @map("tenant_id")
  clinicId         String                         @map("clinic_id")
  appointmentId    String                         @map("appointment_id")
  type             AppointmentChangeRequestType
  status           AppointmentChangeRequestStatus @default(PENDING)
  /// The patient's own words — required; a request without a reason is a
  /// decision nobody can make.
  reason           String
  /// RESCHEDULE only: where the patient wants to move to. NOT a reservation —
  /// availability is re-checked by the canonical engine at approval time.
  requestedStart   DateTime?                      @map("requested_start")
  requestedEnd     DateTime?                      @map("requested_end")
  decidedByStaffId String?                        @map("decided_by_staff_id")
  decidedAt        DateTime?                      @map("decided_at")
  /// The clinic's words back to the patient — a decline explanation or an
  /// offered alternative ("we could do 15:30 instead — ring us").
  decisionNote     String?                        @map("decision_note")
  createdAt        DateTime                       @default(now()) @map("created_at")

  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  clinic         Clinic      @relation(fields: [clinicId], references: [id])
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  decidedByStaff Staff?      @relation(fields: [decidedByStaffId], references: [id])

  @@index([tenantId, clinicId, status])
  @@index([tenantId, appointmentId])
  @@map("appointment_change_requests")
}

/// PHASE 6 — an uploaded image for the PUBLIC booking surface: a service
/// photo or a booking-page logo.
///
/// THE BYTES LIVE IN POSTGRES, deliberately. Railway's container filesystem
/// is ephemeral — a redeploy would silently blank every service photo — and
/// adding a volume or an object store is deployment surgery this feature
/// does not need for a handful of small images. In the database they survive
/// redeploys, ride the backups, and sit under the same tenant RLS as
/// everything else. Capped at 2 MB per image and image types only, enforced
/// by magic bytes (attachment-validation.ts), so the table stays a shelf of
/// small pictures rather than a file system.
///
/// NO second RLS policy: public serving goes through the booking page's own
/// slug bootstrap (/public/booking/:slug/media/:id resolves the tenant the
/// same way every other public read does), so `clinic_booking_pages` remains
/// the only table with a public policy.
model MediaAsset {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  /// SERVICE_PHOTO or CLINIC_LOGO — what the image is FOR, which bounds
  /// where it may be rendered.
  kind             String
  contentType      String   @map("content_type")
  byteSize         Int      @map("byte_size")
  data             Bytes
  createdByStaffId String?  @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant         Tenant @relation(fields: [tenantId], references: [id])
  createdByStaff Staff? @relation(fields: [createdByStaffId], references: [id])

  @@index([tenantId, kind])
  @@map("media_assets")
}

/// PHASE 5 — a staff member's notification INBOX row.
///
/// NOT event history: `AppointmentEvent` stays the canonical record of what
/// happened to a booking. This is the per-RECIPIENT copy that carries an
/// unread state — "Aisyah has not seen the new online booking yet" is a fact
/// about Aisyah, not about the booking. And NOT `NotificationLog`, which
/// records outbound deliveries on external channels (a recipient string and
/// a send status); a staff inbox needs a staff id, a clinic, a read marker
/// and an appointment to open.
model StaffNotification {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  clinicId         String    @map("clinic_id")
  recipientStaffId String    @map("recipient_staff_id")
  /// e.g. NEW_BOOKING / BOOKING_REQUEST / PATIENT_CANCELLED — worded by the
  /// web's own dictionary, stored as a stable code.
  type             String
  title            String
  body             String
  appointmentId    String?   @map("appointment_id")
  readAt           DateTime? @map("read_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  recipient   Staff        @relation(fields: [recipientStaffId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([tenantId, recipientStaffId, createdAt(sort: Desc)])
  @@index([tenantId, recipientStaffId, readAt])
  @@map("staff_notifications")
}

// Append-only. No update/delete path is exposed at the application layer.
model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// HR-lite: just enough of a Staff/Doctor entity for the Appointment module
// (docs/DATABASE_ARCHITECTURE.md §4) to check roster/qualification rules
// against. Extended Phase 1c with Leave/PublicHoliday; Attendance is a
// read-only derived report over Visit.checkInAt/checkOutAt (no table of
// its own — matches "attendance via clinical check-in/out",
// PRODUCT_REQUIREMENTS.md §4 traceability table). The Doctor Incentive
// Engine stays unbuilt — blocked on Open Question #2 (exact formula
// semantics need a worked numeric example before this can be built
// correctly, since it's a compensation calculation).
model Staff {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String?  @unique @map("user_id")
  role        Role
  fullName    String   @map("full_name")
  staffNumber String?  @map("staff_number")
  active      Boolean  @default(true)
  // D-045 — this staff member's home branch. Null means they work across
  // every clinic in the tenant (owner/finance/HR-type roles) and still see
  // a clinic picker; set means every clinic-scoped screen auto-resolves to
  // this clinic and the picker never shows at all — "log in and you're
  // already at your clinic," not a re-selection every screen.
  clinicId    String?  @map("clinic_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // C0 — professional (clinical) identity, separate from `role` above.
  // Every field defaults to the non-signing state so that nobody can sign a
  // clinical note until a Clinic Group explicitly records verification and
  // enables signing (fail-safe: a fresh deploy has zero eligible signers).
  //
  // professionalVerifiedAt/By records that THE CLINIC GROUP recorded a
  // verification — Kuwick performs no MMC registry lookup and the UI must
  // never claim otherwise (no such integration exists).
  professionalType                ProfessionalType @default(NON_CLINICAL) @map("professional_type")
  medicalRegistrationNo           String?          @map("medical_registration_no")
  // Normalised (uppercased, inner whitespace/punctuation stripped) copy used
  // for duplicate detection. Indexed but NOT unique in C0 — the hard
  // constraint waits for the multi-branch phase, since a tenant could today
  // be using duplicate Staff rows as a multi-branch workaround and we cannot
  // preflight production data from here.
  medicalRegistrationNoNormalised String?          @map("medical_registration_no_normalised")
  professionalActive              Boolean          @default(false) @map("professional_active")
  canSignClinicalNotes            Boolean          @default(false) @map("can_sign_clinical_notes")
  professionalVerifiedAt          DateTime?        @map("professional_verified_at")
  professionalVerifiedByStaffId   String?          @map("professional_verified_by_staff_id")
  clinicalSigningEnabledAt        DateTime?        @map("clinical_signing_enabled_at")
  clinicalSigningEnabledByStaffId String?          @map("clinical_signing_enabled_by_staff_id")

  /// Where this provider's bookable time comes from (§18). FIXED_WEEKLY is
  /// the default because it is what every existing provider already has — a
  /// `DoctorSchedule` weekly pattern — and a migration must not change what
  /// anybody's diary says.
  appointmentScheduleMode ProviderScheduleMode @default(FIXED_WEEKLY) @map("appointment_schedule_mode")
  /// The provider's colour on the calendar. NULL = derived from the id, which
  /// is what the web app already does; set it to override.
  calendarColor           String?              @map("calendar_color")

  tenant                       Tenant                       @relation(fields: [tenantId], references: [id])
  user                         User?                        @relation(fields: [userId], references: [id])
  clinic                       Clinic?                      @relation(fields: [clinicId], references: [id])
  providerShifts               ProviderShift[]              @relation("ProviderShiftProvider")
  providerShiftsCreated        ProviderShift[]              @relation("ProviderShiftAuthor")
  scheduleModePeriods          ProviderScheduleModePeriod[] @relation("ScheduleModePeriodProvider")
  staffNotifications           StaffNotification[]
  changeRequestsDecided        AppointmentChangeRequest[]
  mediaAssets                  MediaAsset[]
  scheduleModePeriodsCreated   ProviderScheduleModePeriod[] @relation("ScheduleModePeriodAuthor")
  appointmentEvents            AppointmentEvent[]           @relation("AppointmentEventActor")
  appointmentsOverridden       Appointment[]                @relation("AppointmentOverrideAuthor")
  appointmentSeriesCreated     AppointmentSeries[]          @relation("AppointmentSeriesAuthor")
  appointmentSeriesProvided    AppointmentSeries[]          @relation("AppointmentSeriesProvider")
  waitlistEntries              WaitlistEntry[]              @relation("WaitlistPreferredProvider")
  waitlistEntriesCreated       WaitlistEntry[]              @relation("WaitlistAuthor")
  appointmentCommunications    AppointmentCommunication[]   @relation("CommunicationActor")
  doctorSchedules              DoctorSchedule[]
  scheduleExceptions           ScheduleException[]
  slotCapacityConfigs          SlotCapacityConfig[]
  clinicClosedDates            ClinicClosedDate[]
  appointmentRemindersSent     Appointment[]                @relation("AppointmentReminderAuthor")
  appointmentsCancelled        Appointment[]                @relation("AppointmentCancelAuthor")
  doctorServiceQualifications  DoctorServiceQualification[]
  appointments                 Appointment[]
  // Two different roles on a visit: the attending clinician, and whoever
  // completed the doctor phase. Usually the same person, but not necessarily
  // — a locum can finish a colleague's consultation — so they are recorded
  // separately rather than one being assumed from the other.
  visits                       Visit[]                      @relation("VisitAttendingStaff")
  visitsRegistered             Visit[]                      @relation("VisitRegisteredBy")
  visitsDoctorCompleted        Visit[]                      @relation("VisitDoctorCompletedBy")
  visitsPanelVerified          Visit[]                      @relation("VisitPanelVerifiedBy")
  visitsPanelBenefitOverridden Visit[]                      @relation("VisitPanelBenefitOverriddenBy")
  workflowEvents               VisitWorkflowEvent[]         @relation("WorkflowEventActor")
  workflowEventsHandedOver     VisitWorkflowEvent[]         @relation("WorkflowEventPreviousStaff")
  workflowEventsReceived       VisitWorkflowEvent[]         @relation("WorkflowEventNewStaff")
  roleAssignments              StaffRoleAssignment[]        @relation("StaffRoleHolder")
  permissionGrants             StaffPermissionGrant[]       @relation("StaffPermissionHolder")
  permissionGrantsMade         StaffPermissionGrant[]       @relation("StaffPermissionGrantedBy")
  roleAssignmentsGranted       StaffRoleAssignment[]        @relation("StaffRoleGrantedBy")
  customRolesCreated           ClinicCustomRole[]           @relation("CustomRoleCreatedBy")
  queueTicketsHeld             QueueTicket[]                @relation("QueueTicketHeldBy")
  orderServices                OrderService[]
  prescriptions                Prescription[]
  attachments                  Attachment[]
  visitAttachments             VisitAttachment[]
  chatMessages                 ChatMessage[]
  documentsIssued              Document[]                   @relation("DocumentIssuedBy")
  documentsSigned              Document[]                   @relation("DocumentSignedBy")
  invoices                     Invoice[]
  stockBatchesAdded            StockBatch[]
  claimBatchesCreated          ClaimBatch[]
  leaveRequests                LeaveRequest[]               @relation("LeaveRequestStaff")
  leaveRequestsApproved        LeaveRequest[]               @relation("LeaveRequestApprovedBy")
  clinicalNotesAuthored        ClinicalNote[]               @relation("ClinicalNoteAuthor")
  clinicalNotesSigned          ClinicalNote[]               @relation("ClinicalNoteSigner")
  clinicalNotesFinalized       ClinicalNote[]               @relation("ClinicalNoteFinalizer")
  observationsRecorded         VisitObservation[]           @relation("ObservationRecorder")
  observationsUpdated          VisitObservation[]           @relation("ObservationUpdater")
  diagnosesRecorded            Diagnosis[]                  @relation("DiagnosisRecorder")
  diagnosesRemoved             Diagnosis[]                  @relation("DiagnosisRemover")
  documentsVoided              Document[]                   @relation("DocumentVoidedBy")
  visitAttachmentsRemoved      VisitAttachment[]            @relation("VisitAttachmentRemovedBy")
  visitAttachmentsFiled        VisitAttachment[]            @relation("VisitAttachmentCategoryBy")
  orderAttachmentsRemoved      Attachment[]                 @relation("OrderAttachmentRemovedBy")
  professionalAudits           StaffProfessionalAudit[]     @relation("ProfessionalAuditSubject")
  professionalAuditsMade       StaffProfessionalAudit[]     @relation("ProfessionalAuditActor")
  labelPrints                  LabelPrint[]
  paymentsReceived             Payment[]                    @relation("PaymentReceivedBy")
  creditNotesCreated           CreditNote[]                 @relation("CreditNoteCreatedBy")
  creditNotesApproved          CreditNote[]                 @relation("CreditNoteApprovedBy")
  creditNotesVoided            CreditNote[]                 @relation("CreditNoteVoidedBy")
  dayEndsCounted               DayEndClosing[]              @relation("DayEndCountedBy")
  dayEndsClosed                DayEndClosing[]              @relation("DayEndClosedBy")
  stockTransfersCreated        StockTransfer[]              @relation("StockTransferCreatedBy")
  stockTransfersSent           StockTransfer[]              @relation("StockTransferSentBy")
  stockTransfersReceived       StockTransfer[]              @relation("StockTransferReceivedBy")
  stockTransfersCancelled      StockTransfer[]              @relation("StockTransferCancelledBy")
  stockTakesCreated            StockTake[]                  @relation("StockTakeCreatedBy")
  stockTakesSubmitted          StockTake[]                  @relation("StockTakeSubmittedBy")
  stockTakesReviewed           StockTake[]                  @relation("StockTakeReviewedBy")
  stockTakeAssignments         StockTakeAssignment[]        @relation("StockTakeCounter")
  stockTakeLinesCounted        StockTakeLine[]              @relation("StockTakeLineCounter")
  procurementBudgetsCreated    ProcurementBudget[]          @relation("ProcurementBudgetCreatedBy")
  panelRemittancesRecorded     PanelRemittance[]            @relation("PanelRemittanceRecordedBy")
  claimsResponsibleFor         ClaimBatchLine[]             @relation("ClaimResponsibleStaff")
  claimsWrittenOff             ClaimBatchLine[]             @relation("ClaimWrittenOffBy")
  claimsChargedToPatient       ClaimBatchLine[]             @relation("ClaimChargedToPatientBy")
  supplierInvoicesRecorded     SupplierInvoice[]            @relation("SupplierInvoiceRecordedBy")
  supplierPaymentsRecorded     SupplierPayment[]            @relation("SupplierPaymentRecordedBy")
  panelFeeTermsRecorded        PanelFeeTerm[]               @relation("PanelFeeTermRecordedBy")
  itemPriceChanges             ItemPriceChange[]            @relation("ItemPriceChangedBy")
  newItemRequestsRaised        NewItemRequest[]             @relation("NewItemRequestedBy")
  newItemRequestsDecided       NewItemRequest[]             @relation("NewItemRequestDecidedBy")
  claimEvents                  ClaimEvent[]                 @relation("ClaimEventActor")
  stockMovementsMade           StockMovement[]              @relation("StockMovementActor")
  dayEndsReopened              DayEndClosing[]              @relation("DayEndReopenedBy")
  employeeProfile              EmployeeProfile?             @relation("StaffEmployeeProfile")
  directReports                EmployeeProfile[]            @relation("EmployeeManager")
  attendanceRecords            AttendanceRecord[]           @relation("AttendanceStaff")
  attendanceCorrections        AttendanceRecord[]           @relation("AttendanceCorrectedBy")
  overtimeApprovals            AttendanceRecord[]           @relation("AttendanceOvertimeApprover")
  leaveBalances                LeaveBalance[]               @relation("LeaveBalanceStaff")
  incentiveRulesTargeting      IncentiveRule[]              @relation("IncentiveRuleTarget")
  incentiveRulesAuthored       IncentiveRule[]              @relation("IncentiveRuleAuthor")
  incentiveRunsAuthored        IncentiveRun[]               @relation("IncentiveRunAuthor")
  incentiveRunsApproved        IncentiveRun[]               @relation("IncentiveRunApprover")
  incentiveResults             IncentiveResult[]            @relation("IncentiveResultStaff")
  benefitAccounts              StaffBenefitAccount[]        @relation("StaffBenefitAccountStaff")
  benefitUsagesRecorded        StaffBenefitUsage[]          @relation("StaffBenefitUsageRecorder")
  statutoryRuleSetsAuthored    StatutoryRuleSet[]           @relation("StatutoryRuleSetAuthor")
  statutoryRuleSetsVerified    StatutoryRuleSet[]           @relation("StatutoryRuleSetVerifier")
  payrollRunsAuthored          PayrollRun[]                 @relation("PayrollRunAuthor")
  payrollRunsApproved          PayrollRun[]                 @relation("PayrollRunApprover")
  payrollLines                 PayrollLine[]                @relation("PayrollLineStaff")
  payrollAdjustments           PayrollAdjustment[]          @relation("PayrollAdjustmentStaff")
  programmeEnrolments          ProgrammeEnrolment[]         @relation("ProgrammeEnroller")
  marketingAudiences           MarketingAudience[]          @relation("MarketingAudienceAuthor")
  marketingTemplates           MarketingTemplate[]          @relation("MarketingTemplateAuthor")
  marketingDispatches          MarketingDispatch[]          @relation("MarketingDispatchAuthor")
  payrollAdjustmentsAuthored   PayrollAdjustment[]          @relation("PayrollAdjustmentAuthor")
  prescriptionsReviewed        Prescription[]               @relation("PrescriptionReviewer")
  payrollInputs                PayrollInputEntry[]          @relation("PayrollInputStaff")
  payrollInputsCreated         PayrollInputEntry[]          @relation("PayrollInputAuthor")

  @@index([tenantId])
  @@index([tenantId, role])
  @@index([tenantId, clinicId])
