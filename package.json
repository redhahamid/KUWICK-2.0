{
  "name": "kuwick-2.0",
  "private": true,
  "version": "0.1.0",
  "description": "Kuwick 2.0 - unified clinic operating system (monorepo root)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:api": "npm run test --workspace=apps/api",
    "test:api:e2e": "npm run test:e2e --workspace=apps/api"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@5.22.0": true,
    "esbuild@0.25.12": true,
    "prisma@7.9.0": true,
    "@prisma/engines@7.9.0": true
  },
  "devDependencies": {
    "playwright-core": "^1.62.1",
    "tsx": "^4.19.2"
  }
}
