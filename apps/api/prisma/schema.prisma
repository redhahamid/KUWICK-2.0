// Core / Shared Foundation only — see docs/DATABASE_ARCHITECTURE.md §2.
// Clinical, Appointment, HR, Inventory, Panel Claims, and Reports models
// arrive with their respective Phase 1 sub-phase, not here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER_ADMIN
  DOCTOR_RESIDENT
  DOCTOR_LOCUM
  FRONT_DESK_CLINICAL_STAFF
  FINANCE_STAFF
  HR_STAFF
  STOCK_STAFF
  PANEL_STAFF
  PATIENT_PORTAL
}

/**
 * TASK 1 — the CAPABILITY roles.
 * Deliberately separate from `Role` above, which is the legacy administrative
 * job title and stays exactly as it is. A staff member holds one or MORE of
 * these and their effective permissions are the union — which is the whole
 * point: the doctor who owns the clinic holds DOCTOR and OWNER, and neither
 * role has to be widened to accommodate the other.
 */
enum SystemRole {
  /**
   * Write and sign notes, diagnose, prescribe, order, hold, complete.
   */
  DOCTOR
  /**
   * Vitals, allergies, task-order results, dispensing, staff remarks.
   */
  CLINICAL_STAFF
  /**
   * Demographics, LHDN, queue, billing, documents. No clinical writes.
   */
  ADMINISTRATOR
  /**
   * Settings, discount approval. Alone, this carries NO clinical ability.
   */
  OWNER

  @@map("system_role")
}

/**
 * One capability role held by one staff member.
 * Attributed on purpose: who granted a clinical capability, and when, is a
 * question an audit will ask. Removal is a delete — the grant's history lives
 * in the audit log, not in a tombstone here.
 */
model StaffRoleAssignment {
  id       String      @id @default(uuid())
  tenantId String      @map("tenant_id")
  staffId  String      @map("staff_id")
  /// Nullable since final-UAT: a row carries EITHER a built-in capability
  /// role OR a tenant-defined custom role (CHECK-guarded in the migration).
  role     SystemRole?

  /// Final-UAT — the tenant-defined role this assignment hands out, when
  /// `role` is null.
  customRoleId String? @map("custom_role_id")

  assignedByStaffId String   @map("assigned_by_staff_id")
  assignedAt        DateTime @default(now()) @map("assigned_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  staff      Staff             @relation("StaffRoleHolder", fields: [staffId], references: [id], onDelete: Cascade)
  assignedBy Staff             @relation("StaffRoleGrantedBy", fields: [assignedByStaffId], references: [id])
  customRole ClinicCustomRole? @relation(fields: [customRoleId], references: [id], onDelete: Cascade)

  @@unique([staffId, role])
  @@unique([staffId, customRoleId])
  @@index([tenantId, role])
  @@map("staff_role_assignments")
}

/**
 * FINAL-UAT — a tenant-defined role: a REUSABLE permission bundle the owner
 * names ("Branch Manager", "Inventory") and hands to staff through
 * StaffRoleAssignment. Its permissions are validated against
 * CUSTOM_ROLE_GRANTABLE (core/permissions.ts) on every write AND filtered
 * through it on every read — nothing clinical, nothing owner-tier, so a
 * custom role can never mint a doctor or an owner.
 */
model ClinicCustomRole {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  /// Permission strings from CUSTOM_ROLE_GRANTABLE.
  permissions String[]

  createdByStaffId String   @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  createdBy   Staff                 @relation("CustomRoleCreatedBy", fields: [createdByStaffId], references: [id])
  assignments StaffRoleAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("clinic_custom_roles")
}

/**
 * TASK 1 — a permission granted to ONE person, outside any role.
 * Owner decision: "financial corrections" is a power, not a job. Applying a
 * discount belongs to OWNER by default, but a trusted senior counter staffer
 * should be able to hold it without inventing a fifth role for one capability.
 * The same applies to dispensing for a stock account.
 * Deliberately ADDITIVE ONLY. There is no per-person REVOKE, and there will
 * not be one: a grant that could subtract from a role would make "what can
 * this person do" answerable only by replaying two tables in the right order.
 * To take a capability away, remove the role.
 */
model StaffPermissionGrant {
  id         String @id @default(uuid())
  tenantId   String @map("tenant_id")
  staffId    String @map("staff_id")
  /**
   * A `Permission` string from core/permissions.ts.
   */
  permission String

  grantedByStaffId String   @map("granted_by_staff_id")
  grantedAt        DateTime @default(now()) @map("granted_at")
  /**
   * Why this person specifically. Read in the audit, never optional.
   */
  reason           String

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  staff     Staff  @relation("StaffPermissionHolder", fields: [staffId], references: [id], onDelete: Cascade)
  grantedBy Staff  @relation("StaffPermissionGrantedBy", fields: [grantedByStaffId], references: [id])

  @@unique([staffId, permission])
  @@index([tenantId, permission])
  @@map("staff_permission_grants")
}

enum PatientIdentifierType {
  NRIC
  PASSPORT
}

// C0 (clinical record integrity) — professional/clinical identity is
// deliberately SEPARATE from the administrative Role above. An OWNER_ADMIN
// may or may not be a practising doctor; signing eligibility is never
// derived from Role (owner: "Administrative role and professional clinical
// identity must be separate").
enum ProfessionalType {
  NON_CLINICAL
  MEDICAL_DOCTOR
}

// A doctor's narrative vs. a non-doctor's administrative/observational
// remark ("patient refused medication", "called 3x, no answer"). Both live
// on ClinicalNote so remarks inherit the same append-only audit trail, but
// a STAFF_REMARK can never be signed (DB CHECK) and never renders as a
// doctor's clinical note.
enum ClinicalNoteType {
  DOCTOR_NARRATIVE
  STAFF_REMARK
}

enum ClinicalNoteStatus {
  DRAFT
  SIGNED
}

// LATE_ENTRY is deliberately NOT an entry type — a late entry is orthogonal
// to being an amendment (a note may be a late standard entry OR a late
// amendment). Lateness is carried by clinicalEntryAt + lateEntryReason.
enum ClinicalNoteEntryType {
  STANDARD
  AMENDMENT
}

enum ClinicalNoteChangeType {
  CREATED
  UPDATED
  SIGNED
}

enum ObservationSource {
  MANUAL
  DEVICE
  IMPORTED
}

enum ObservationChangeType {
  CREATED
  CORRECTED
}

// C0 closure — which professional/signing field changed. Named per field so
// an auditor can filter "who ever enabled signing" without parsing values.
enum ProfessionalAuditField {
  PROFESSIONAL_TYPE
  MEDICAL_REGISTRATION_NO
  PROFESSIONAL_ACTIVE
  PROFESSIONAL_VERIFIED_AT
  PROFESSIONAL_VERIFIED_BY
  CAN_SIGN_CLINICAL_NOTES
  CLINICAL_SIGNING_ENABLED_AT
  CLINICAL_SIGNING_ENABLED_BY
}

