# G4.5-STAGING — API service variables. TEMPLATE ONLY: no real values here.
# Set the real values in the Railway service's Variables tab, never in Git.

# Supplied by the Railway Postgres plugin. Use the reference, not a literal.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Railway injects PORT. Do not hard-code it.
# PORT=

# Generate each independently, 32+ random bytes, and NEVER reuse a dev value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# The ONE browser origin allowed to call this API. No trailing slash.
# Leaving this empty allows every origin — acceptable locally, not on a public URL.
CORS_ORIGINS=https://<your-web-service>.up.railway.app

# Clinical attachments are written to local disk. This MUST point inside a
# mounted Railway volume or every upload is lost on redeploy/restart.
UPLOADS_DIR=/data/uploads

NODE_ENV=production

# Deliberately ABSENT: KUWICK_ALLOW_FIXTURES and KUWICK_STAGING_SEED.
# Seeding is run manually, once, via `railway run`. Neither belongs in the
# service environment, and neither is reachable over HTTP.
